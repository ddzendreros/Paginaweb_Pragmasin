# URL de la web (en producción es https://pragmasyn.com)
SITE_URL=https://pragmasyn.com

# Endpoint que recibe las solicitudes POST JSON del formulario de contacto (/contacto)
# Ejemplo Formspree: PUBLIC_FORM_ENDPOINT=https://formspree.io/f/tu-id-formspree
# Ejemplo Web3Forms: PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=

# (Opcional) Clave de acceso si usas Web3Forms
PUBLIC_WEB3FORMS_KEY=

