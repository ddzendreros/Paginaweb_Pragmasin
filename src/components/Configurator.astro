    kpis: [
      { label: "Mesas activas", base: 8, counts: "*" },
      { label: "En cocina", base: 5, counts: "En cocina" },
      { label: "Insumos bajos", base: 2, counts: "" },
    ],
    items: [
      { title: "Mesa 4", detail: "3 platillos", extra: "Salón", status: "En cocina" },
      { title: "Mesa 7", detail: "2 platillos", extra: "Salón", status: "Servida" },
      { title: "Para llevar 31", detail: "1 platillo", extra: "Mostrador", status: "Lista" },
      { title: "Mesa 2", detail: "4 platillos", extra: "Terraza", status: "En cocina" },
      { title: "Mesa 9", detail: "2 platillos", extra: "Terraza", status: "Servida" },
      { title: "Mesa 12", detail: "5 platillos", extra: "Salón", status: "En cocina" },
    ],
    draft: {
      titles: ["Mesa 15", "Mesa 16", "Mesa 17"],
      detail: "1 platillo",
      extra: "Salón",
      status: "En cocina",
      place: "end",
    },
  },
];

const toneOf = (business: Business, status: string): Tone =>
  business.statuses.find((s) => s.name === status)?.tone ?? "wait";

const kpiValue = (business: Business, kpi: Kpi): number => {
  const counted = kpi.counts.split("|");
  const visible = business.items.filter(
    (item) => kpi.counts === "*" || counted.includes(item.status),
  );
  return kpi.base + visible.length;
};
---

<div class="cfg" data-cfg>
  <fieldset class="cfg__top">
    <legend class="cfg__legend">Elige un negocio y mira cómo cambia.</legend>
    <div class="cfg__picker">
      <span class="cfg__pill" aria-hidden="true"></span>
      {
        businesses.map((b, i) => (
          <label class="cfg__option">
            <input type="radio" name="cfg" value={b.id} checked={i === 0} />
            <span>{b.name}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="cfg__frame ground-light">
    {
      businesses.map((b) => (
        <article
          class="app"
          data-panel={b.id}
          data-draft={JSON.stringify(b.draft)}
          aria-label={`Ejemplo de interfaz para ${b.name.toLowerCase()}`}
        >
          <div class="app__side">
            <strong class="app__name">{b.app}</strong>
            <ul class="app__menu">
              {b.menu.map((m, i) => (
                <li>
                  <button
                    type="button"
                    class="app__tab"
                    data-tab
                    aria-current={i === 0 ? "true" : undefined}
                  >
                    {m}
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <div class="app__main">
            <div class="app__head">
              <p class="app__title">{b.title}</p>
              <button type="button" class="app__action" data-new>
                {b.action}
              </button>
            </div>

            <dl class="app__kpis">
              {b.kpis.map((k) => (
                <div class="app__kpi" data-kpi={k.counts} data-base={k.base}>
                  <dt>{k.label}</dt>
                  <dd>{kpiValue(b, k)}</dd>
                </div>
              ))}
            </dl>

            <div class="app__view">
              {b.layout === "board" && (
                <div class="board">
                  {b.statuses.map((s) => {
                    const cards = b.items.filter((item) => item.status === s.name);
                    return (
                      <div class="board__col" data-col={s.name}>
                        <p class="board__head">
                          <span class="st" data-tone={s.tone}>
                            {s.name}
                          </span>
                          <span data-col-count>{cards.length}</span>
                        </p>
                        <div class="board__list" data-list>
                          {cards.map((item) => (
                            <button
                              type="button"
                              class="card"
                              data-item
                              data-status={item.status}
                            >
                              <b data-f="title">{item.title}</b>
                              <span data-f="detail">{item.detail}</span>
                              <span class="app__muted" data-f="extra">
                                {item.extra}
                              </span>
                            </button>
                          ))}
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}

              {b.layout === "agenda" && (
                <ol class="agenda" data-list>
                  {b.items.map((item) => (
                    <li data-item data-status={item.status}>
                      <button type="button" class="slot">
                        <b class="slot__time" data-f="title">
                          {item.title}
                        </b>
                        <span class="slot__body">
                          <span data-f="detail">{item.detail}</span>
                          <span class="app__muted" data-f="extra">
                            {item.extra}
                          </span>
                        </span>
                        <span class="st" data-tone={toneOf(b, item.status)} data-status-label>
                          {item.status}
                        </span>
                      </button>
                    </li>
                  ))}
                </ol>
              )}

              {b.layout === "table" && (
                <table class="rows">
                  <thead>
                    <tr>
                      <th scope="col">Pedido</th>
                      <th scope="col">Ruta</th>
                      <th scope="col">Carga</th>
                      <th scope="col">Estado</th>
                    </tr>
                  </thead>
                  <tbody data-list>
                    {b.items.map((item) => (
                      <tr data-item data-status={item.status}>
                        <td>
                          <button type="button" class="rows__open" data-f="title">
                            {item.title}
                          </button>
                        </td>
                        <td data-f="detail">{item.detail}</td>
                        <td data-f="extra">{item.extra}</td>
                        <td>
                          <span class="st" data-tone={toneOf(b, item.status)} data-status-label>
                            {item.status}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}

              {b.layout === "floor" && (
                <ul class="floor" data-list>
                  {b.items.map((item) => (
                    <li data-item data-status={item.status}>
                      <button type="button" class="tile">
                        <b data-f="title">{item.title}</b>
                        <span data-f="detail">{item.detail}</span>
                        <span class="app__muted" data-f="extra">
                          {item.extra}
                        </span>
                        <span class="st" data-tone={toneOf(b, item.status)} data-status-label>
                          {item.status}
                        </span>
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="app__empty">
              <p class="app__title" data-empty-title></p>
              <p>El tuyo se diseña con tus variables.</p>
              <a class="link" href="/contacto">Cuéntanos tu idea</a>
            </div>
          </div>

          <div class="app__detail" aria-live="polite">
            <p class="app__detail-title" data-d="title"></p>
            <p data-d="detail"></p>
            <p class="app__muted" data-d="extra"></p>
            <p class="app__detail-label">Estado</p>
            <div class="app__statuses" role="group" aria-label="Estado">
              {b.statuses.map((s) => (
                <button
                  type="button"
                  class="app__status"
                  data-set-status={s.name}
                  aria-pressed="false"
                >
                  <span class="st" data-tone={s.tone}>
                    {s.name}
                  </span>
                </button>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="cfg__foot">
    <p class="caption">Ejemplo ilustrativo</p>
    <p class="caption">El tuyo se diseña con tus variables.</p>
  </div>
</div>

<script>
  // Sin JS el selector cambia de negocio con :has(). Esto le da vida a la app:
  // seleccionar, cambiar estados, crear registros y recalcular indicadores.
  interface Draft {
    titles: string[];
    detail: string;
    extra: string;
    status: string;
    place: "start" | "end";
  }

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const SETTLE = "cubic-bezier(0.22, 1.1, 0.36, 1)";

  const controlOf = (item: HTMLElement): HTMLElement =>
    item.matches("button") ? item : (item.querySelector<HTMLElement>("button") ?? item);

  /** Lets each element travel from where it was to where the change left it. */
  function travel(elements: () => HTMLElement[], change: () => void): void {
    if (reduced.matches) {
      change();
      return;
    }
    const before = new Map(elements().map((el) => [el, el.getBoundingClientRect()]));
    change();
    for (const el of elements()) {
      const from = before.get(el);
      if (!from) continue;
      const to = el.getBoundingClientRect();
      const dx = from.left - to.left;
      const dy = from.top - to.top;
      if (dx === 0 && dy === 0) continue;
      el.animate([{ translate: `${dx}px ${dy}px` }, { translate: "0 0" }], {
        duration: 460,
        easing: SETTLE,
      });
    }
  }

  /** A changed figure rolls in; the old one has already left. */
  function popNumber(output: Element): void {
    if (reduced.matches) return;
    output.animate(
      [
        { opacity: 0, translate: "0 0.45em", filter: "blur(4px)" },
        { opacity: 1, translate: "0 0", filter: "blur(0)" },
      ],
      { duration: 380, easing: SETTLE },
    );
  }

  /** The app assembles itself when it changes business. */
  function assemble(panel: HTMLElement): void {
    if (reduced.matches) return;
    panel.animate({ opacity: [0, 1] }, { duration: 240, easing: "ease-out" });
    const parts = panel.querySelectorAll<HTMLElement>(
      ".app__tab, .app__head, .app__kpi, [data-item], .board__head, .app__detail > *",
    );
    parts.forEach((part, i) => {
      part.animate(
        [
          { opacity: 0, translate: "0 0.625rem" },
          { opacity: 1, translate: "0 0" },
        ],
        { duration: 420, delay: Math.min(i, 18) * 16, easing: SETTLE, fill: "backwards" },
      );
    });
  }

  function setupPanel(panel: HTMLElement): void {
    const draft = JSON.parse(panel.dataset["draft"] ?? "{}") as Draft;
    const statusButtons = Array.from(
      panel.querySelectorAll<HTMLButtonElement>("[data-set-status]"),
    );
    const toneByStatus = new Map(
      statusButtons.map((button) => [
        button.dataset["setStatus"] ?? "",
        button.querySelector<HTMLElement>(".st")?.dataset["tone"] ?? "",
      ]),
    );
    const tabs = Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const view = panel.querySelector<HTMLElement>(".app__view");
    const items = (): HTMLElement[] =>
      Array.from(panel.querySelectorAll<HTMLElement>("[data-item]"));
    let selected: HTMLElement | null = null;

    const field = (item: HTMLElement, key: string): string =>
      item.querySelector(`[data-f="${key}"]`)?.textContent?.trim() ??
      (item.matches(`[data-f="${key}"]`) ? (item.textContent ?? "") : "");

    const showDetail = (key: string, value: string): void => {
      const target = panel.querySelector(`[data-d="${key}"]`);
      if (target) target.textContent = value;
    };

    const syncStatusButtons = (): void => {
      for (const button of statusButtons) {
        const current = button.dataset["setStatus"] === selected?.dataset["status"];
        button.setAttribute("aria-pressed", String(current));
      }
    };

    const refresh = (): void => {
      const all = items();
      for (const kpi of panel.querySelectorAll<HTMLElement>("[data-kpi]")) {
        const counts = (kpi.dataset["kpi"] ?? "").split("|");
        const visible = all.filter(
          (item) => counts.includes("*") || counts.includes(item.dataset["status"] ?? ""),
        );
        const value = String(Number(kpi.dataset["base"]) + visible.length);
        const output = kpi.querySelector("dd");
        if (!output || output.textContent === value) continue;
        output.textContent = value;
        popNumber(output);
      }
      for (const column of panel.querySelectorAll<HTMLElement>("[data-col]")) {
        const count = column.querySelector("[data-col-count]");
        if (!count) continue;
        const value = String(column.querySelectorAll("[data-item]").length);
        if (count.textContent === value) continue;
        count.textContent = value;
        popNumber(count);
      }
    };

    const select = (item: HTMLElement): void => {
      if (selected) {
        selected.classList.remove("is-selected");
        controlOf(selected).removeAttribute("aria-current");
      }
      selected = item;
      item.classList.add("is-selected");
      controlOf(item).setAttribute("aria-current", "true");
      showDetail("title", field(item, "title"));
      showDetail("detail", field(item, "detail"));
      showDetail("extra", field(item, "extra"));
      syncStatusButtons();
      if (!reduced.matches) {
        panel.querySelector(".app__detail")?.animate(
          [
            { opacity: 0.4, translate: "0.375rem 0" },
            { opacity: 1, translate: "0 0" },
          ],
          { duration: 260, easing: SETTLE },
        );
      }
    };

    const setStatus = (item: HTMLElement, status: string): void => {
      item.dataset["status"] = status;
      const label = item.querySelector<HTMLElement>("[data-status-label]");
      if (label) {
        label.textContent = status;
        label.dataset["tone"] = toneByStatus.get(status) ?? "";
      }
      // On the board a change of status is a change of column, and the card
      // flies there; its neighbors close the gap behind it.
      travel(items, () => {
        panel.querySelector(`[data-col="${status}"] [data-list]`)?.prepend(item);
      });
      refresh();
      syncStatusButtons();
    };

    const create = (button: HTMLButtonElement): void => {
      const title = draft.titles.shift();
      const source = panel.querySelector<HTMLElement>("[data-item]");
      const list =
        panel.querySelector(`[data-col="${draft.status}"] [data-list]`) ??
        panel.querySelector("[data-list]");
      if (!title || !source || !list) return;

      const item = source.cloneNode(true) as HTMLElement;
      item.classList.remove("is-selected");
      controlOf(item).removeAttribute("aria-current");
      const fill = (key: string, value: string): void => {
        const target = item.querySelector(`[data-f="${key}"]`);
        if (target) target.textContent = value;
      };
      fill("title", title);
      fill("detail", draft.detail);
      fill("extra", draft.extra);
      travel(items, () => {
        if (draft.place === "start") list.prepend(item);
        else list.append(item);
      });

      setStatus(item, draft.status);
      select(item);
      if (!reduced.matches) {
        item.animate(
          [
            { opacity: 0, scale: 0.94, filter: "blur(3px)" },
            { opacity: 1, scale: 1, filter: "blur(0)" },
          ],
          { duration: 420, easing: SETTLE },
        );
      }
      if (view) view.scrollTop = draft.place === "start" ? 0 : view.scrollHeight;
      if (draft.titles.length === 0) button.disabled = true;
    };

    const openTab = (tab: HTMLButtonElement): void => {
      for (const other of tabs) other.removeAttribute("aria-current");
      tab.setAttribute("aria-current", "true");
      panel.classList.toggle("is-empty", tab !== tabs[0]);
      const title = panel.querySelector("[data-empty-title]");
      if (title) title.textContent = tab.textContent?.trim() ?? "";
      if (!reduced.matches) {
        panel.querySelector(".app__main")?.animate(
          { opacity: [0, 1], translate: ["0 0.375rem", "0 0"] },
          { duration: 300, easing: SETTLE },
        );
      }
    };

    panel.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const tab = target.closest<HTMLButtonElement>("[data-tab]");
      if (tab) return openTab(tab);
      const statusButton = target.closest<HTMLButtonElement>("[data-set-status]");
      if (statusButton && selected) {
        return setStatus(selected, statusButton.dataset["setStatus"] ?? "");
      }
      const newButton = target.closest<HTMLButtonElement>("[data-new]");
      if (newButton) return create(newButton);
      const item = target.closest<HTMLElement>("[data-item]");
      if (item) select(item);
    });

    const first = items()[0];
    if (first) select(first);
  }

  const root = document.querySelector<HTMLElement>("[data-cfg]");
  if (root) {
    const picker = root.querySelector<HTMLElement>(".cfg__picker");

    const movePill = (): void => {
      const label = root
        .querySelector<HTMLInputElement>('input[name="cfg"]:checked')
        ?.closest("label");
      if (!label || !picker) return;
      picker.style.setProperty("--pill-x", `${label.offsetLeft}px`);
      picker.style.setProperty("--pill-w", `${label.offsetWidth}px`);
    };

    const apply = (value: string): void => {
      root.dataset["active"] = value;
      movePill();
    };

    root.querySelectorAll<HTMLElement>("[data-panel]").forEach(setupPanel);
    apply(root.querySelector<HTMLInputElement>('input[name="cfg"]:checked')?.value ?? "taller");
    // the first placement is not a movement
    requestAnimationFrame(() => requestAnimationFrame(() => root.setAttribute("data-ready", "")));

    root.addEventListener("change", (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      const { value } = event.target;
      apply(value);
      const panel = root.querySelector<HTMLElement>(`[data-panel="${value}"]`);
      if (panel) assemble(panel);
    });

    // Labels change width when the font loads or the window resizes.
    const observer = new ResizeObserver(movePill);
    root.querySelectorAll(".cfg__option").forEach((option) => observer.observe(option));
  }
</script>

