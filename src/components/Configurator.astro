---
/**
 * El sello del hero: una app de ejemplo que funciona de verdad. Cambias el
 * estado de un registro y los indicadores responden; creas uno y aparece. Cada
 * negocio trae su propia pantalla (tablero, agenda, tabla o plano), no el mismo
 * molde con otras palabras. Sin JS se lee completa y cambia de negocio con
 * :has(). Los datos son genéricos: ni personas ni empresas reales
 * (docs/PROPUESTAS-COPY.md, "Datos del configurador").
 */
type Tone = "wait" | "active" | "done";

interface Status {
  name: string;
  tone: Tone;
}
interface Item {
  title: string;
  detail: string;
  extra: string;
  status: string;
}
interface Kpi {
  label: string;
  /** Lo que no se ve en esta pantalla. Con lo visible suma la cifra del copy. */
  base: number;
  /** Estados que cuentan; "*" cuenta todos y "" no cuenta ninguno. */
  counts: string;
}
interface Draft {
  titles: string[];
  detail: string;
  extra: string;
  status: string;
  place: "start" | "end";
}
interface Business {
  id: string;
  name: string;
  app: string;
  menu: string[];
  title: string;
  action: string;
  layout: "board" | "agenda" | "table" | "floor";
  statuses: Status[];
  kpis: Kpi[];
  items: Item[];
  draft: Draft;
}

const businesses: Business[] = [
  {
    id: "taller",
    name: "Taller",
    app: "Mi taller",
    menu: ["Órdenes", "Refacciones", "Clientes", "Caja"],
    title: "Órdenes de hoy",
    action: "Nueva orden",
    layout: "board",
    statuses: [
      { name: "En proceso", tone: "active" },
      { name: "Espera pieza", tone: "wait" },
      { name: "Lista", tone: "done" },
    ],
    kpis: [
      { label: "Autos en piso", base: 6, counts: "*" },
      { label: "Por entregar", base: 4, counts: "Lista" },
      { label: "Por surtir", base: 1, counts: "Espera pieza" },
    ],
    items: [
      { title: "Orden 1042", detail: "Afinación", extra: "Sedán 2018", status: "En proceso" },
      { title: "Orden 1045", detail: "Cambio de aceite", extra: "Hatchback 2021", status: "En proceso" },
      { title: "Orden 1047", detail: "Alineación", extra: "Sedán 2022", status: "En proceso" },
      { title: "Orden 1043", detail: "Frenos", extra: "Pick-up 2020", status: "Espera pieza" },
      { title: "Orden 1046", detail: "Clutch", extra: "Camioneta 2017", status: "Espera pieza" },
      { title: "Orden 1044", detail: "Suspensión", extra: "SUV 2016", status: "Lista" },
    ],
    draft: {
      titles: ["Orden 1048", "Orden 1049", "Orden 1050"],
      detail: "Servicio general",
      extra: "Sedán 2019",
      status: "En proceso",
      place: "start",
    },
  },
  {
    id: "clinica",
    name: "Clínica",
    app: "Mi clínica",
    menu: ["Agenda", "Pacientes", "Expedientes", "Cobros"],
    title: "Agenda de hoy",
    action: "Nueva cita",
    layout: "agenda",
    statuses: [
      { name: "Por confirmar", tone: "wait" },
      { name: "Confirmada", tone: "active" },
      { name: "Atendida", tone: "done" },
    ],
    kpis: [
      { label: "Citas", base: 12, counts: "*" },
      { label: "Confirmadas", base: 10, counts: "Confirmada" },
      { label: "Por cobrar", base: 3, counts: "Atendida" },
    ],
    items: [
      { title: "09:00", detail: "Consulta general", extra: "Consultorio 1", status: "Confirmada" },
      { title: "09:30", detail: "Seguimiento", extra: "Consultorio 2", status: "Confirmada" },
      { title: "10:00", detail: "Primera vez", extra: "Consultorio 1", status: "Por confirmar" },
      { title: "10:30", detail: "Consulta general", extra: "Consultorio 2", status: "Confirmada" },
      { title: "11:00", detail: "Seguimiento", extra: "Consultorio 1", status: "Por confirmar" },
      { title: "11:30", detail: "Primera vez", extra: "Consultorio 2", status: "Confirmada" },
    ],
    draft: {
      titles: ["12:00", "12:30", "13:00"],
      detail: "Consulta general",
      extra: "Consultorio 1",
      status: "Por confirmar",
      place: "end",
    },
