---
/**
 * El sello del hero: el visitante elige un negocio y la interfaz de ejemplo se
 * reacomoda. Sin JS cambia con :has(); con JS lo hace una view transition y
 * un indicador que se desliza. Los datos son genéricos: ni personas ni
 * empresas reales (docs/PROPUESTAS-COPY.md, "Datos del configurador").
 */
interface Business {
  id: string;
  name: string;
  app: string;
  menu: string[];
  title: string;
  action: string;
  kpis: [string, string][];
  rows: [string, string, string][];
}

const businesses: Business[] = [
  {
    id: "taller",
    name: "Taller",
    app: "Mi taller",
    menu: ["Órdenes", "Refacciones", "Clientes", "Caja"],
    title: "Órdenes de hoy",
    action: "Nueva orden",
    kpis: [
      ["Autos en piso", "12"],
      ["Por entregar", "5"],
      ["Por surtir", "3"],
    ],
    rows: [
      ["Orden 1042", "Afinación", "En proceso"],
      ["Orden 1043", "Frenos", "Espera pieza"],
      ["Orden 1044", "Suspensión", "Lista"],
    ],
  },
  {
    id: "clinica",
    name: "Clínica",
    app: "Mi clínica",
    menu: ["Agenda", "Pacientes", "Expedientes", "Cobros"],
    title: "Agenda de hoy",
    action: "Nueva cita",
    kpis: [
      ["Citas", "18"],
      ["Confirmadas", "14"],
      ["Por cobrar", "3"],
    ],
    rows: [
      ["09:00", "Consulta general", "Confirmada"],
      ["09:30", "Seguimiento", "Confirmada"],
      ["10:00", "Primera vez", "Por confirmar"],
    ],
  },
  {
    id: "distribuidora",
    name: "Distribuidora",
    app: "Mi distribuidora",
    menu: ["Pedidos", "Inventario", "Rutas", "Cobranza"],
    title: "Pedidos de hoy",
    action: "Nuevo pedido",
    kpis: [
      ["Pedidos", "46"],
      ["En ruta", "9"],
      ["Bajo mínimo", "7"],
    ],
    rows: [
      ["Pedido 5210", "Ruta Norte", "Cargando"],
      ["Pedido 5211", "Ruta Centro", "En ruta"],
      ["Pedido 5212", "Ruta Sur", "Entregado"],
    ],
  },
  {
    id: "restaurante",
    name: "Restaurante",
    app: "Mi restaurante",
    menu: ["Comandas", "Menú", "Insumos", "Corte"],
    title: "Comandas abiertas",
    action: "Nueva comanda",
    kpis: [
      ["Mesas activas", "14"],
      ["En cocina", "8"],
      ["Insumos bajos", "2"],
    ],
    rows: [
      ["Mesa 4", "3 platillos", "En cocina"],
      ["Mesa 7", "2 platillos", "Servida"],
      ["Para llevar 31", "1 platillo", "Lista"],
    ],
  },
];
---

<div class="cfg" data-cfg>
  <fieldset class="cfg__top">
    <legend class="cfg__legend">Elige un negocio y mira cómo cambia.</legend>
    <div class="cfg__picker">
      <span class="cfg__pill" aria-hidden="true"></span>
      {
        businesses.map((b, i) => (
          <label class="cfg__option">
            <input type="radio" name="cfg" value={b.id} checked={i === 0} />
            <span>{b.name}</span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <div class="cfg__frame">
    <div class="cfg__bar" aria-hidden="true">
      <span class="cfg__dots"><i></i><i></i><i></i></span>
      <span class="caption">Ejemplo ilustrativo</span>
    </div>
    <div class="cfg__stage">
      {
        businesses.map((b) => (
          <article
            class="mock"
            data-panel={b.id}
            aria-label={`Ejemplo de interfaz para ${b.name.toLowerCase()}`}
          >
            <div class="mock__nav">
              <strong class="mock__app">{b.app}</strong>
              <ul class="mock__menu">
                {b.menu.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </div>
            <div class="mock__head">
              <p class="mock__title">{b.title}</p>
              <span class="mock__action">{b.action}</span>
            </div>
            <dl class="mock__kpis">
              {b.kpis.map(([label, value]) => (
                <div class="mock__kpi">
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
            <ul class="mock__rows">
              {b.rows.map(([first, second, status]) => (
                <li class="mock__row">
                  <b>{first}</b>
                  <span>{second}</span>
                  <em>{status}</em>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
  <p class="caption cfg__note">El tuyo se diseña con tus variables.</p>
</div>

<script>
  // Sin JS funciona con :has(); esto solo agrega la transición y el
  // indicador que se desliza entre opciones.
  const root = document.querySelector<HTMLElement>("[data-cfg]");

  if (root) {
    const picker = root.querySelector<HTMLElement>(".cfg__picker");
    const pill = root.querySelector<HTMLElement>(".cfg__pill");
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="cfg"]'));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const movePill = (): void => {
      const label = root
        .querySelector<HTMLInputElement>('input[name="cfg"]:checked')
        ?.closest("label");
      if (!label || !pill || !picker) return;
      picker.style.setProperty("--pill-x", `${label.offsetLeft}px`);
      picker.style.setProperty("--pill-w", `${label.offsetWidth}px`);
      picker.scrollTo({ left: label.offsetLeft - picker.clientWidth / 2 + label.offsetWidth / 2 });
    };

    const apply = (value: string): void => {
      root.dataset["active"] = value;
      movePill();
    };

    apply(inputs.find((input) => input.checked)?.value ?? "taller");
    requestAnimationFrame(() => requestAnimationFrame(() => root.setAttribute("data-ready", "")));

    root.addEventListener("change", (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;
      const { value } = event.target;
      if (!("startViewTransition" in document) || reduced.matches) {
        apply(value);
        return;
      }
      document.startViewTransition(() => apply(value));
    });

    // Las opciones cambian de ancho cuando carga la fuente o cambia el viewport.
    const observer = new ResizeObserver(movePill);
    root.querySelectorAll(".cfg__option").forEach((option) => observer.observe(option));
  }
</script>

<style is:global>
  /* Las únicas marcas fuera de tokens son las de cada negocio de ejemplo:
     representan el software del cliente, no a Pragmasyn. */
  .cfg {
    margin-block-start: clamp(var(--space-7), 5vw, var(--space-8));
  }
  .cfg__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-block-end: var(--space-4);
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .cfg__legend {
    float: left;
    font-size: var(--text-small);
    color: var(--fg-secondary);
    padding: 0;
  }
  .cfg__picker {
    position: relative;
    display: inline-flex;
    gap: var(--space-1);
    padding: var(--space-1);
    background: var(--bg-sunken);
    border-radius: var(--radius-pill);
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cfg__option {
    position: relative;
    flex: none;
    cursor: pointer;
  }
  .cfg__option input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .cfg__option span {
    position: relative;
    z-index: 1;
    display: block;
    padding: var(--space-2) var(--space-4);
    min-height: 44px;
    line-height: 1.5;
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--fg-secondary);
    transition: color var(--dur-2) var(--ease-out);
  }
  .cfg__option:hover input:not(:checked) + span {
    color: var(--fg);
  }
  .cfg__option input:checked + span {
    color: var(--action-fg);
  }
  .cfg__option input:focus-visible + span {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  /* Sin JS el resaltado va en la opción; con JS lo lleva el indicador que se desliza */
  .cfg:not([data-active]) .cfg__option input:checked + span {
    background: var(--ink-900);
  }
  .cfg__pill {
    position: absolute;
    inset-block: var(--space-1);
    inset-inline-start: 0;
    width: var(--pill-w, 0);
    translate: var(--pill-x, 0) 0;
    background: var(--ink-900);
    border-radius: var(--radius-pill);
  }
  /* Solo después de la primera colocación: al cargar el indicador no se anima */
  .cfg[data-ready] .cfg__pill {
    transition: translate var(--dur-3) var(--ease-back), width var(--dur-3) var(--ease-back);
  }
  .cfg:not([data-active]) .cfg__pill {
    display: none;
  }

  .cfg__frame {
    background: var(--bg-raised);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-float);
    overflow: hidden;
  }
  .cfg__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-5);
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .cfg__dots {
    display: flex;
    gap: var(--space-2);
  }
  .cfg__dots i {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: 50%;
    background: var(--paper-200);
  }
  .cfg__stage {
    height: clamp(24rem, 33vw, 27rem);
  }
  .cfg__note {
    margin-block-start: var(--space-3);
    text-align: end;
  }

  /* El panel activo: funciona sin JS con :has() y con JS con data-active */
  .mock {
    display: none;
    height: 100%;
  }
  .cfg:not([data-active]):has(input[value="taller"]:checked) [data-panel="taller"],
  .cfg:not([data-active]):has(input[value="clinica"]:checked) [data-panel="clinica"],
  .cfg:not([data-active]):has(input[value="distribuidora"]:checked) [data-panel="distribuidora"],
  .cfg:not([data-active]):has(input[value="restaurante"]:checked) [data-panel="restaurante"],
  .cfg[data-active="taller"] [data-panel="taller"],
  .cfg[data-active="clinica"] [data-panel="clinica"],
  .cfg[data-active="distribuidora"] [data-panel="distribuidora"],
  .cfg[data-active="restaurante"] [data-panel="restaurante"] {
    display: grid;
  }

  /* Marcas de ejemplo: cada negocio trae su propio color */
  [data-panel="taller"] {
    --brand: #a04610;
    --brand-tint: #fbeadf;
  }
  [data-panel="clinica"] {
    --brand: #0f766e;
    --brand-tint: #ddf3f0;
  }
  [data-panel="distribuidora"] {
    --brand: #2123ea;
    --brand-tint: #e9e9fd;
  }
  [data-panel="restaurante"] {
    --brand: #9f1d4f;
    --brand-tint: #fbe4ec;
  }

  .mock__nav,
  .mock__head,
  .mock__kpis,
  .mock__rows {
    min-width: 0;
  }
  .mock__nav {
    view-transition-name: cfg-nav;
  }
  .mock__head {
    view-transition-name: cfg-head;
  }
  .mock__kpis {
    view-transition-name: cfg-kpis;
  }
  .mock__rows {
    view-transition-name: cfg-rows;
  }

  .mock__app {
    display: block;
    font-weight: var(--weight-strong);
    font-size: var(--text-small);
    color: var(--brand);
  }
  .mock__menu {
    display: flex;
    gap: var(--space-1);
    font-size: var(--text-small);
  }
  .mock__menu li {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-s);
    color: var(--fg-secondary);
    white-space: nowrap;
  }
  .mock__menu li:first-child {
    background: var(--brand-tint);
    color: var(--brand);
    font-weight: var(--weight-medium);
  }

  .mock__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .mock__title {
    font-size: var(--text-h3);
    font-family: var(--font-display);
    line-height: 1.1;
  }
  .mock__action {
    flex: none;
    background: var(--brand);
    color: var(--paper-0);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-s);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
  }
  .mock__kpis {
    display: grid;
    gap: var(--space-3);
  }
  .mock__kpi {
    padding: var(--space-3) var(--space-4);
    background: var(--bg);
    border-radius: var(--radius-m);
  }
  .mock__kpi dt {
    font-size: var(--text-caption);
    color: var(--fg-secondary);
  }
  .mock__kpi dd {
    font-family: var(--font-display);
    font-size: 1.875rem;
    line-height: 1.1;
  }

  .mock__rows {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-small);
    align-content: start;
  }
  .mock__row {
    display: grid;
    gap: var(--space-3);
    align-items: center;
    background: var(--bg);
    border-radius: var(--radius-m);
    padding: var(--space-3) var(--space-4);
  }
  .mock__row b {
    font-weight: var(--weight-medium);
  }
  .mock__row span {
    color: var(--fg-secondary);
  }
  .mock__row em {
    font-style: normal;
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    color: var(--brand);
    background: var(--brand-tint);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
    justify-self: start;
  }

  /* Taller: menú lateral, indicadores arriba, tablero de tres columnas */
  [data-panel="taller"] {
    grid-template-columns: 11rem 1fr;
    grid-template-rows: auto auto 1fr;
    grid-template-areas: "nav head" "nav kpis" "nav rows";
    gap: var(--space-4) var(--space-5);
    padding: var(--space-5);
  }
  [data-panel="taller"] .mock__nav {
    grid-area: nav;
    border-inline-end: var(--hairline) solid var(--hairline-color);
    padding-inline-end: var(--space-4);
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  [data-panel="taller"] .mock__menu {
    flex-direction: column;
  }
  [data-panel="taller"] .mock__head {
    grid-area: head;
  }
  [data-panel="taller"] .mock__kpis {
    grid-area: kpis;
    grid-template-columns: repeat(3, 1fr);
  }
  [data-panel="taller"] .mock__rows {
    grid-area: rows;
    grid-template-columns: repeat(3, 1fr);
    align-content: stretch;
  }
  [data-panel="taller"] .mock__row {
    align-content: start;
    gap: var(--space-1);
  }

  /* Clínica: menú superior, agenda ancha, indicadores en columna */
  [data-panel="clinica"] {
    grid-template-columns: 1fr 13rem;
    grid-template-rows: auto auto 1fr;
    grid-template-areas: "nav nav" "head head" "rows kpis";
    gap: var(--space-4) var(--space-5);
    padding: var(--space-5);
  }
  [data-panel="clinica"] .mock__nav {
    grid-area: nav;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  [data-panel="clinica"] .mock__head {
    grid-area: head;
  }
  [data-panel="clinica"] .mock__kpis {
    grid-area: kpis;
    align-content: start;
  }
  [data-panel="clinica"] .mock__rows {
    grid-area: rows;
    grid-auto-rows: 1fr;
    align-content: stretch;
  }
  [data-panel="clinica"] .mock__row {
    grid-template-columns: 4.5rem 1fr auto;
    background: transparent;
    border-inline-start: var(--hairline-strong) solid var(--brand);
    border-radius: 0;
    padding-block: var(--space-4);
  }

  /* Distribuidora: menú lateral angosto, tabla a todo lo ancho */
  [data-panel="distribuidora"] {
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas: "nav head" "nav rows" "nav kpis";
    gap: var(--space-4) var(--space-5);
    padding: 0 var(--space-5) var(--space-5) 0;
  }
  [data-panel="distribuidora"] .mock__nav {
    grid-area: nav;
    background: var(--brand);
    color: var(--paper-0);
    padding: var(--space-5) var(--space-4);
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  [data-panel="distribuidora"] .mock__app {
    color: var(--paper-0);
  }
  [data-panel="distribuidora"] .mock__menu {
    flex-direction: column;
  }
  [data-panel="distribuidora"] .mock__menu li {
    color: var(--paper-0);
    opacity: 0.85;
  }
  [data-panel="distribuidora"] .mock__menu li:first-child {
    background: rgb(255 255 255 / 0.16);
    color: var(--paper-0);
    opacity: 1;
  }
  [data-panel="distribuidora"] .mock__head {
    grid-area: head;
    padding-block-start: var(--space-5);
  }
  [data-panel="distribuidora"] .mock__rows {
    grid-area: rows;
    gap: 0;
    grid-auto-rows: 1fr;
    align-content: stretch;
  }
  [data-panel="distribuidora"] .mock__row {
    grid-template-columns: 1fr 1fr auto;
    background: transparent;
    border-radius: 0;
    border-block-end: var(--hairline) solid var(--hairline-color);
    padding-inline: 0;
  }
  [data-panel="distribuidora"] .mock__kpis {
    grid-area: kpis;
    grid-template-columns: repeat(3, 1fr);
  }

  /* Restaurante: indicadores arriba, mesas en mosaico, menú abajo */
  [data-panel="restaurante"] {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas: "head" "kpis" "rows" "nav";
    gap: var(--space-4);
    padding: var(--space-5);
  }
  [data-panel="restaurante"] .mock__nav {
    grid-area: nav;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-block-start: var(--hairline) solid var(--hairline-color);
    padding-block-start: var(--space-3);
  }
  [data-panel="restaurante"] .mock__head {
    grid-area: head;
  }
  [data-panel="restaurante"] .mock__kpis {
    grid-area: kpis;
    grid-template-columns: repeat(3, 1fr);
  }
  [data-panel="restaurante"] .mock__rows {
    grid-area: rows;
    grid-template-columns: repeat(3, 1fr);
    align-content: stretch;
  }
  [data-panel="restaurante"] .mock__row {
    background: var(--brand-tint);
    gap: var(--space-1);
    grid-template-rows: auto auto 1fr;
  }
  [data-panel="restaurante"] .mock__row em {
    align-self: end;
    background: var(--paper-0);
  }

  ::view-transition-old(root) {
    display: none;
  }
  ::view-transition-new(root) {
    animation: none;
  }
  ::view-transition-group(cfg-nav),
  ::view-transition-group(cfg-head),
  ::view-transition-group(cfg-kpis),
  ::view-transition-group(cfg-rows) {
    animation-duration: var(--dur-4);
    animation-timing-function: var(--ease-out);
  }
  ::view-transition-old(cfg-nav),
  ::view-transition-new(cfg-nav),
  ::view-transition-old(cfg-head),
  ::view-transition-new(cfg-head),
  ::view-transition-old(cfg-kpis),
  ::view-transition-new(cfg-kpis),
  ::view-transition-old(cfg-rows),
  ::view-transition-new(cfg-rows) {
    animation-duration: var(--dur-3);
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  @media (max-width: 56rem) {
    .cfg__stage {
      height: 27rem;
    }
    [data-panel="taller"],
    [data-panel="clinica"],
    [data-panel="distribuidora"],
    [data-panel="restaurante"] {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr;
      grid-template-areas: "nav" "head" "rows";
      gap: var(--space-3);
      padding: var(--space-4);
    }
    .mock__kpis {
      display: none;
    }
    .mock__menu {
      overflow: hidden;
    }
    [data-panel] .mock__nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      background: transparent;
      padding: 0;
      border: 0;
      color: inherit;
    }
    [data-panel] .mock__app {
      color: var(--brand);
    }
    [data-panel] .mock__menu {
      flex-direction: row;
      display: none;
    }
    [data-panel] .mock__rows {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    [data-panel] .mock__row {
      grid-template-columns: 1fr auto;
      min-height: 0;
      background: var(--bg);
      border: 0;
      border-radius: var(--radius-m);
      padding: var(--space-3);
    }
    [data-panel] .mock__row span {
      grid-column: 1;
      grid-row: 2;
    }
    [data-panel] .mock__row em {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    [data-panel="distribuidora"] .mock__head {
      padding-block-start: 0;
    }
    .cfg__legend {
      float: none;
    }
    .cfg__picker {
      gap: 2px;
    }
    .cfg__option span {
      padding-inline: 0.625rem;
    }
  }
</style>
