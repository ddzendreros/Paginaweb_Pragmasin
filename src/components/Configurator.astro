      { label: "En ruta", base: 7, counts: "En ruta" },
      { label: "Bajo mínimo", base: 7, counts: "" },
    ],
    items: [
      { title: "Pedido 5210", detail: "Ruta Norte", extra: "24 cajas", status: "Cargando" },
      { title: "Pedido 5211", detail: "Ruta Centro", extra: "12 cajas", status: "En ruta" },
      { title: "Pedido 5212", detail: "Ruta Sur", extra: "31 cajas", status: "Entregado" },
      { title: "Pedido 5213", detail: "Ruta Norte", extra: "8 cajas", status: "Cargando" },
      { title: "Pedido 5214", detail: "Ruta Oriente", extra: "16 cajas", status: "En ruta" },
      { title: "Pedido 5215", detail: "Ruta Centro", extra: "40 cajas", status: "Cargando" },
    ],
    draft: {
      titles: ["Pedido 5216", "Pedido 5217", "Pedido 5218"],
