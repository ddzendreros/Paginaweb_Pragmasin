---
import logoMono from "../../branding/logo/logo-mono.svg?raw";
import { hasWhatsapp, site, waMessages, whatsappUrl } from "../site";

const year = new Date().getFullYear();
const waHref = whatsappUrl(waMessages.pie);
---

<footer class="ground-dark site-footer">
  <div class="act__inner site-footer__inner">
    <div class="grid-12">
      <div class="site-footer__brand">
        <span class="site-footer__mark" aria-hidden="true" set:html={logoMono} />
        <p class="site-footer__tagline">Deja de adaptarte a tu software.</p>
        <p class="caption">Software y automatización a la medida</p>
      </div>

      <nav class="site-footer__cols" aria-label="Pie de página">
        <div>
          <p class="label">Sitio</p>
          <ul class="site-footer__list">
            <li><a class="link" href="/servicios">Qué construimos</a></li>
            <li><a class="link" href="/metodo">Cómo trabajamos</a></li>
            <li><a class="link" href="/contacto">Contacto</a></li>
          </ul>
        </div>
        <div>
          <p class="label">Directo</p>
          <ul class="site-footer__list">
            <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
            {
              hasWhatsapp && waHref && (
                <li>
                  <a class="link" href={waHref} target="_blank" rel="noopener">
                    WhatsApp
                  </a>
                </li>
              )
            }
            <li><a class="link" href="/privacidad">Aviso de privacidad</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="site-footer__meta">
      <p class="caption">
        <span lang="grc">πρᾶγμα</span> — hecho realizado · <span lang="grc">σύν</span> — junto
        con
      </p>
      <p class="caption">© {year} Pragmasyn · Pragmasyn es parte de Grupo Zendreros.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8);
  }
  .site-footer__brand {
    --col: 1 / span 6;
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .site-footer__mark :global(svg) {
    display: block;
    height: var(--space-6);
    width: auto;
    color: var(--fg);
  }
  .site-footer__tagline {
    margin-block-start: var(--space-3);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
    font-weight: var(--weight-medium);
  }
  .site-footer__cols {
    --col: 7 / span 6;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6) var(--gutter);
    align-content: start;
  }
  .site-footer__list {
    margin-block-start: var(--space-2);
    font-size: var(--text-small);
  }
  .site-footer__list .link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--fg);
    text-decoration: none;
  }
  .site-footer__list .link:hover {
    color: var(--interactive);
    text-decoration: underline;
    text-decoration-thickness: var(--hairline);
  }
  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--gutter);
    padding-block-start: var(--space-4);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  @media (width <= 56rem) {
    .site-footer__brand {
      margin-block-end: var(--space-7);
    }
    .site-footer__list .link {
      min-height: 44px;
    }
  }
</style>
