---
import logoMono from "../../branding/logo/logo-mono.svg?raw";
import { hasWhatsapp, site, waMessages, whatsappUrl } from "../site";

const year = new Date().getFullYear();
const waHref = whatsappUrl(waMessages.pie);
---

<footer class="ground-dark site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__mark" aria-hidden="true" set:html={logoMono} />
      <p class="site-footer__tagline serif">
        Tu operación habla.<br />La IA actúa.
      </p>
      <p class="caption site-footer__category">Automatización operativa con IA</p>
    </div>

    <nav class="site-footer__cols" aria-label="Pie de página">
      <div class="site-footer__col">
        <p class="label">Sitio</p>
        <ul class="site-footer__list">
          <li><a class="link" href="/#precios">El diagnóstico</a></li>
          <li><a class="link" href="/servicios">Servicios</a></li>
          <li><a class="link" href="/metodo">Método</a></li>
          <li><a class="link" href="/contacto">Contacto</a></li>
        </ul>
      </div>
      <div class="site-footer__col">
        <p class="label">Directo</p>
        <ul class="site-footer__list">
          <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
          {
            hasWhatsapp && waHref && (
              <li>
                <a class="link" href={waHref} target="_blank" rel="noopener">
                  WhatsApp
                </a>
              </li>
            )
          }
          <li><a class="link" href="/privacidad">Aviso de privacidad</a></li>
        </ul>
      </div>
    </nav>

    <div class="site-footer__meta">
      <p class="caption site-footer__etym">
        <span lang="grc">πρᾶγμα</span> — hecho realizado · <span lang="grc">σύν</span> — junto
        con
      </p>
      <p class="caption">© {year} Pragmasyn</p>
      <p class="caption">Pragmasyn es parte de Grupo Zendreros.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-sunken);
    border-top: var(--hairline) solid var(--hairline-color);
  }
  .site-footer__inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--margin);
    padding-block: var(--space-9);
    display: grid;
    grid-template-columns: 3fr 4fr 3fr;
    gap: var(--space-8) var(--gutter);
    align-items: start;
  }
  .site-footer__mark :global(svg) {
    display: block;
    height: var(--space-7);
    width: auto;
    color: var(--fg-secondary);
  }
  /* the slogan is the one place the serif still speaks at size */
  .site-footer__tagline {
    margin-top: var(--space-5);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
  }
  .site-footer__category {
    margin-top: var(--space-3);
  }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--space-6) var(--gutter);
  }
  .site-footer__list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-small);
  }
  .site-footer__meta {
    display: grid;
    gap: var(--space-3);
    justify-items: end;
    text-align: right;
  }
  @media (max-width: 56rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
    .site-footer__meta {
      justify-items: start;
      text-align: left;
    }
  }
</style>
