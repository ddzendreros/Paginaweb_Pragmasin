---
import logoMono from "../../branding/logo/logo-mono.svg?raw";

const year = new Date().getFullYear();
---

<footer class="ground-dark site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__mark" aria-hidden="true" set:html={logoMono} />
      <p class="site-footer__tagline">
        Problemas complejos,<br />soluciones ejecutables.
      </p>
    </div>
    <nav aria-label="Pie de página">
      <ul class="site-footer__nav">
        <li><a class="link" href="/metodo">Método</a></li>
        <li><a class="link" href="/servicios">Servicios</a></li>
        <li><a class="link" href="/contacto">Contacto</a></li>
      </ul>
    </nav>
    <div class="site-footer__meta">
      <p class="caption site-footer__etym">
        <span lang="grc">πρᾶγμα</span> — hecho realizado · <span lang="grc">σύν</span> — junto
        con
      </p>
      <p class="caption">
        © {year} Pragmasyn · <a class="link" href="/privacidad">Aviso de privacidad</a>
      </p>
      <p class="caption">Pragmasyn es parte de Grupo Zendreros.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-sunken);
    border-top: var(--hairline) solid var(--hairline-color);
  }
  .site-footer__inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--margin);
    padding-block: var(--space-9);
    display: grid;
    grid-template-columns: 2fr 1fr 2fr;
    gap: var(--space-8) var(--gutter);
    align-items: start;
  }
  .site-footer__mark :global(svg) {
    display: block;
    height: var(--space-7);
    width: auto;
    color: var(--fg-secondary);
  }
  .site-footer__tagline {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    font-weight: var(--weight-display-quiet);
  }
  .site-footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-small);
  }
  .site-footer__meta {
    display: grid;
    gap: var(--space-3);
    justify-items: end;
    text-align: right;
  }
  @media (max-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
    .site-footer__meta {
      justify-items: start;
      text-align: left;
    }
  }
</style>
