    }
    :global(.stage-on) .scene__text {
      grid-row: 3;
    }
    :global(.stage-on) .scene__strip {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      gap: var(--space-1);
      padding-inline-end: var(--space-8);
    }
  }
