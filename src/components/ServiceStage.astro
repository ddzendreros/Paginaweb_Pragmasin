  }
  .scene__name {
    display: grid;
    gap: var(--space-3);
  }
  .scene__label {
    font-size: var(--text-small);
    line-height: var(--leading-small);
    font-weight: var(--weight-medium);
    color: var(--fg-secondary);
  }
  :global(html:not(.stage-on)) .stage__group > .scene__label {
    padding-block-start: var(--space-7);
    padding-inline: var(--margin);
  }
  .stage__title {
    font-size: var(--text-block);
    line-height: var(--leading-block);
    letter-spacing: var(--tracking-block);
    font-stretch: var(--width-block);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    text-wrap: balance;
  }
  /* a stranded "a" at the end of a line reads as a typo */
  .stage__title :global(span) {
    white-space: nowrap;
  }
  .stage__title--first {
    font-size: var(--text-block-first);
  }
  .scene__text {
