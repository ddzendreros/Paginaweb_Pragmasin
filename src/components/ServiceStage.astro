  }
  .scene__signals {
    display: grid;
    gap: var(--space-1);
    color: var(--fg-secondary);
  }

  /* --- la pieza: una idea por pantalla -------------------------------------- */
  :global(.stage-on) .stage {
    position: relative;
    height: calc(100svh + var(--steps) * 44svh);
    padding: 0;
  }
  :global(.stage-on) .stage__pin {
    position: sticky;
    inset-block-start: 0;
    height: 100svh;
    overflow: clip;
  }
  :global(.stage-on) .stage__piece {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    opacity: 0;
    transition: opacity var(--dur-5) var(--ease-out);
  }
  :global(.stage-on) .stage__piece.is-on {
    opacity: 1;
  }
  /* The dashed line under every scene, lit as far as the page has come. */
  :global(.stage-on) .stage__line {
    display: block;
    position: absolute;
    inset-inline: var(--margin);
    inset-block-end: var(--strip);
    height: 0;
    border-block-start: var(--hairline) dashed var(--night-500);
  }
  :global(.stage-on) .stage__line::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-start: -1px;
    height: 1px;
    background: var(--strand);
    transform: scaleX(var(--progress, 0));
    transform-origin: left center;
  }
  :global(.stage-on) .stage__group {
    display: contents;
  }
  :global(.stage-on) .scene {
    position: absolute;
    inset: 0;
    grid-template-columns: minmax(0, 7fr) minmax(0, 2fr) minmax(0, 3fr);
    grid-template-rows: minmax(0, 1fr);
    gap: var(--gutter);
    max-width: none;
    margin: 0;
    padding: calc(var(--header-space) + var(--space-5)) var(--margin)
      calc(var(--strip) + var(--space-6));
    border: 0;
    pointer-events: none;
  }
  :global(.stage-on) .scene__name {
    grid-column: 1;
    align-self: start;
    align-content: start;
  }
  /* a title with nothing above it starts where the others do */
  :global(.stage-on) .scene__name > .stage__title:first-child {
    margin-block-start: calc(var(--text-small) * var(--leading-small) + var(--space-3));
  }
  :global(.stage-on) .scene__text {
    grid-column: 3;
    align-self: end;
  }
  :global(.stage-on) .scene__strip {
    position: absolute;
    inset-inline: var(--margin);
    inset-block-end: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
