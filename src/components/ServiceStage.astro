  :global(.stage-on) .scene__signals {
    display: grid;
    color: var(--fg);
  }
  :global(.stage-on) .scene__signals li {
    grid-area: 1 / 1;
  }

  /* The others are only transparent: a screen reader still reads them all. */
  :global(.stage-on) .beat {
    opacity: 0;
    translate: 0 0.625rem;
    filter: blur(6px);
    transition: opacity var(--dur-3) var(--ease-out), translate var(--dur-3) var(--ease-out),
      filter var(--dur-3) var(--ease-out);
  }
  :global(.stage-on) .beat.is-at {
    opacity: 1;
    translate: 0 0;
    filter: blur(0);
  }

  /* a phone on its side keeps the three columns: there is no height to stack */
  @media (height <= 30rem) {
    :global(.stage-on) .stage {
      --strip: 3.25rem;
    }
    :global(.stage-on) .scene {
