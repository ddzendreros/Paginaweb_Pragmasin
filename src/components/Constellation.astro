---
/**
 * La constelación: miles de triángulos que forman las tres cintas del logo,
 * con el color real de cada punto. Viven detrás de todo el sitio. Se reúnen en
 * el hero, se dispersan como un campo de estrellas al bajar y se vuelven a
 * reunir en el cierre. Se apartan del cursor. Sin WebGL 2 o sin JavaScript queda
 * el arte estático de Strands, y con movimiento reducido no se anima.
 */
import logoSvg from "../../branding/logo/logo.svg?raw";

const logoUri = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(logoSvg)}`;
---

<canvas class="constellation" aria-hidden="true" data-constellation data-logo={logoUri}></canvas>

<script>
  const VERTEX = `#version 300 es
  in vec2 aCorner;
  in vec3 aBary;
  in vec2 aTarget;
  in vec2 aField;
  in vec3 aColor;
  in vec4 aSeed;
  uniform vec2 uRes;
  uniform vec2 uCenter;
  uniform vec3 uPointer;
  uniform float uScale, uTime, uForm, uAngle, uFieldAlpha, uFormAlpha;
  out vec3 vColor;
  out vec3 vBary;
  out float vAlpha;
  out float vSolid;

  void main() {
    float spread = clamp(uForm * 1.6 - aSeed.z * 0.6, 0.0, 1.0);
    float form = spread * spread * (3.0 - 2.0 * spread);

    float c = cos(uAngle);
    float s = sin(uAngle);
    vec2 target = mat2(c, -s, s, c) * aTarget;
    target += 0.011 * vec2(sin(uTime * 0.7 + aSeed.x * 6.28), cos(uTime * 0.6 + aSeed.x * 9.0));
    vec2 formed = uCenter + target * uScale;

    vec2 sway = 0.018 * vec2(sin(uTime * 0.09 + aSeed.x * 40.0), cos(uTime * 0.07 + aSeed.x * 23.0));
    vec2 field = (aField + sway) * uRes;

    vec2 position = mix(field, formed, form);

    vec2 away = position - uPointer.xy;
    float reach = dot(away, away);
    position += normalize(away + 0.001) * uPointer.z * exp(-reach / 16000.0) * 46.0;

    float turn = aSeed.x * 6.28 + uTime * (0.15 + aSeed.y * 0.35);
    float size = mix(1.7, 4.4, aSeed.y);
    vec2 corner = mat2(cos(turn), -sin(turn), sin(turn), cos(turn)) * aCorner * size;

    vec2 clip = (position + corner) / uRes * 2.0 - 1.0;
    gl_Position = vec4(clip.x, -clip.y, 0.0, 1.0);

    vColor = aColor;
    vBary = aBary;
    vSolid = aSeed.w;
    float twinkle = 0.72 + 0.28 * sin(uTime * (0.6 + aSeed.y) + aSeed.x * 30.0);
    vAlpha = mix(uFieldAlpha * (0.35 + 0.65 * aSeed.y), uFormAlpha, form) * twinkle;
  }`;

  const FRAGMENT = `#version 300 es
  precision mediump float;
  in vec3 vColor;
  in vec3 vBary;
  in float vAlpha;
  in float vSolid;
  out vec4 color;

  void main() {
    float edge = min(vBary.x, min(vBary.y, vBary.z));
    if (vSolid < 0.68 && edge > 0.17) discard;
    color = vec4(vColor * vAlpha, vAlpha);
  }`;

  /** Reads the logo and returns where its color is: x, y, r, g, b per point. */
  async function sampleLogo(uri: string, count: number): Promise<Float32Array> {
    const image = new Image();
    image.src = uri;
    await image.decode();
    const width = 420;
    const height = Math.round((width * image.naturalHeight) / image.naturalWidth);
    const canvas = document.createElement("canvas");
    canvas.width = width;
    canvas.height = height;
    const context = canvas.getContext("2d", { willReadFrequently: true });
    if (!context) throw new Error("no 2d");
    context.drawImage(image, 0, 0, width, height);
    const { data } = context.getImageData(0, 0, width, height);

    const inked: number[] = [];
    for (let y = 0; y < height; y++) {
      for (let x = 0; x < width; x++) {
        if ((data[(y * width + x) * 4 + 3] ?? 0) > 140) inked.push(x, y);
      }
    }
    const points = new Float32Array(count * 5);
    for (let i = 0; i < count; i++) {
      const pick = Math.floor(Math.random() * (inked.length / 2)) * 2;
      const x = inked[pick] ?? 0;
      const y = inked[pick + 1] ?? 0;
      const offset = (y * width + x) * 4;
      // The turning point is the center of the mark, not of its box.
      points[i * 5] = (x + Math.random()) / width - 0.5;
      points[i * 5 + 1] = ((y + Math.random()) / height - 0.57) * (height / width);
      points[i * 5 + 2] = (data[offset] ?? 0) / 255;
      points[i * 5 + 3] = (data[offset + 1] ?? 0) / 255;
      points[i * 5 + 4] = (data[offset + 2] ?? 0) / 255;
    }
    return points;
  }

  function compile(gl: WebGL2RenderingContext, type: number, source: string): WebGLShader {
    const shader = gl.createShader(type);
    if (!shader) throw new Error("no shader");
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    return shader;
  }

  const smooth = (edge0: number, edge1: number, x: number): number => {
    const t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)));
    return t * t * (3 - 2 * t);
  };

  async function start(canvas: HTMLCanvasElement): Promise<void> {
    const gl = canvas.getContext("webgl2", { alpha: true, antialias: true });
    if (!gl) return;

    const small = window.innerWidth < 900;
    const total = small ? 3200 : 7000;
    let live = total;
    const logo = await sampleLogo(canvas.dataset["logo"] ?? "", total);

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, compile(gl, gl.VERTEX_SHADER, VERTEX));
    gl.attachShader(program, compile(gl, gl.FRAGMENT_SHADER, FRAGMENT));
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    const vao = gl.createVertexArray();
    gl.bindVertexArray(vao);

    const attribute = (name: string, data: Float32Array, size: number, divisor: number): void => {
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
      const location = gl.getAttribLocation(program, name);
      gl.enableVertexAttribArray(location);
      gl.vertexAttribPointer(location, size, gl.FLOAT, false, 0, 0);
      gl.vertexAttribDivisor(location, divisor);
    };

    // One triangle, repeated once per particle.
    attribute("aCorner", new Float32Array([0, -1, 0.87, 0.5, -0.87, 0.5]), 2, 0);
    attribute("aBary", new Float32Array([1, 0, 0, 0, 1, 0, 0, 0, 1]), 3, 0);

    const target = new Float32Array(total * 2);
    const color = new Float32Array(total * 3);
    const field = new Float32Array(total * 2);
    const seed = new Float32Array(total * 4);
    for (let i = 0; i < total; i++) {
      target[i * 2] = logo[i * 5] ?? 0;
      target[i * 2 + 1] = logo[i * 5 + 1] ?? 0;
      color[i * 3] = logo[i * 5 + 2] ?? 0;
      color[i * 3 + 1] = logo[i * 5 + 3] ?? 0;
      color[i * 3 + 2] = logo[i * 5 + 4] ?? 0;
      field[i * 2] = Math.random();
      field[i * 2 + 1] = Math.random();
      seed[i * 4] = Math.random();
      seed[i * 4 + 1] = Math.pow(Math.random(), 1.8);
      seed[i * 4 + 2] = Math.random();
      seed[i * 4 + 3] = Math.random();
    }
    attribute("aTarget", target, 2, 1);
    attribute("aColor", color, 3, 1);
    attribute("aField", field, 2, 1);
    attribute("aSeed", seed, 4, 1);

    const uniform = (name: string): WebGLUniformLocation | null =>
      gl.getUniformLocation(program, name);
    const u = {
      res: uniform("uRes"),
      center: uniform("uCenter"),
      pointer: uniform("uPointer"),
      scale: uniform("uScale"),
      time: uniform("uTime"),
      form: uniform("uForm"),
      angle: uniform("uAngle"),
      fieldAlpha: uniform("uFieldAlpha"),
      formAlpha: uniform("uFormAlpha"),
    };

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE);
    gl.clearColor(0, 0, 0, 0);

    const hero = document.querySelector<HTMLElement>(".hero");
    const closing = document.querySelector<HTMLElement>(".closing-act");
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

    let width = 0;
    let height = 0;
    const resize = (): void => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(u.res, width, height);
    };
    resize();
    window.addEventListener("resize", resize, { passive: true });

    const pointer = { x: -9999, y: -9999, strength: 0, wanted: 0 };
    if (window.matchMedia("(hover: hover)").matches) {
      window.addEventListener(
        "pointermove",
        (event) => {
          pointer.x = event.clientX;
          pointer.y = event.clientY;
          pointer.wanted = 1;
        },
        { passive: true },
      );
      document.addEventListener("pointerleave", () => {
        pointer.wanted = 0;
      });
    }

    /** How gathered the particles should be, and where, for this scroll. */
    const placement = (): { form: number; x: number; y: number; scale: number } => {
      const narrow = width < 900;
      let form = 0;
      let x = width * (narrow ? 0.74 : 0.79);
      let y = height * (narrow ? 0.3 : 0.44);
      let scale = narrow ? width * 1.05 : Math.min(width * 0.44, 640);

      if (hero) {
        const box = hero.getBoundingClientRect();
        form = 1 - smooth(height * 0.02, height * 0.62, -box.top);
      }
      if (closing) {
        const box = closing.getBoundingClientRect();
        const gathered = smooth(height * 0.95, height * 0.25, box.top);
        if (gathered > form) {
          form = gathered;
          x = width * (narrow ? 0.76 : 0.86);
          y = box.top + box.height * 0.42;
          scale = narrow ? width * 0.9 : Math.min(width * 0.36, 520);
        }
      }
      return { form, x, y, scale };
    };

    document.documentElement.classList.add("has-constellation");
    canvas.classList.add("is-on");

    const born = performance.now();
    let slowFrames = 0;
    let last = born;

    const paint = (now: number, form: number, place: ReturnType<typeof placement>): void => {
      const time = (now - born) / 1000;
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform1f(u.time, time);
      gl.uniform1f(u.form, form);
      gl.uniform2f(u.center, place.x, place.y);
      gl.uniform1f(u.scale, place.scale);
      gl.uniform1f(u.angle, calm.matches ? 0 : time * 0.035);
      gl.uniform1f(u.fieldAlpha, 0.4);
      // On a phone the mark sits behind the words and has to step back from them.
      gl.uniform1f(u.formAlpha, width < 900 ? 0.42 : 0.95);
      gl.uniform3f(u.pointer, pointer.x, pointer.y, pointer.strength);
      gl.drawArraysInstanced(gl.TRIANGLES, 0, 3, live);
    };

    if (calm.matches) {
      const still = (): void => {
        const place = placement();
        paint(born, place.form, place);
      };
      still();
      window.addEventListener("scroll", still, { passive: true });
      window.addEventListener("resize", still, { passive: true });
      return;
    }

    let shownForm = 0;
    const frame = (now: number): void => {
      requestAnimationFrame(frame);
      if (document.hidden) {
        last = now;
        return;
      }
      // A device that can't keep up loses particles, not smoothness.
      const spent = now - last;
      last = now;
      slowFrames = spent > 30 ? slowFrames + 1 : Math.max(0, slowFrames - 1);
      if (slowFrames > 40 && live > 1400) {
        live = Math.round(live * 0.75);
        slowFrames = 0;
      }

      pointer.strength += (pointer.wanted - pointer.strength) * 0.08;
      const place = placement();
      // Gathers on arrival: the first thing the page does is assemble the mark.
      const arrival = smooth(250, 2800, now - born);
      const wanted = place.form * arrival;
      shownForm += (wanted - shownForm) * 0.075;
      paint(now, shownForm, place);
    };
    requestAnimationFrame(frame);
  }

  const canvas = document.querySelector<HTMLCanvasElement>("[data-constellation]");
  if (canvas) start(canvas).catch(() => canvas.remove());
</script>

<style>
  .constellation {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-5) var(--ease-out);
  }
  .constellation.is-on {
    opacity: 1;
  }
  @media print {
    .constellation {
      display: none;
    }
  }
</style>
