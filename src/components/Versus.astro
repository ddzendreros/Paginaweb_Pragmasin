---
/**
 * La comparación como demostración: una pantalla llena de módulos que no usas
 * contra la misma pantalla con solo lo tuyo. Se cambia con el interruptor y, si
 * nadie lo toca, cambia sola mientras está a la vista. Sin JS se leen las dos
 * listas completas.
 */
import Icon from "./Icon.astro";

const sides = [
  {
    id: "generic",
    label: "Con software genérico",
    icon: "x" as const,
    lines: [
      "Cambias tu proceso para que quepa en sus pantallas.",
      "Pagas cada mes por usuario, aunque uses la mitad.",
      "Lo que le falta se queda en un Excel aparte.",
      "Si dejas de pagar, pierdes el acceso.",
    ],
  },
  {
    id: "custom",
    label: "Con software a tu medida",
    icon: "check" as const,
    lines: [
      "El sistema sigue tu proceso, con tus nombres y tus pasos.",
      "Pagas una sola vez por construirlo.",
      "Lo que hoy vive en tres Excels queda en un solo lugar.",
      "El software es tuyo.",
    ],
  },
];

// Doce módulos en la pantalla genérica. Cuatro sobreviven, crecen y se vuelven
// piezas propias: una línea, un anillo, unas barras y otra línea.
const keep = new Map([
  [1, { to: [0, 0], art: "rise" }],
  [6, { to: [1, 0], art: "ring" }],
  [8, { to: [0, 1], art: "bars" }],
  [11, { to: [1, 1], art: "fall" }],
]);
const cells = Array.from({ length: 12 }, (_, i) => ({
  col: i % 4,
  row: Math.floor(i / 4),
  to: keep.get(i)?.to,
  art: keep.get(i)?.art,
}));
---

<div class="versus" data-versus data-state="generic">
  <div class="versus__switch" role="group" aria-label="Comparación">
    <span class="versus__thumb" aria-hidden="true"></span>
    {
      sides.map((side, i) => (
        <button type="button" data-set={side.id} aria-pressed={i === 0 ? "true" : "false"}>
          {side.label}
        </button>
      ))
    }
  </div>

  <div class="versus__stage">
    <div class="versus__desk" aria-hidden="true">
      <div class="versus__screen">
        <svg class="versus__defs" width="0" height="0">
          <defs>
            <linearGradient id="versus-ink" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" style="stop-color: var(--lit-a)"></stop>
              <stop offset="1" style="stop-color: var(--lit-b)"></stop>
            </linearGradient>
            <linearGradient id="versus-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color: var(--lit-a); stop-opacity: 0.28"></stop>
              <stop offset="1" style="stop-color: var(--lit-b); stop-opacity: 0"></stop>
            </linearGradient>
          </defs>
        </svg>
        <span class="versus__bar">
          <i></i><i></i><i></i>
          <span class="versus__tools"><u></u><u></u><u></u><u></u><u></u><u></u></span>
          <span class="versus__brand"></span>
        </span>
        <div class="versus__grid">
          {
            cells.map((cell) => (
              <span
                class:list={["cell", { "cell--keep": cell.to }]}
                style={`--c: ${cell.col}; --r: ${cell.row}; --kc: ${cell.to?.[0] ?? 0}; --kr: ${cell.to?.[1] ?? 0};`}
              >
                <b>
                  {cell.art === "rise" && (
                    <svg class="cell__art cell__art--line" viewBox="0 0 120 48" preserveAspectRatio="none">
                      <path class="cell__area" fill="url(#versus-fill)" d="M2 42C22 40 30 30 48 29S78 21 92 15 110 7 118 6V48H2Z" />
                      <path stroke="url(#versus-ink)" d="M2 42C22 40 30 30 48 29S78 21 92 15 110 7 118 6" />
                    </svg>
                  )}
                  {cell.art === "rise" && <em class="cell__pulse" />}
                  {cell.art === "fall" && (
                    <svg class="cell__art cell__art--line" viewBox="0 0 120 48" preserveAspectRatio="none">
                      <path class="cell__area" fill="url(#versus-fill)" d="M2 10C18 8 30 20 46 20S72 13 86 25 108 38 118 40V48H2Z" />
                      <path stroke="url(#versus-ink)" d="M2 10C18 8 30 20 46 20S72 13 86 25 108 38 118 40" />
                    </svg>
                  )}
                  {cell.art === "ring" && (
                    <svg class="cell__art cell__art--ring" viewBox="0 0 48 48">
                      <circle class="cell__track" cx="24" cy="24" r="20" />
                      <circle class="cell__track" cx="24" cy="24" r="13" />
                      <circle class="cell__arc" stroke="url(#versus-ink)" pathLength="1" cx="24" cy="24" r="20" />
                      <circle class="cell__arc cell__arc--in" stroke="url(#versus-ink)" pathLength="1" cx="24" cy="24" r="13" />
                    </svg>
                  )}
                  {cell.art === "bars" && (
                    <span class="cell__bars">
                      <u style="--h: 44%; --i: 0" />
                      <u style="--h: 72%; --i: 1" />
                      <u style="--h: 56%; --i: 2" />
                      <u style="--h: 100%; --i: 3" />
                      <u style="--h: 80%; --i: 4" />
                    </span>
                  )}
                  <i />
                  <i />
                </b>
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="versus__side">
      {
        sides.map((side) => (
          <ul class="versus__list" data-list={side.id} aria-label={side.label}>
            {side.lines.map((line) => (
              <li>
                <span class="versus__mark">
                  <Icon name={side.icon} />
                </span>
                {line}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-versus]");
  if (root) {
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-set]"));
    const lists = Array.from(root.querySelectorAll<HTMLElement>("[data-list]"));
    let timer = 0;

    const show = (state: string): void => {
      root.dataset["state"] = state;
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset["set"] === state));
      }
      for (const list of lists) {
        const shown = list.dataset["list"] === state;
        list.classList.toggle("is-off", !shown);
        if (!shown || calm) continue;
        list.querySelectorAll("li").forEach((line, i) => {
          line.animate(
            [
              { opacity: 0, translate: "0.625rem 0" },
              { opacity: 1, translate: "0 0" },
            ],
            { duration: 420, delay: i * 55, easing: "cubic-bezier(0.22, 1.1, 0.36, 1)", fill: "backwards" },
          );
        });
      }
    };

    const flip = (): void => show(root.dataset["state"] === "generic" ? "custom" : "generic");
    const stop = (): void => window.clearTimeout(timer);
    // The answer stays on screen for twice as long as the problem.
    const play = (): void => {
      const wait = root.dataset["state"] === "custom" ? 6500 : 3200;
      timer = window.setTimeout(() => {
        flip();
        play();
      }, wait);
    };

    root.classList.add("is-ready");
    show("generic");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        stop();
        show(button.dataset["set"] ?? "generic");
      });
    }

    // Plays by itself only until someone takes over, and only while in view.
    if (!calm) {
      let touched = false;
      root.addEventListener("pointerdown", () => (touched = true));
      new IntersectionObserver(([entry]) => {
        stop();
        if (entry?.isIntersecting && !touched) play();
      }, { threshold: 0.4 }).observe(root);
    }
  }
</script>

<style>
  .versus {
    display: grid;
    justify-items: center;
    gap: clamp(var(--space-4), 2.2vw, var(--space-5));
  }
  .versus__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3);
    width: 100%;
  }
  @media (width <= 56rem) {
    .versus__stage {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* --- el interruptor ------------------------------------------------------ */
  .versus__switch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: min(100%, 28rem);
    padding: var(--space-1);
    background: var(--paper-mist);
    border-radius: var(--radius-pill);
  }
  .versus__thumb {
    position: absolute;
    inset-block: var(--space-1);
    inset-inline-start: var(--space-1);
    width: calc(50% - var(--space-1));
    background: var(--action-bg);
    border-radius: var(--radius-pill);
    transition: translate var(--dur-3) var(--ease-spring);
  }
  .versus__thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-lit);
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  [data-state="custom"] .versus__thumb {
    translate: 100% 0;
  }
  [data-state="custom"] .versus__thumb::after {
    opacity: 1;
  }
  .versus__switch button {
    position: relative;
    z-index: 1;
    min-height: 44px;
    padding: var(--space-1) var(--space-2);
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    font: inherit;
    font-size: var(--text-small);
    line-height: var(--leading-small);
    color: var(--fg-secondary);
    cursor: pointer;
    transition: color var(--dur-2) var(--ease-out);
  }
  .versus__switch button[aria-pressed="true"] {
    color: var(--action-fg);
  }
  .versus__switch button:focus-visible {
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }

  /* --- la pantalla, flotando sobre su tarjeta ------------------------------ */
  .versus__desk {
    display: grid;
    padding: clamp(var(--space-3), 2vw, var(--space-5));
    background: var(--paper-mist);
    border-radius: var(--radius-xl);
    transition: background-color var(--dur-4) var(--ease-out);
  }
  [data-state="custom"] .versus__desk {
    background: var(--violet-mist);
  }
  .versus__screen {
    display: flex;
    flex-direction: column;
    min-height: clamp(13rem, 20vw, 16rem);
    padding: var(--space-3);
    background: var(--white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-float);
    transition: box-shadow var(--dur-4) var(--ease-out);
  }
  [data-state="custom"] .versus__screen {
    box-shadow: var(--shadow-lit);
  }
  .versus__defs {
    position: absolute;
  }
  .versus__bar {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
    margin-block-end: var(--space-3);
    padding-inline-start: 0.1875rem;
  }
  .versus__bar i {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--paper-rule);
  }
  /* the toolbar: a row of things you don't use, and then only yours */
  .versus__tools {
    display: flex;
    flex: 1;
    gap: 0.3125rem;
    margin-inline: var(--space-2);
  }
  .versus__tools u {
    flex: 1;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--paper-mist);
    transition: opacity var(--dur-3) var(--ease-out), background-color var(--dur-4) var(--ease-out);
  }
  [data-state="custom"] .versus__tools u:nth-child(n + 3) {
    opacity: 0;
  }
  [data-state="custom"] .versus__tools u:nth-child(-n + 2) {
    background: var(--violet-mist);
  }
  [data-state="custom"] .versus__tools u:first-child {
    background: var(--gradient-lit);
  }
  .versus__brand {
    flex: none;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--gradient-lit);
    opacity: 0;
    scale: 0.4;
    transition: opacity var(--dur-3) var(--ease-out), scale var(--dur-4) var(--ease-spring);
  }
  [data-state="custom"] .versus__brand {
    opacity: 1;
    scale: 1;
    transition-delay: var(--dur-2);
  }
  .versus__grid {
    position: relative;
    flex: 1;
  }
  .cell {
    position: absolute;
    inset-block-start: calc(var(--r) * 100% / 3);
    inset-inline-start: calc(var(--c) * 25%);
    width: 25%;
    height: calc(100% / 3);
    padding: 0.1875rem;
    transition: inset-block-start var(--dur-4) var(--ease-out),
      inset-inline-start var(--dur-4) var(--ease-out), width var(--dur-4) var(--ease-out),
      height var(--dur-4) var(--ease-out), scale var(--dur-4) var(--ease-out),
      opacity var(--dur-3) var(--ease-out);
  }
  .cell b {
    position: relative;
    display: grid;
    align-content: end;
    gap: 0.25rem;
    height: 100%;
    padding: var(--space-2);
    border-radius: var(--radius-m);
    background: var(--paper-mist);
    overflow: hidden;
    transition: background-color var(--dur-4) var(--ease-out),
      border-radius var(--dur-4) var(--ease-out), box-shadow var(--dur-4) var(--ease-out);
  }
  .cell > b > i {
    display: block;
    height: 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--paper-ink);
    opacity: 0.12;
    transition: background-color var(--dur-4) var(--ease-out), opacity var(--dur-4) var(--ease-out);
  }
  .cell > b > i:last-child {
    width: 60%;
  }
  [data-state="custom"] .cell:not(.cell--keep) {
    opacity: 0;
    scale: 0.82;
  }
  [data-state="custom"] .cell--keep {
    inset-block-start: calc(var(--kr) * 50%);
    inset-inline-start: calc(var(--kc) * 50%);
    width: 50%;
    height: 50%;
  }
  [data-state="custom"] .cell--keep b {
    border-radius: var(--radius-l);
    background: var(--violet-wash);
    box-shadow: inset 0 0 0 1px rgb(var(--rgb-violet) / 0.12);
  }
  [data-state="custom"] .cell--keep > b > i {
    background: var(--violet-ink);
    opacity: 0.22;
  }

  /* cada módulo que se queda dibuja su pieza al crecer */
  .cell__art {
    position: absolute;
    inset: var(--space-2) var(--space-3) calc(var(--space-5) + 0.25rem);
    width: calc(100% - var(--space-5));
    height: calc(100% - var(--space-6) - 0.25rem);
    max-width: none;
    fill: none;
    stroke: var(--violet-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    overflow: visible;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out), clip-path var(--dur-5) var(--ease-out);
  }
  [data-state="custom"] .cell__art {
    opacity: 1;
    transition-delay: var(--dur-2);
  }
  /* A line stretched by its box keeps an even stroke, which rules out dashes:
     it is uncovered from the left instead. */
  .cell__art--line {
    clip-path: inset(-0.25rem 100% -0.25rem -0.25rem);
  }
  .cell__art--line path {
    vector-effect: non-scaling-stroke;
  }
  .cell__art--line .cell__area {
    stroke: none;
  }
  [data-state="custom"] .cell__art--line {
    clip-path: inset(-0.25rem);
  }
  /* the line ends in the present: a dot that is still alive */
  .cell__pulse {
    position: absolute;
    inset-block-start: calc(var(--space-2) + (100% - var(--space-6) - 0.25rem) * 0.125);
    inset-inline-end: calc(var(--space-3) + 0.0625rem);
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--lit-b);
    opacity: 0;
    translate: 50% -50%;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  [data-state="custom"] .cell__pulse {
    opacity: 1;
    transition-delay: var(--dur-5);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-state="custom"] .cell__pulse {
      animation: pulse 2200ms var(--ease-out) var(--dur-5) infinite;
    }
  }
  @keyframes pulse {
    from {
      box-shadow: 0 0 0 0 rgb(var(--rgb-blue) / 0.5);
    }
    to {
      box-shadow: 0 0 0 0.625rem rgb(var(--rgb-blue) / 0);
    }
  }
  .cell__art--ring {
    rotate: -90deg;
    stroke-width: 3.5;
  }
  .cell__arc {
    stroke-dasharray: 0.72 1;
    stroke-dashoffset: 0.72;
    transition: stroke-dashoffset var(--dur-5) var(--ease-out);
  }
  .cell__arc--in {
    stroke-dasharray: 0.48 1;
    stroke-dashoffset: 0.48;
    transition-delay: 90ms;
  }
  [data-state="custom"] .cell__arc {
    stroke-dashoffset: 0;
    transition-delay: var(--dur-2);
  }
  .cell__track {
    opacity: 0;
    transition: opacity var(--dur-4) var(--ease-out);
  }
  [data-state="custom"] .cell__track {
    opacity: 0.1;
  }
  .cell__bars {
    position: absolute;
    inset: var(--space-2) var(--space-3) calc(var(--space-5) + 0.25rem);
    display: flex;
    align-items: flex-end;
    gap: 12%;
  }
  .cell__bars u {
    flex: 1;
    height: var(--h);
    border-start-start-radius: var(--radius-s);
    border-start-end-radius: var(--radius-s);
    background: linear-gradient(0deg, var(--lit-b), var(--lit-a));
    transform-origin: bottom;
    scale: 1 0;
    transition: scale var(--dur-4) var(--ease-out);
  }
  [data-state="custom"] .cell__bars u {
    scale: 1 1;
    transition-delay: calc(var(--dur-2) + var(--i) * 60ms);
  }

  /* --- la lista: gris en el problema, iluminada en la respuesta ------------ */
  .versus__side {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-width: 0;
    padding: clamp(var(--space-4), 2.2vw, var(--space-5));
    background: var(--paper-mist);
    border-radius: var(--radius-xl);
    transition: color var(--dur-4) var(--ease-out), box-shadow var(--dur-4) var(--ease-out);
  }
  /* A gradient cannot fade into a flat color, so the light is its own layer. */
  .versus__side::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--surface-lit);
    box-shadow: inset 0 1px 0 rgb(var(--rgb-light) / 0.16),
      inset 0 0 0 1px rgb(var(--rgb-light) / 0.08);
    opacity: 0;
    transition: opacity var(--dur-4) var(--ease-out);
  }
  [data-state="custom"] .versus__side {
    color: var(--white);
    box-shadow: 0 24px 48px -16px rgb(var(--rgb-violet) / 0.45);
  }
  [data-state="custom"] .versus__side::before {
    opacity: 1;
  }
  /* Both lists share one cell, so the longer one sets the height and the page
     never jumps when they swap. */
  .is-ready .versus__list {
    grid-area: 1 / 1;
  }
  .is-off {
    visibility: hidden;
  }
  .versus__list {
    display: grid;
  }
  .versus__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-3);
    font-size: var(--text-body);
    font-weight: var(--weight-paper);
    line-height: var(--leading-lead);
    letter-spacing: var(--tracking-lead);
    text-wrap: pretty;
    border-block-start: var(--hairline) solid color-mix(in srgb, currentColor 12%, transparent);
  }
  .versus__list li:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }
  .versus__list li:last-child {
    padding-block-end: 0;
  }
  .versus__mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    margin-block-start: 0.0625rem;
    border-radius: 50%;
    background: var(--white);
    color: var(--fg-secondary);
  }
  [data-list="custom"] .versus__mark {
    background: var(--gradient-lit);
    box-shadow: 0 0 16px rgb(var(--rgb-violet) / 0.7);
    color: var(--white);
  }
  .versus__mark :global(.icon) {
    width: 0.9375rem;
    height: 0.9375rem;
  }

  /* Without JavaScript both sides stay readable, one after the other. */
  .versus:not(.is-ready) .versus__switch {
    display: none;
  }
  .versus:not(.is-ready) .versus__side {
    gap: var(--space-6);
  }
  .versus:not(.is-ready) .versus__list::before {
    content: attr(aria-label);
    margin-block-end: var(--space-4);
    font-size: var(--text-small);
    color: var(--fg-secondary);
  }
</style>
