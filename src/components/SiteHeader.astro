---
// The color logo here is gradient appearance #1 of 2 site-wide (BRIEF §2.5);
// the second is the OG image. Everything else uses the mono mark.
import logoSvg from "../../branding/logo/logo.svg?raw";

const links = [
  { href: "/servicios", label: "Qué construimos" },
  { href: "/metodo", label: "Cómo trabajamos" },
  { href: "/contacto", label: "Contacto" },
];
const current = Astro.url.pathname.replace(/\/$/, "");
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Pragmasyn — inicio">
      <span class="site-header__mark" aria-hidden="true" set:html={logoSvg} />
      <span class="site-header__word">Pragmasyn</span>
    </a>

    <nav class="site-header__panel" aria-label="Principal">
      <ul class="site-header__nav">
        {
          links.map((l) => (
            <li>
              <a
                class="site-header__link"
                href={l.href}
                aria-current={current === l.href ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      {
        current !== "/contacto" && (
          <a class="btn btn--primary btn--sm site-header__cta" href="/contacto">
            Cuéntanos tu idea
          </a>
        )
      }
      <button
        class="site-header__toggle"
        type="button"
        aria-label="Abrir menú"
        aria-haspopup="dialog"
        data-menu-open
      >
        <span class="site-header__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<dialog class="sheet" aria-label="Menú" data-sheet>
  <button class="sheet__close" type="button" aria-label="Cerrar menú" data-menu-close>
    <span class="sheet__x" aria-hidden="true"></span>
  </button>
  <nav aria-label="Principal">
    <ul class="sheet__nav">
      {
        links.map((l) => (
          <li>
            <a
              class="sheet__link"
              href={l.href}
              aria-current={current === l.href ? "page" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  {
    current !== "/contacto" && (
      <a class="btn btn--primary sheet__cta" href="/contacto">
        Cuéntanos tu idea
      </a>
    )
  }
</dialog>

<script>
  // The mobile menu is a native modal dialog: Esc, focus trap and the return
  // of focus to the trigger come from the platform, not from this script.
  const sheet = document.querySelector<HTMLDialogElement>("[data-sheet]");
  const opener = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closer = document.querySelector<HTMLButtonElement>("[data-menu-close]");

  opener?.addEventListener("click", () => sheet?.showModal());
  closer?.addEventListener("click", () => sheet?.close());
  // A tap on the backdrop lands on the dialog element itself.
  sheet?.addEventListener("click", (event) => {
    if (event.target === sheet) sheet.close();
    else if ((event.target as HTMLElement).closest("a")) sheet.close();
  });
  // A resize past the breakpoint must not leave an open sheet behind.
  window.matchMedia("(width > 56rem)").addEventListener("change", (event) => {
    if (event.matches) sheet?.close();
  });
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: var(--space-3);
    z-index: var(--z-nav);
    padding-inline: var(--margin);
    background: transparent;
  }
  .site-header__inner {
    max-width: var(--content-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gutter);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    background: var(--surface-glass);
    -webkit-backdrop-filter: blur(var(--blur-glass)) saturate(var(--saturate-glass));
    backdrop-filter: blur(var(--blur-glass)) saturate(var(--saturate-glass));
    border: var(--hairline) solid var(--hairline-color);
    border-radius: var(--radius-pill);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    min-height: 44px;
    color: var(--fg);
    text-decoration: none;
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-h4);
  }
  .site-header__mark :global(svg) {
    display: block;
    height: 1.625rem;
    width: auto;
    transition: rotate var(--dur-4) var(--ease-out);
  }
  /* rotation is the mark's implied movement; 120 deg is its own symmetry */
  .site-header__brand:hover .site-header__mark :global(svg) {
    rotate: 120deg;
  }
  .site-header__nav {
    display: flex;
    gap: var(--space-1);
  }
  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--fg-secondary);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    transition: color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }
  .site-header__link:hover,
  .site-header__link[aria-current="page"] {
    color: var(--fg);
    background: var(--bg-sunken);
  }
  .site-header__link:active {
    background: var(--hairline-color);
  }
  .site-header__link:focus-visible {
    border-radius: var(--radius-pill);
  }
  .site-header__actions {
    justify-self: end;
  }
  .site-header__toggle {
    display: none;
  }

  @media (width <= 56rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      padding-inline-start: var(--space-4);
    }
    .site-header__panel,
    .site-header__cta {
      display: none;
    }
    .site-header__toggle {
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: var(--hairline) solid var(--control-border);
      border-radius: 50%;
      background: transparent;
      color: var(--fg);
      cursor: pointer;
      transition: background-color var(--dur-1) var(--ease-out),
        scale var(--dur-1) var(--ease-out);
    }
    .site-header__toggle:hover {
      background: var(--bg-sunken);
    }
    .site-header__toggle:active {
      scale: 0.94;
    }
    .site-header__toggle:focus-visible {
      border-radius: 50%;
    }
    .site-header__bars,
    .site-header__bars::before {
      display: block;
      width: var(--space-4);
      height: var(--hairline-strong);
      background: currentColor;
      border-radius: var(--radius-pill);
    }
    .site-header__bars {
      position: relative;
      translate: 0 calc(var(--space-1) * -0.5);
    }
    .site-header__bars::before {
      content: "";
      position: absolute;
      translate: 0 var(--space-2);
    }
  }
  @media (width <= 22rem) {
    .site-header__word {
      display: none;
    }
  }

  /* --- the sheet: native dialog, slides up from the bottom edge --- */
  .sheet {
    position: fixed;
    inset: auto 0 0 0;
    margin: 0;
    width: 100%;
    max-width: none;
    border: 0;
    padding: var(--space-5) var(--margin) var(--space-7);
    background: var(--bg-raised);
    color: var(--fg);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    translate: 0 100%;
    transition:
      translate var(--dur-3) var(--ease-out),
      display var(--dur-3) allow-discrete,
      overlay var(--dur-3) allow-discrete;
  }
  .sheet[open] {
    translate: 0 0;
  }
  @starting-style {
    .sheet[open] {
      translate: 0 100%;
    }
  }
  /* a modal dialog does not stop the page behind it from scrolling */
  :global(html:has(.sheet[open])) {
    overflow: hidden;
  }
  .sheet::backdrop {
    background: rgb(var(--rgb-ink) / 0.4);
  }
  .sheet__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-inline-start: auto;
    padding: 0;
    border: var(--hairline) solid var(--control-border);
    border-radius: 50%;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: background-color var(--dur-1) var(--ease-out),
      scale var(--dur-1) var(--ease-out);
  }
  .sheet__close:hover {
    background: var(--bg-sunken);
  }
  .sheet__close:active {
    scale: 0.94;
  }
  .sheet__close:focus-visible {
    border-radius: 50%;
  }
  .sheet__x,
  .sheet__x::before {
    display: block;
    width: var(--space-4);
    height: var(--hairline-strong);
    background: currentColor;
    border-radius: var(--radius-pill);
  }
  .sheet__x {
    position: relative;
    rotate: 45deg;
  }
  .sheet__x::before {
    content: "";
    position: absolute;
    rotate: 90deg;
  }
  .sheet__nav {
    display: grid;
    margin-block: var(--space-3) var(--space-5);
  }
  .sheet__link {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-block-end: var(--hairline) solid var(--hairline-color);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    color: var(--fg);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }
  .sheet__link:hover,
  .sheet__link[aria-current="page"] {
    color: var(--interactive);
  }
  .sheet__link:active {
    color: var(--interactive-strong);
  }
  .sheet__link:focus-visible {
    border-radius: var(--radius-xs);
  }
  .sheet__cta {
    width: 100%;
  }
</style>
