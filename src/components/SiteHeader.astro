---
// The color logo here is gradient appearance #1 of 2 site-wide (BRIEF §2.5);
// the second is the OG image. Everything else uses the mono mark.
import logoSvg from "../../branding/logo/logo.svg?raw";

const links = [
  { href: "/metodo", label: "Método" },
  { href: "/servicios", label: "Servicios" },
  { href: "/contacto", label: "Contacto" },
];
const current = Astro.url.pathname.replace(/\/$/, "");
---

<header class="ground-dark site-header" data-header>
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Pragmasyn — inicio">
      <span class="site-header__mark" aria-hidden="true" set:html={logoSvg} />
      <span class="site-header__word">Pragmasyn</span>
    </a>

    <nav class="site-header__panel" id="nav-principal" aria-label="Principal">
      <ul class="site-header__nav">
        {
          links.map((l) => (
            <li>
              <a
                class="site-header__link"
                href={l.href}
                aria-current={current === l.href ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary btn--sm site-header__cta site-header__cta--panel" href="/contacto">
        Diagnóstico de 5 días
      </a>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--primary btn--sm site-header__cta" href="/contacto">
        Diagnóstico de 5 días
      </a>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-principal"
        data-menu-toggle
      >
        <span class="site-header__toggle-bars" aria-hidden="true"></span>
        <span class="site-header__toggle-label">Menú</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Two behaviours, both state — not decoration: the header earns its
  // hairline once the page has moved, and the panel opens on small screens.
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.getElementById("nav-principal");

  const setScrolled = (): void => {
    header?.classList.toggle("is-scrolled", window.scrollY > 8);
  };
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  const setOpen = (open: boolean): void => {
    header?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => {
    setOpen(header?.classList.contains("is-open") !== true);
  });
  panel?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
  // A resize past the breakpoint must not leave a half-open panel behind.
  window.matchMedia("(min-width: 56rem)").addEventListener("change", () => setOpen(false));
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-nav);
    background: var(--surface-glass);
    -webkit-backdrop-filter: blur(var(--blur-glass)) saturate(var(--saturate-glass));
    backdrop-filter: blur(var(--blur-glass)) saturate(var(--saturate-glass));
    border-bottom: var(--hairline) solid transparent;
    transition: border-color var(--dur-2) var(--ease-swift);
  }
  /* the frontier only appears once there is something above it to separate */
  .site-header.is-scrolled {
    border-bottom-color: var(--hairline-color);
  }
  .site-header__inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--margin);
    padding-block: var(--space-2);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gutter);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--fg);
    min-height: 44px;
    justify-self: start;
  }
  .site-header__mark :global(svg) {
    display: block;
    height: var(--space-6);
    width: auto;
    transition: rotate var(--dur-4) var(--ease-rise);
  }
  /* rotation is the mark's implied movement; 120 deg is its own symmetry */
  .site-header__brand:hover .site-header__mark :global(svg) {
    rotate: 120deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__brand:hover .site-header__mark :global(svg) {
      rotate: none;
    }
  }
  .site-header__word {
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-h4);
  }

  .site-header__panel {
    justify-self: center;
  }
  .site-header__nav {
    list-style: none;
    display: flex;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
  }
  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--fg-secondary);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-small);
    transition: color var(--dur-1) var(--ease-swift),
      background-color var(--dur-1) var(--ease-swift);
  }
  .site-header__link:hover {
    color: var(--fg);
    background: var(--surface-card);
  }
  .site-header__link[aria-current="page"] {
    color: var(--fg);
    background: var(--surface-card);
  }

  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .site-header__cta--panel {
    display: none;
  }
  .site-header__toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    background: transparent;
    border: 0;
    color: var(--fg);
    font: inherit;
    font-size: var(--text-small);
    min-height: 44px;
    padding-inline: var(--space-2);
    cursor: pointer;
  }
  .site-header__toggle-bars,
  .site-header__toggle-bars::before {
    display: block;
    width: var(--space-5);
    height: var(--hairline-strong);
    background: currentColor;
    border-radius: var(--radius-pill);
    transition: translate var(--dur-2) var(--ease-swift),
      rotate var(--dur-2) var(--ease-swift);
  }
  .site-header__toggle-bars {
    position: relative;
    translate: 0 calc(var(--space-1) * -1);
  }
  .site-header__toggle-bars::before {
    content: "";
    position: absolute;
    translate: 0 var(--space-2);
  }
  .is-open .site-header__toggle-bars {
    translate: 0 0;
    rotate: 45deg;
  }
  .is-open .site-header__toggle-bars::before {
    translate: 0 0;
    rotate: -90deg;
  }
  .site-header__toggle-label {
    /* the word is for screen readers and wide phones; the bars carry it */
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 56rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }
    .site-header__toggle {
      display: inline-flex;
    }
    .site-header__cta {
      display: none;
    }
    .site-header__cta--panel {
      display: inline-flex;
      width: 100%;
    }
    .site-header__brand {
      grid-row: 1;
      grid-column: 1;
    }
    .site-header__actions {
      grid-row: 1;
      grid-column: 2;
    }
    .site-header__panel {
      display: none;
      justify-self: stretch;
      grid-row: 2;
      grid-column: 1 / -1;
      padding-block: var(--space-4) var(--space-3);
      border-top: var(--hairline) solid var(--hairline-color);
      margin-top: var(--space-2);
    }
    .is-open .site-header__panel {
      display: grid;
      gap: var(--space-4);
    }
    .site-header__nav {
      flex-direction: column;
      gap: var(--space-1);
    }
    .site-header__link {
      justify-content: flex-start;
      padding-inline: var(--space-4);
      font-size: var(--text-body);
      border-radius: var(--radius-m);
    }
  }
  @media (max-width: 22rem) {
    .site-header__word {
      display: none;
    }
  }
</style>
