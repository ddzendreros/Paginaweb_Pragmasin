---
/**
 * Calculadora — brief v3 §7.
 *
 * Cuatro preguntas, resultado inmediato y sin gate de correo (la regla es
 * literal: bloquear el resultado mata la conversión y la confianza).
 *
 * Dos variantes: `compact` para embed en la home, `full` para /calculadora
 * con supuestos, línea de honestidad y el pedido opcional de PDF.
 *
 * Handoff a /contacto: el botón "Agendar 20 minutos" empuja las cifras por
 * query string (?h= horas al mes, ?d= dinero al año) y el formulario las
 * lee del otro lado.
 */
import { hasWhatsapp, waMessages, whatsappUrl } from "../site";

interface Props {
  variant?: "compact" | "full";
  /** id único cuando se embeban varias en la misma página */
  id?: string;
}
const { variant = "compact", id = "calc" } = Astro.props;
const heading =
  variant === "compact"
    ? "Ponle número a lo que hoy se hace a mano."
    : "El costo real de lo que hoy se hace a mano.";
const eyebrow = variant === "compact" ? "La calculadora" : "Cálculo de 5 minutos";
const waHref = whatsappUrl(waMessages.diagnostico);
---

<section
  class={`calc calc--${variant}`}
  aria-labelledby={`${id}-title`}
  data-calc
  data-calc-variant={variant}
>
  <div class="calc__head">
    <p class="label eyebrow">{eyebrow}</p>
    <h2 id={`${id}-title`} class="h2 calc__title">{heading}</h2>
    {variant === "full" && (
      <p class="lead calc__lead">
        Cuatro preguntas. El número aparece de inmediato: no pedimos correo
        para enseñarlo.
      </p>
    )}
  </div>

  <form class="calc__form" data-calc-form novalidate>
    <div class="calc__field">
      <label class="small" for={`${id}-emp`}>
        ¿Cuánta gente trabaja en la empresa?
        <span class="calc__hint">Nómina completa, incluyendo piso.</span>
      </label>
      <input
        class="calc__num"
        type="text"
        id={`${id}-emp`}
        name="emp"
        inputmode="numeric"
        autocomplete="off"
        value="120"
      />
    </div>

    <div class="calc__field">
      <label class="small" for={`${id}-cap`}>
        ¿Cuántas personas teclean algo que ya venía escrito?
        <span class="calc__hint">Facturas en PDF, pedidos por WhatsApp, reportes en Excel.</span>
      </label>
      <input
        class="calc__num"
        type="text"
        id={`${id}-cap`}
        name="cap"
        inputmode="numeric"
        autocomplete="off"
        value="8"
      />
    </div>

    <div class="calc__field">
      <label class="small" id={`${id}-hrs-label`}>¿Cuántas horas al día, cada una?</label>
      <div
        class="calc__stepper"
        role="spinbutton"
        aria-labelledby={`${id}-hrs-label`}
        aria-valuemin="0.5"
        aria-valuemax="12"
        aria-valuenow="3"
        data-calc-hrs
      >
        <button class="calc__step" type="button" data-calc-hrs-down aria-label="Menos media hora">−</button>
        <div class="calc__step-val">
          <span data-calc-hrs-val>3</span>
          <em>horas</em>
        </div>
        <button class="calc__step" type="button" data-calc-hrs-up aria-label="Más media hora">+</button>
      </div>
    </div>

    <div class="calc__field">
      <label class="small" for={`${id}-sal`}>
        Sueldo bruto mensual promedio
        <span class="calc__hint">Sin prestaciones. Se usa para calcular la hora cargada.</span>
      </label>
      <div class="calc__money">
        <span class="calc__money-sign" aria-hidden="true">$</span>
        <input
          class="calc__num calc__num--money"
          type="text"
          id={`${id}-sal`}
          name="sal"
          inputmode="numeric"
          autocomplete="off"
          value="18,000"
        />
      </div>
    </div>

    <button class="btn btn--primary calc__go" type="submit" data-calc-go>
      Calcular
    </button>
  </form>

  <div class="calc__result" data-calc-result hidden>
    <div class="calc__figures">
      <div class="calc__fig calc__fig--money">
        <p class="calc__fig-label small">Se les va en teclear</p>
        <p class="calc__fig-num numeral" data-calc-money>$0</p>
        <p class="calc__fig-under small">
          <span data-calc-hours>0</span> horas al mes ·
          <span data-calc-costhr>$0</span> la hora cargada
        </p>
      </div>

      <div class="calc__fig calc__fig--gap">
        <p class="calc__fig-label small">
          El 1 de enero de 2027 la jornada baja a 46 horas. El sueldo no baja.
        </p>
        <p class="calc__fig-num numeral" data-calc-gap>0</p>
        <p class="calc__fig-under small">horas al año que dejas de tener</p>
      </div>
    </div>

    <p class="calc__verdict" data-calc-verdict></p>
    <p class="caption calc__horizon" data-calc-horizon></p>

    <p class="caption calc__honest">
      Esto es una estimación con supuestos generales. En el diagnóstico lo
      medimos con tus datos, y a veces el número baja.
    </p>

    {variant === "full" && (
      <p class="caption calc__assumptions">
        <strong>Supuestos:</strong> 21 días hábiles al mes, factor de carga
        social 1.35, jornada base de 48 horas semanales. Contexto de negocio,
        no asesoría legal.
      </p>
    )}

    <div class="calc__cta">
      <a class="btn btn--primary calc__cta-primary" href="/contacto" data-calc-schedule>
        Agendar 20 minutos
      </a>
      {hasWhatsapp && waHref && (
        <a class="btn btn--secondary" href={waHref} target="_blank" rel="noopener" data-calc-wa>
          Mandar el resultado por WhatsApp
        </a>
      )}
    </div>

    {variant === "compact" && (
      <p class="small calc__deeper">
        <a class="link link--arrow" href="/calculadora">
          Ver el cálculo completo hasta 2030
        </a>
      </p>
    )}
  </div>
</section>

<script>
  const mx = new Intl.NumberFormat("es-MX");
  const num = (v: number): string => mx.format(Math.round(v));
  const readNum = (el: HTMLInputElement | null): number => {
    if (!el) return 0;
    const v = parseFloat(String(el.value).replace(/[^0-9.]/g, ""));
    return Number.isFinite(v) && v > 0 ? v : 0;
  };

  interface Model {
    emp: number;
    hrs: number;
    hrsMonth: number;
    costHr: number;
    costYear: number;
    gap27: number;
    gap30: number;
    cover: number;
  }

  const roots = document.querySelectorAll<HTMLElement>("[data-calc]");
  roots.forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-calc-form]");
    const result = root.querySelector<HTMLElement>("[data-calc-result]");
    const emp = form?.querySelector<HTMLInputElement>('input[name="emp"]');
    const cap = form?.querySelector<HTMLInputElement>('input[name="cap"]');
    const sal = form?.querySelector<HTMLInputElement>('input[name="sal"]');
    const hrsVal = root.querySelector<HTMLElement>("[data-calc-hrs-val]");
    const hrsBox = root.querySelector<HTMLElement>("[data-calc-hrs]");
    const hrsUp = root.querySelector<HTMLButtonElement>("[data-calc-hrs-up]");
    const hrsDown = root.querySelector<HTMLButtonElement>("[data-calc-hrs-down]");
    if (!form || !result || !emp || !cap || !sal || !hrsVal || !hrsBox || !hrsUp || !hrsDown) return;

    let hrs = 3;
    const setHrs = (v: number): void => {
      hrs = Math.max(0.5, Math.min(12, Math.round(v * 2) / 2));
      hrsVal.textContent = String(hrs);
      hrsBox.setAttribute("aria-valuenow", String(hrs));
    };
    hrsUp.addEventListener("click", () => setHrs(hrs + 0.5));
    hrsDown.addEventListener("click", () => setHrs(hrs - 0.5));

    // Formato con separador de miles en el sueldo cuando el usuario sale del campo.
    sal.addEventListener("blur", () => {
      const v = readNum(sal);
      if (v > 0) sal.value = mx.format(v);
    });

    const model = (): Model => {
      const empN = Math.max(1, Math.round(readNum(emp)));
      let capN = Math.max(0, Math.round(readNum(cap)));
      if (capN > empN) capN = empN;
      const salN = readNum(sal);
      const costHr = (salN * 12 * 1.35) / (52 * 48);
      const hrsMonth = capN * hrs * 21;
      const hrsYear = hrsMonth * 12;
      const gap27 = empN * 2 * 52;
      const gap30 = empN * 8 * 52;
      return {
        emp: empN,
        hrs,
        hrsMonth,
        costHr,
        costYear: hrsYear * costHr,
        gap27,
        gap30,
        cover: gap27 > 0 ? (hrsYear / gap27) * 100 : 0,
      };
    };

    const money = root.querySelector<HTMLElement>("[data-calc-money]");
    const hoursEl = root.querySelector<HTMLElement>("[data-calc-hours]");
    const costHrEl = root.querySelector<HTMLElement>("[data-calc-costhr]");
    const gapEl = root.querySelector<HTMLElement>("[data-calc-gap]");
    const verdictEl = root.querySelector<HTMLElement>("[data-calc-verdict]");
    const horizonEl = root.querySelector<HTMLElement>("[data-calc-horizon]");
    const scheduleEl = root.querySelector<HTMLAnchorElement>("[data-calc-schedule]");
    const waEl = root.querySelector<HTMLAnchorElement>("[data-calc-wa]");

    const render = (m: Model): void => {
      if (money) money.textContent = "$" + num(m.costYear);
      if (hoursEl) hoursEl.textContent = num(m.hrsMonth);
      if (costHrEl) costHrEl.textContent = "$" + num(m.costHr);
      if (gapEl) gapEl.textContent = num(m.gap27);

      const pct = Math.round(m.cover);
      if (verdictEl) {
        verdictEl.innerHTML =
          pct >= 100
            ? "Recuperar esas horas cubre <strong>todo</strong> el golpe de enero, y sobra. Sin contratar a nadie."
            : "Recuperar esas horas cubre el <strong>" + pct + "%</strong> del golpe de enero. Sin contratar a nadie.";
      }
      if (horizonEl) {
        horizonEl.textContent = "Para 2030 la brecha llega a " + num(m.gap30) + " horas al año.";
      }

      // Handoff a /contacto con las cifras crudas: la página las lee y
      // prellena el mensaje del formulario.
      if (scheduleEl) {
        const params = new URLSearchParams({
          h: String(Math.round(m.hrsMonth)),
          d: String(Math.round(m.costYear)),
        });
        scheduleEl.href = "/contacto?" + params.toString();
      }
      if (waEl) {
        const base = waEl.href.split("?")[0];
        const message =
          "Hola Pragmasyn. Calculé " +
          num(m.hrsMonth) +
          " horas al mes y $" +
          num(m.costYear) +
          " al año. Quiero ver el desglose.";
        waEl.href = base + "?text=" + encodeURIComponent(message);
      }
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      render(model());
      result.hidden = false;
      // suave: si el resultado quedó fuera de vista, tráelo cerca sin brincos.
      if (result.getBoundingClientRect().top > window.innerHeight * 0.7) {
        result.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });
</script>

<style>
  .calc {
    display: grid;
    gap: var(--space-6);
  }
  .calc__head {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure-wide);
  }
  .calc__title {
    margin: 0;
  }
  .calc__lead {
    margin: 0;
  }

  .calc__form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5) var(--space-6);
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    background: var(--surface-card);
    border: var(--hairline) solid var(--surface-border);
    border-radius: var(--radius-xl);
  }
  @media (max-width: 44rem) {
    .calc__form {
      grid-template-columns: 1fr;
    }
  }

  .calc__field {
    display: grid;
    gap: var(--space-3);
  }
  .calc__field > label {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }
  .calc__hint {
    display: block;
    color: var(--fg-secondary);
    font-weight: var(--weight-text);
    margin-top: var(--space-1);
    font-size: 0.8125rem;
  }
  .calc__num {
    font: inherit;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-h4);
    font-weight: var(--weight-medium);
    color: var(--fg);
    background: var(--bg-raised);
    border: var(--hairline) solid var(--surface-border);
    border-radius: var(--radius-s);
    padding: var(--space-3) var(--space-4);
    min-height: 52px;
    width: 100%;
    transition: border-color var(--dur-2) var(--ease-swift),
      box-shadow var(--dur-2) var(--ease-swift);
  }
  .calc__num:hover {
    border-color: var(--surface-border-hover);
  }
  .calc__num:focus-visible {
    outline: none;
    border-color: var(--interactive);
    box-shadow: 0 0 0 var(--focus-width) var(--interactive);
  }
  .calc__money {
    position: relative;
    display: grid;
  }
  .calc__money-sign {
    position: absolute;
    inset-inline-start: var(--space-4);
    inset-block-start: 50%;
    translate: 0 -50%;
    color: var(--fg-secondary);
    font-size: var(--text-h4);
    font-weight: var(--weight-medium);
    pointer-events: none;
  }
  .calc__num--money {
    padding-inline-start: var(--space-8);
  }

  .calc__stepper {
    display: grid;
    grid-template-columns: 3.25rem 1fr 3.25rem;
    gap: var(--space-2);
  }
  .calc__step {
    font: inherit;
    font-size: var(--text-h3);
    font-weight: var(--weight-text);
    color: var(--fg);
    background: var(--bg-raised);
    border: var(--hairline) solid var(--surface-border);
    border-radius: var(--radius-s);
    min-height: 52px;
    cursor: pointer;
    transition: background-color var(--dur-1) var(--ease-swift),
      border-color var(--dur-1) var(--ease-swift);
  }
  .calc__step:hover {
    background: var(--surface-card-hover);
    border-color: var(--surface-border-hover);
  }
  .calc__step:active {
    background: var(--bg-sunken);
  }
  .calc__step-val {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-2);
    background: var(--bg-raised);
    border: var(--hairline) solid var(--surface-border);
    border-radius: var(--radius-s);
    padding-inline: var(--space-4);
    min-height: 52px;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-h4);
    font-weight: var(--weight-medium);
    color: var(--fg);
  }
  .calc__step-val em {
    font-style: normal;
    font-size: var(--text-small);
    font-weight: var(--weight-text);
    color: var(--fg-secondary);
  }

  .calc__go {
    grid-column: 1 / -1;
    width: 100%;
  }
  @media (min-width: 44rem) {
    .calc__go {
      justify-self: start;
      width: auto;
      padding-inline: var(--space-7);
    }
  }

  /* ---- result ---- */
  .calc__result {
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    background: var(--bg-raised);
    border: var(--hairline) solid var(--surface-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-2);
    display: grid;
    gap: var(--space-5);
  }
  .calc__figures {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5) var(--space-8);
    padding-bottom: var(--space-5);
    border-bottom: var(--hairline) solid var(--hairline-color);
  }
  @media (max-width: 44rem) {
    .calc__figures {
      grid-template-columns: 1fr;
    }
  }
  .calc__fig {
    display: grid;
    gap: var(--space-2);
  }
  .calc__fig-label {
    color: var(--fg-secondary);
    max-width: 22rem;
  }
  .calc__fig-num {
    font-size: clamp(2rem, 6vw, 3.25rem);
    line-height: 1;
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .calc__fig--money .calc__fig-num {
    color: var(--interactive);
  }
  .calc__fig--gap .calc__fig-num {
    color: var(--reserve);
  }
  .calc__fig-under {
    color: var(--fg-secondary);
    font-variant-numeric: tabular-nums;
  }

  .calc__verdict {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    color: var(--fg);
    padding: var(--space-4) var(--space-5);
    border-inline-start: var(--hairline-strong) solid var(--interactive);
    background: var(--surface-card);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
  }
  .calc__horizon {
    color: var(--fg-secondary);
  }
  .calc__honest {
    color: var(--fg-secondary);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--hairline-color);
  }
  .calc__assumptions {
    color: var(--fg-muted-ui);
  }
  .calc__assumptions strong {
    color: var(--fg-secondary);
  }
  .calc__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--hairline-color);
  }
  .calc__deeper {
    padding-top: var(--space-3);
    border-top: var(--hairline) solid var(--hairline-color);
  }
</style>
