---
/**
 * Demo — el corazón del sitio v3.
 *
 * Reproduce dos casos: (1) la factura que se captura sola con tres orígenes
 * seleccionables y (2) la factura que no cuadra con la orden de compra. Todo
 * en JS mínimo y CSS puro: sin video, sin canvas, sin llamadas a un modelo.
 *
 * Regla de honestidad (BRIEF v3 §6): están etiquetados como "Ejemplos
 * precargados" y la comparación de tiempos es referencial, no la duración
 * real de la animación.
 *
 * El componente se hidrata cuando entra al viewport para no comprometer el
 * LCP del hero.
 */
---

<section class="demo" id="demo" aria-labelledby="demo-title" data-demo>
  <div class="demo__head">
    <p class="label eyebrow">La demo</p>
    <h2 id="demo-title" class="h2 demo__title">
      Es más fácil verlo funcionando que explicarlo.
    </h2>
    <p class="lead demo__lead">
      Elige la forma en que llega el documento y lo que hoy captura una
      persona aparece del otro lado, estructurado y listo para entrar al
      sistema.
    </p>
  </div>

  <div class="demo__tabs" role="tablist" aria-label="Casos de la demo">
    <button
      class="demo__tab is-active"
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="demo-case-1"
      id="demo-tab-1"
      data-demo-tab="1"
    >
      <span class="demo__tab-num">01</span>
      <span class="demo__tab-name">La factura que se captura sola</span>
    </button>
    <button
      class="demo__tab"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="demo-case-2"
      id="demo-tab-2"
      data-demo-tab="2"
    >
      <span class="demo__tab-num">02</span>
      <span class="demo__tab-name">La factura que no cuadra</span>
    </button>
  </div>

  <!-- CASO 1 -->
  <article
    class="demo__case card card--feature is-active"
    id="demo-case-1"
    role="tabpanel"
    aria-labelledby="demo-tab-1"
    data-demo-case="1"
  >
    <header class="demo__case-head">
      <p class="caption demo__badge">Ejemplos precargados</p>
      <div class="demo__sources" role="tablist" aria-label="Origen del documento">
        <button
          class="demo__source is-active"
          type="button"
          role="tab"
          aria-selected="true"
          data-demo-source="pdf"
        >PDF limpio</button>
        <button
          class="demo__source"
          type="button"
          role="tab"
          aria-selected="false"
          data-demo-source="mail"
        >Correo con adjunto</button>
        <button
          class="demo__source"
          type="button"
          role="tab"
          aria-selected="false"
          data-demo-source="photo"
        >Foto de celular</button>
      </div>
    </header>

    <div class="demo__stage">
      <div class="demo__before" data-demo-before>
        <!-- Ventana etiqueta común -->
        <p class="demo__before-label caption">Como llega</p>

        <!-- PDF LIMPIO -->
        <figure class="doc doc--pdf" data-demo-doc="pdf" aria-label="Factura PDF de proveedor">
          <div class="doc__frame">
            <div class="doc__header">
              <div class="doc__brand">
                <span class="doc__mark">MPX</span>
                <span class="doc__title">Materiales Progreso S.A. de C.V.</span>
              </div>
              <p class="doc__meta">Factura A-14237 · 08/10/2026</p>
            </div>
            <dl class="doc__grid">
              <div><dt>RFC</dt><dd>MPR930215AB4</dd></div>
              <div><dt>Cliente</dt><dd>El comprador</dd></div>
              <div><dt>Método</dt><dd>Transferencia</dd></div>
              <div><dt>Uso CFDI</dt><dd>G03</dd></div>
            </dl>
            <table class="doc__table" aria-hidden="true">
              <tbody>
                <tr><td>1</td><td>Lámina galvanizada calibre 22</td><td>120</td><td>$184.50</td><td>$22,140.00</td></tr>
                <tr><td>2</td><td>Tornillo cabeza plana 3/8"</td><td>500</td><td>$3.20</td><td>$1,600.00</td></tr>
                <tr><td>3</td><td>Perfil PTR 2" cal 14</td><td>40</td><td>$58.50</td><td>$2,340.00</td></tr>
                <tr><td>4</td><td>Flete y maniobra</td><td>1</td><td>$1,850.00</td><td>$1,850.00</td></tr>
              </tbody>
            </table>
            <div class="doc__totals">
              <p><span>Subtotal</span><span>$27,930.00</span></p>
              <p><span>IVA 16%</span><span>$4,468.80</span></p>
              <p class="doc__grand"><span>Total</span><span>$32,398.80</span></p>
            </div>
          </div>
        </figure>

        <!-- CORREO CON ADJUNTO -->
        <figure class="doc doc--mail" data-demo-doc="mail" hidden aria-label="Correo con factura adjunta">
          <div class="doc__frame doc__frame--mail">
            <div class="mail__bar">
              <span class="mail__dot" aria-hidden="true"></span>
              <span class="mail__dot" aria-hidden="true"></span>
              <span class="mail__dot" aria-hidden="true"></span>
            </div>
            <header class="mail__head">
              <p class="mail__from"><strong>Cobranza · Materiales Progreso</strong> &lt;cobranza@matprogreso.mx&gt;</p>
              <p class="mail__meta">para: cuentas@el-comprador.mx · Ayer 4:12&nbsp;p.m.</p>
              <p class="mail__subject">Factura A-14237 — orden OC-4402</p>
            </header>
            <div class="mail__body">
              <p>Buenas tardes,</p>
              <p>Anexo la factura correspondiente a la entrega del jueves. Cualquier duda quedo pendiente.</p>
              <p>Saludos.</p>
            </div>
            <aside class="mail__attach">
              <span class="mail__attach-icon" aria-hidden="true">PDF</span>
              <span class="mail__attach-name">factura-A-14237.pdf</span>
              <span class="mail__attach-size">184&nbsp;KB</span>
            </aside>
          </div>
        </figure>

        <!-- FOTO DE PAPEL ARRUGADO -->
        <figure class="doc doc--photo" data-demo-doc="photo" hidden aria-label="Foto de la factura en papel">
          <div class="doc__frame doc__frame--photo">
            <div class="photo__paper">
              <div class="photo__paper-inner">
                <p class="photo__brand">MATERIALES PROGRESO</p>
                <p class="photo__meta">Factura A-14237 &middot; 08 OCT 2026</p>
                <ul class="photo__lines">
                  <li><span>Lámina galv. cal 22</span><span>120</span><span>184.50</span><span>22,140.00</span></li>
                  <li><span>Tornillo 3/8"</span><span>500</span><span>3.20</span><span>1,600.00</span></li>
                  <li><span>PTR 2" cal 14</span><span>40</span><span>58.50</span><span>2,340.00</span></li>
                  <li><span>Flete</span><span>1</span><span>1,850.00</span><span>1,850.00</span></li>
                </ul>
                <p class="photo__total">TOTAL&nbsp;&nbsp;$32,398.80</p>
              </div>
            </div>
          </div>
        </figure>
      </div>

      <div class="demo__arrow" aria-hidden="true">
        <span class="demo__arrow-line"></span>
        <span class="demo__arrow-head">→</span>
      </div>

      <div class="demo__after" data-demo-after>
        <p class="demo__before-label caption">Cómo entra a tu sistema</p>
        <dl class="extract" data-demo-extract>
          <div class="extract__row" data-demo-field="0"><dt>Proveedor</dt><dd>Materiales Progreso S.A. de C.V.</dd></div>
          <div class="extract__row" data-demo-field="1"><dt>RFC</dt><dd>MPR930215AB4</dd></div>
          <div class="extract__row" data-demo-field="2"><dt>Folio</dt><dd>A-14237</dd></div>
          <div class="extract__row" data-demo-field="3"><dt>Fecha</dt><dd>2026-10-08</dd></div>
          <div class="extract__row" data-demo-field="4"><dt>Subtotal</dt><dd>$27,930.00</dd></div>
          <div class="extract__row" data-demo-field="5"><dt>IVA</dt><dd>$4,468.80</dd></div>
          <div class="extract__row" data-demo-field="6"><dt>Total</dt><dd>$32,398.80</dd></div>
          <div class="extract__row" data-demo-field="7"><dt>Partidas</dt><dd>4 conceptos, ver detalle</dd></div>
        </dl>

        <div class="demo__ledger" data-demo-ledger hidden>
          <p class="caption demo__ledger-line">
            <span>Una persona</span>
            <span class="demo__ledger-val">4&nbsp;min 12&nbsp;s</span>
          </p>
          <p class="caption demo__ledger-line demo__ledger-line--us">
            <span>La IA</span>
            <span class="demo__ledger-val demo__ledger-val--us">0.9&nbsp;s</span>
          </p>
        </div>
      </div>
    </div>

    <footer class="demo__controls">
      <button
        class="btn btn--primary btn--sm demo__play"
        type="button"
        data-demo-play
      >Ver cómo lo captura</button>
      <p class="caption demo__disclaimer">
        Datos de ejemplo. En tu implementación, nada sale de tu entorno.
      </p>
    </footer>
  </article>

  <!-- CASO 2 -->
  <article
    class="demo__case card card--feature"
    id="demo-case-2"
    role="tabpanel"
    aria-labelledby="demo-tab-2"
    data-demo-case="2"
    hidden
  >
    <header class="demo__case-head">
      <p class="caption demo__badge">Ejemplos precargados</p>
      <p class="small demo__case-hint">
        Misma factura, misma extracción. La diferencia empieza cuando compara
        contra la orden de compra.
      </p>
    </header>

    <div class="demo__stage">
      <div class="demo__before">
        <p class="demo__before-label caption">Como llegan las dos piezas</p>
        <div class="pair">
          <figure class="pair__doc">
            <figcaption>Orden de compra <span>OC-4402</span></figcaption>
            <table class="pair__table" aria-label="Orden de compra">
              <tbody>
                <tr><td>1</td><td>Lámina galv. cal 22</td><td>120</td><td>$184.50</td></tr>
                <tr><td>2</td><td>Tornillo 3/8"</td><td>500</td><td>$3.20</td></tr>
                <tr class="pair__row-flag"><td>3</td><td>PTR 2" cal 14</td><td>40</td><td>$58.50</td></tr>
                <tr><td>4</td><td>Flete</td><td>1</td><td>$1,850.00</td></tr>
              </tbody>
            </table>
          </figure>
          <figure class="pair__doc">
            <figcaption>Factura recibida <span>A-14237</span></figcaption>
            <table class="pair__table" aria-label="Factura recibida">
              <tbody>
                <tr><td>1</td><td>Lámina galv. cal 22</td><td>120</td><td>$184.50</td></tr>
                <tr><td>2</td><td>Tornillo 3/8"</td><td>500</td><td>$3.20</td></tr>
                <tr class="pair__row-flag pair__row-flag--wrong"><td>3</td><td>PTR 2" cal 14</td><td>40</td><td>$117.00</td></tr>
                <tr><td>4</td><td>Flete</td><td>1</td><td>$1,850.00</td></tr>
              </tbody>
            </table>
          </figure>
        </div>
      </div>

      <div class="demo__arrow" aria-hidden="true">
        <span class="demo__arrow-line"></span>
        <span class="demo__arrow-head">→</span>
      </div>

      <div class="demo__after">
        <p class="demo__before-label caption">Lo que la IA hace con las dos piezas</p>
        <ol class="steps" data-demo-steps>
          <li class="steps__item" data-demo-step="0">
            <span class="steps__mark" aria-hidden="true"></span>
            <span>Extrae los datos de la factura</span>
          </li>
          <li class="steps__item" data-demo-step="1">
            <span class="steps__mark" aria-hidden="true"></span>
            <span>Encuentra la orden de compra OC-4402</span>
          </li>
          <li class="steps__item" data-demo-step="2">
            <span class="steps__mark" aria-hidden="true"></span>
            <span>Compara partida por partida</span>
          </li>
          <li class="steps__item" data-demo-step="3">
            <span class="steps__mark" aria-hidden="true"></span>
            <span>Detecta la diferencia y detiene el pago</span>
          </li>
        </ol>

        <aside class="alert" role="status" data-demo-alert hidden>
          <p class="alert__head">
            <span class="alert__icon" aria-hidden="true">!</span>
            Esta factura no coincide con la orden de compra
          </p>
          <p class="alert__body">
            Partida 3: se ordenaron <strong>40 piezas a $58.50</strong>. La factura
            trae <strong>40 piezas a $117.00</strong>.
          </p>
          <p class="alert__diff">
            Diferencia: <span class="alert__diff-num">$2,340.00</span>
          </p>
          <p class="alert__note small">
            Aquí no está leyendo. Está comparando contra tu orden de compra y
            decidiendo que algo no cuadra. Eso es lo que hoy hace una persona
            revisando dos pantallas.
          </p>
        </aside>
      </div>
    </div>

    <footer class="demo__controls">
      <button
        class="btn btn--primary btn--sm demo__play"
        type="button"
        data-demo-play
      >Ver el cotejo</button>
      <p class="caption demo__disclaimer">
        Datos de ejemplo. En tu implementación, nada sale de tu entorno.
      </p>
    </footer>
  </article>
</section>

<script>
  // Hidratación tardía: la demo no cuenta para el LCP, solo se prepara
  // cuando el usuario está por verla.
  const roots = document.querySelectorAll<HTMLElement>("[data-demo]");
  if (roots.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const init = (root: HTMLElement): void => {
      // --- Tabs entre caso 1 y caso 2 ---
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-demo-tab]"));
      const cases = Array.from(root.querySelectorAll<HTMLElement>("[data-demo-case]"));

      const showCase = (id: string): void => {
        for (const t of tabs) {
          const on = t.dataset.demoTab === id;
          t.classList.toggle("is-active", on);
          t.setAttribute("aria-selected", String(on));
        }
        for (const c of cases) {
          const on = c.dataset.demoCase === id;
          c.classList.toggle("is-active", on);
          c.hidden = !on;
        }
      };
      tabs.forEach((t) => t.addEventListener("click", () => showCase(t.dataset.demoTab ?? "1")));

      // --- Selector de origen dentro del caso 1 ---
      const sourceButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-demo-source]"),
      );
      const docs = Array.from(root.querySelectorAll<HTMLElement>("[data-demo-doc]"));
      const showSource = (key: string): void => {
        for (const b of sourceButtons) {
          const on = b.dataset.demoSource === key;
          b.classList.toggle("is-active", on);
          b.setAttribute("aria-selected", String(on));
        }
        for (const d of docs) {
          d.hidden = d.dataset.demoDoc !== key;
        }
      };
      sourceButtons.forEach((b) =>
        b.addEventListener("click", () => showSource(b.dataset.demoSource ?? "pdf")),
      );

      // --- Estado de reproducción por caso ---
      cases.forEach((c) => {
        const play = c.querySelector<HTMLButtonElement>("[data-demo-play]");
        if (!play) return;
        const fields = Array.from(c.querySelectorAll<HTMLElement>("[data-demo-field]"));
        const steps = Array.from(c.querySelectorAll<HTMLElement>("[data-demo-step]"));
        const ledger = c.querySelector<HTMLElement>("[data-demo-ledger]");
        const alertEl = c.querySelector<HTMLElement>("[data-demo-alert]");
        const initialLabel =
          c.dataset.demoCase === "2" ? "Ver el cotejo" : "Ver cómo lo captura";

        let timers: number[] = [];
        const clearTimers = (): void => {
          timers.forEach((id) => window.clearTimeout(id));
          timers = [];
        };
        const at = (ms: number, fn: () => void): void => {
          timers.push(window.setTimeout(fn, ms));
        };

        const reset = (): void => {
          clearTimers();
          fields.forEach((f) => f.classList.remove("is-in"));
          steps.forEach((s) => s.classList.remove("is-in", "is-warn"));
          if (ledger) ledger.hidden = true;
          if (alertEl) alertEl.hidden = true;
          play.textContent = initialLabel;
          play.classList.remove("is-done", "btn--loading");
          play.disabled = false;
        };

        const finish = (): void => {
          if (ledger) ledger.hidden = false;
          if (alertEl) alertEl.hidden = false;
          play.classList.remove("btn--loading");
          play.classList.add("is-done");
          play.disabled = false;
          play.textContent = "Reiniciar";
        };

        const run = (): void => {
          reset();
          play.disabled = true;
          play.classList.add("btn--loading");

          if (reduced) {
            fields.forEach((f) => f.classList.add("is-in"));
            steps.forEach((s, i) => {
              s.classList.add("is-in");
              if (i === steps.length - 1) s.classList.add("is-warn");
            });
            finish();
            return;
          }

          fields.forEach((f, i) => at(220 + i * 260, () => f.classList.add("is-in")));
          steps.forEach((s, i) =>
            at(360 + i * 520, () => {
              s.classList.add("is-in");
              if (i === steps.length - 1) s.classList.add("is-warn");
            }),
          );

          const total = Math.max(
            fields.length * 260 + 320,
            steps.length * 520 + 520,
          );
          at(total + 120, finish);
        };

        // Un solo handler: si ya terminó, reinicia sin volver a arrancar;
        // si está en vuelo, corta; si está en reposo, arranca.
        play.addEventListener("click", () => {
          if (play.classList.contains("is-done")) {
            reset();
            return;
          }
          if (play.classList.contains("btn--loading")) {
            reset();
            return;
          }
          run();
        });
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          init(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -8% 0px" },
    );
    roots.forEach((r) => observer.observe(r));
  }
</script>

<style>
  /* ---- shell ---- */
  .demo {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--margin);
    padding-block: clamp(var(--space-8), 9vw, var(--space-10));
    display: grid;
    gap: var(--space-7);
  }
  .demo__head {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-wide);
  }
  .demo__title {
    margin: 0;
  }
  .demo__lead {
    margin: 0;
  }

  /* ---- tabs ---- */
  .demo__tabs {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-bottom: var(--space-4);
    border-bottom: var(--hairline) solid var(--hairline-color);
  }
  .demo__tab {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    background: transparent;
    color: var(--fg-secondary);
    border: 0;
    border-radius: var(--radius-m);
    padding: var(--space-3) var(--space-4);
    font: inherit;
    font-size: var(--text-small);
    cursor: pointer;
    transition: background-color var(--dur-1) var(--ease-swift),
      color var(--dur-1) var(--ease-swift);
  }
  .demo__tab:hover {
    color: var(--fg);
    background: var(--surface-card);
  }
  .demo__tab.is-active {
    color: var(--fg);
    background: var(--surface-card);
  }
  .demo__tab-num {
    color: var(--interactive);
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caption);
  }
  .demo__tab-name {
    font-weight: var(--weight-medium);
  }

  /* ---- case shell ---- */
  .demo__case {
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    display: grid;
    gap: var(--space-6);
  }
  .demo__case[hidden] {
    display: none !important;
  }
  .demo__case-head {
    display: grid;
    gap: var(--space-4);
  }
  .demo__badge {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border: var(--hairline) solid var(--surface-border);
    border-radius: var(--radius-pill);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    font-size: 0.6875rem;
    color: var(--fg-secondary);
  }
  .demo__sources {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: var(--space-1);
    background: var(--bg-sunken);
    border-radius: var(--radius-pill);
    justify-self: start;
  }
  .demo__source {
    font: inherit;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--fg-secondary);
    background: transparent;
    border: 0;
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    min-height: 36px;
    transition: background-color var(--dur-1) var(--ease-swift),
      color var(--dur-1) var(--ease-swift);
  }
  .demo__source:hover {
    color: var(--fg);
  }
  .demo__source.is-active {
    background: var(--surface-card);
    color: var(--fg);
    box-shadow: var(--shadow-1);
  }
  .demo__case-hint {
    color: var(--fg-secondary);
    max-width: var(--measure);
  }

  /* ---- stage ---- */
  .demo__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: var(--space-5);
  }
  @media (max-width: 60rem) {
    .demo__stage {
      grid-template-columns: minmax(0, 1fr);
    }
    .demo__arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
  .demo__before,
  .demo__after {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .demo__before-label {
    color: var(--fg-muted-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-size: 0.6875rem;
  }
  .demo__arrow {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--interactive);
  }
  .demo__arrow-line {
    display: block;
    width: var(--space-6);
    height: var(--hairline-strong);
    background: currentColor;
    border-radius: var(--radius-pill);
    opacity: 0.4;
  }
  .demo__arrow-head {
    font-size: var(--text-h4);
    line-height: 1;
  }

  /* ---- doc: shared frame ---- */
  .doc {
    margin: 0;
  }
