---
/**
 * Lo que construimos, mostrado en vez de descrito. Cada mosaico trae una pieza
 * que se mueve sola mientras está a la vista: los módulos se apagan, la corrida
 * avanza, el dato viaja, el portal cambia de pestaña, las cifras se dibujan y
 * las tareas llegan al teléfono. Todo es decorativo: el texto es el contenido y
 * las piezas se ocultan a los lectores de pantalla. Sin movimiento cada pieza
 * queda en su estado final, completa y legible.
 */
import logoSvg from "../../branding/logo/logo.svg?raw";

interface Tile {
  art: "saas" | "steps" | "flow" | "portal" | "chart" | "phone";
  title: string;
  text: string;
  wide?: boolean;
}

const tiles: Tile[] = [
  {
    art: "saas",
    title: "Reemplazar un SaaS que te sale caro",
    text: "Nos dices qué usas de verdad y construimos eso. Sin las funciones que pagas y nunca abres.",
  },
  {
    art: "steps",
    title: "Automatizar lo que se repite",
    text: "Lo que alguien hace igual cada semana lo puede hacer el sistema.",
    wide: true,
  },
  {
    art: "flow",
    title: "Conectar lo que no se habla",
    text: "Tu Excel, tu banco, WhatsApp y tus sistemas, con el mismo dato.",
    wide: true,
  },
  {
    art: "portal",
    title: "Darles a tus clientes su propio portal",
    text: "Pedidos, citas y estados de cuenta, sin que tengan que llamarte.",
  },
  {
    art: "chart",
    title: "Ver tu negocio en una pantalla",
    text: "Las cifras que te importan, al día, sin armar reportes.",
    wide: true,
  },
  {
    art: "phone",
    title: "Una app para tu equipo",
    text: "Para el piso, la ruta o la sucursal. Hecha para como trabajan.",
  },
];

const modules: [string, boolean][] = [
  ["Pedidos", true],
  ["Campañas", false],
  ["Encuestas", false],
  ["Facturas", true],
  ["Insignias", false],
  ["Foros", false],
];
const steps = ["Llega", "Se captura", "Se factura", "Se avisa"];
const sources = ["Excel", "Banco", "WhatsApp"];
const portal: { tab: string; rows: [string, string][] }[] = [
  {
    tab: "Pedidos",
    rows: [
      ["Pedido 5214", "En ruta"],
      ["Pedido 5215", "Cargando"],
      ["Pedido 5213", "Entregado"],
    ],
  },
  {
    tab: "Citas",
    rows: [
      ["10:30", "Confirmada"],
      ["11:00", "Por confirmar"],
      ["11:30", "Confirmada"],
    ],
  },
  {
    tab: "Estados de cuenta",
    rows: [
      ["Agosto", "Pagado"],
      ["Septiembre", "Pagado"],
      ["Octubre", "Por pagar"],
    ],
  },
];
const figures = ["Ventas", "Cobranza", "Inventario"];
const bars = [62, 88, 74, 104, 92, 126, 110, 142, 134, 168];
const tasks = ["Surtir", "Cargar", "Entregar"];
const fieldNotes: [string, string][] = [
  ["Piso", "Surtido"],
  ["Ruta Norte", "Entregado"],
  ["Sucursal", "Al día"],
];
---

<ul class="tiles" data-tiles>
  {
    tiles.map((t) => (
      <li class:list={["tile", { "tile--wide": t.wide }]}>
        <div class="tile__art" aria-hidden="true">
          {t.art === "saas" && (
            <div class="art-saas">
              {modules.map(([name, kept], i) => (
                <span class:list={["art-saas__row", { "is-kept": kept }]} style={`--i: ${i};`}>
                  <b>{name}</b>
                  <i class="art-saas__switch" />
                </span>
              ))}
            </div>
          )}

          {t.art === "steps" && (
            <div class="art-steps">
              <span class="art-steps__rail">
                <i class="art-steps__fill" />
              </span>
              {steps.map((name, i) => (
                <span class="art-steps__step" style={`--i: ${i};`}>
                  <i class="art-steps__dot" />
                  <b>{name}</b>
                </span>
              ))}
              <p class="art-steps__done ground-light">Listo. Nadie lo tecleó.</p>
            </div>
          )}

          {t.art === "flow" && (
            <div class="art-flow">
              <div class="art-flow__side">
                {sources.map((name, i) => (
                  <span class="art-flow__node" style={`--i: ${i};`}>
                    <b>
                      <i class="art-flow__led" />
                      {name}
                    </b>
                    <small>Pedido 5214</small>
                  </span>
                ))}
              </div>
              <svg
                class="art-flow__wires"
                viewBox="0 0 160 192"
                preserveAspectRatio="none"
                fill="none"
              >
                <defs>
                  <linearGradient
                    id="flow-pulse"
                    gradientUnits="userSpaceOnUse"
                    x1="0"
                    y1="0"
                    x2="160"
                    y2="0"
                  >
                    <stop offset="0" stop-color="#5B19F1" />
                    <stop offset="1" stop-color="#00C7F8" />
                  </linearGradient>
                </defs>
                {[32, 96, 160].map((y, i) => (
                  <g>
                    <path class="art-flow__wire" d={`M0 ${y} C 90 ${y}, 70 96, 160 96`} />
                    <path
                      class="art-flow__pulse"
                      pathLength="1"
                      style={`--i: ${i};`}
                      d={`M0 ${y} C 90 ${y}, 70 96, 160 96`}
                    />
                  </g>
                ))}
              </svg>
              <span class="art-flow__hub" set:html={logoSvg} />
              <svg
                class="art-flow__wires"
                viewBox="0 0 160 192"
                preserveAspectRatio="none"
                fill="none"
              >
                <path class="art-flow__wire" d="M0 96 H160" />
                <path class="art-flow__pulse" pathLength="1" style="--i: 3;" d="M0 96 H160" />
              </svg>
              <span class="art-flow__node art-flow__node--out" style="--i: 3;">
                <b>
                  <i class="art-flow__led" />
                  Tus sistemas
                </b>
                <small>Pedido 5214</small>
              </span>
            </div>
          )}

          {t.art === "portal" && (
            <div class="art-portal">
              <span class="art-portal__tabs">
                {portal.map(({ tab }) => (
                  <b>{tab}</b>
                ))}
                <i class="art-portal__ink" />
              </span>
              <span class="art-portal__panes">
                {portal.map(({ rows }, i) => (
                  <span class="art-portal__pane" style={`--i: ${i};`}>
                    {rows.map(([name, status], row) => (
                      <span class="art-portal__row" style={`--r: ${row};`}>
                        <b>{name}</b>
                        <small class:list={{ "is-done": row === 0 }}>{status}</small>
                      </span>
                    ))}
                  </span>
                ))}
              </span>
            </div>
          )}

          {t.art === "chart" && (
            <div class="art-chart">
              <ul class="art-chart__figures">
                {figures.map((name, i) => (
                  <li style={`--i: ${i};`}>
                    <b>{name}</b>
                    <i class="art-chart__meter">
                      <i />
                    </i>
                  </li>
                ))}
              </ul>
              <div class="art-chart__plot">
                <svg viewBox="0 0 640 220" fill="none">
                  <defs>
                    <linearGradient
                      id="chart-line"
                      gradientUnits="userSpaceOnUse"
                      x1="0"
                      y1="0"
                      x2="640"
                      y2="0"
                    >
                      <stop offset="0" stop-color="#5B19F1" />
                      <stop offset="0.6" stop-color="#1B7FFC" />
                      <stop offset="1" stop-color="#00C7F8" />
                    </linearGradient>
                    <linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#1B7FFC" stop-opacity="0.32" />
                      <stop offset="1" stop-color="#1B7FFC" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  {[55, 110, 165].map((y) => (
                    <path class="art-chart__grid" d={`M0 ${y} H640`} />
                  ))}
                  {bars.map((height, i) => (
                    <rect
                      class="art-chart__bar"
                      style={`--i: ${i};`}
                      x={14 + i * 63}
                      y={220 - height}
                      width="38"
                      height={height}
                      rx="6"
                    />
                  ))}
                  <path
                    class="art-chart__area"
                    d="M0 170 C 60 162, 90 138, 150 142 S 250 170, 310 128 S 420 104, 480 92 S 590 56, 640 34 V220 H0 Z"
                    fill="url(#chart-fill)"
                  />
                  <path
                    class="art-chart__line"
                    pathLength="1"
                    d="M0 170 C 60 162, 90 138, 150 142 S 250 170, 310 128 S 420 104, 480 92 S 590 56, 640 34"
                  />
                  <circle class="art-chart__dot" r="7" />
                </svg>
                <span class="art-chart__today">Hoy</span>
              </div>
            </div>
          )}

          {t.art === "phone" && (
            <div class="art-phone">
              <div class="art-phone__body">
                <span class="art-phone__notch" />
                <b class="art-phone__title">Hoy</b>
                {tasks.map((task, i) => (
                  <span class="art-phone__task" style={`--i: ${i};`}>
                    <i />
                    {task}
                  </span>
                ))}
              </div>
              {fieldNotes.map(([place, status], i) => (
                <span class:list={["art-phone__note ground-light", `art-phone__note--${i}`]}>
                  <b>{place}</b>
                  {status}
                </span>
              ))}
            </div>
          )}
        </div>
        <h3 class="h3 tile__title">{t.title}</h3>
        <p class="tile__text">{t.text}</p>
      </li>
    ))
  }
</ul>

<script>
  const tiles = document.querySelector<HTMLElement>("[data-tiles]");
  if (tiles) {
    // Nothing loops off screen: each piece runs only while someone can see it.
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        entry.target.classList.toggle("is-live", entry.isIntersecting);
      }
    });
    tiles.querySelectorAll(".tile").forEach((tile) => observer.observe(tile));

    // The light on a tile follows the pointer.
    if (window.matchMedia("(hover: hover)").matches) {
      tiles.addEventListener("pointermove", (event) => {
        const tile = (event.target as HTMLElement).closest<HTMLElement>(".tile");
        if (!tile) return;
        const box = tile.getBoundingClientRect();
        tile.style.setProperty("--x", `${event.clientX - box.left}px`);
        tile.style.setProperty("--y", `${event.clientY - box.top}px`);
      });
    }
  }
</script>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 27rem;
    padding: var(--space-5);
    background: var(--bg-chrome);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-key);
    overflow: hidden;
    isolation: isolate;
    transition: box-shadow var(--dur-3) var(--ease-out);
  }
  .tile--wide {
    grid-column: span 2;
  }
  .tile::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      24rem circle at var(--x, 50%) var(--y, 0%),
      rgb(var(--rgb-blue) / 0.16),
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  /* the border lights up under the pointer, like a flashlight along the edge */
  .tile::after {
    content: "";
    position: absolute;
    inset: 0;
    padding: var(--hairline);
    border-radius: inherit;
    background: radial-gradient(
      18rem circle at var(--x, 50%) var(--y, 0%),
      rgb(var(--rgb-blue)),
      transparent 70%
    );
    -webkit-mask:
      linear-gradient(black 0 0) content-box,
      linear-gradient(black 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  @media (hover: hover) {
    .tile:hover::before,
    .tile:hover::after {
      opacity: 1;
    }
  }
  .tile__art {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 15rem;
    margin-block-end: var(--space-5);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
  }
  .tile__art b {
    font-weight: var(--weight-medium);
  }
  .tile__title {
    font-weight: var(--weight-medium);
  }
  .tile__text {
    margin-block-start: var(--space-1);
    color: var(--fg-secondary);
    max-width: 44ch;
    text-wrap: pretty;
  }
  @media (width <= 56rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile--wide {
      grid-column: span 2;
    }
  }
  @media (width <= 40rem) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
    .tile--wide {
      grid-column: auto;
    }
    .tile {
      min-height: 0;
      padding: var(--space-4);
    }
  }

  /* The pieces only run in view, and never when motion is unwelcome. */
  .tile:not(.is-live) *,
  .tile:not(.is-live) *::after {
    animation-play-state: paused !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .tiles *,
    .tiles *::after {
      animation: none !important;
    }
  }

  /* --- Un SaaS: se apaga lo que nunca abres y lo tuyo se queda ------------- */
  .art-saas {
    --period: 9s;
    /* fixed height: the rows collapse inside, the page never moves */
    display: grid;
    align-content: center;
    width: min(17rem, 100%);
    height: 16.5rem;
    padding: var(--space-3);
    border-radius: var(--radius-l);
    background: var(--night-800);
    box-shadow: var(--shadow-key);
  }
  .art-saas__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2.25rem;
    margin-block-end: var(--space-1);
    padding-inline: var(--space-3);
    border-radius: var(--radius-m);
    color: var(--fg-muted);
    overflow: hidden;
    animation: saas-row var(--period) var(--ease-in-out) infinite;
    animation-delay: calc(var(--i) * 180ms);
  }
  .art-saas__row:last-child {
    margin-block-end: 0;
  }
  .art-saas__row.is-kept {
    color: var(--fg);
    background: rgb(var(--rgb-blue) / 0.14);
    box-shadow: inset 0 0 0 1px rgb(var(--rgb-blue) / 0.5);
    animation: saas-kept var(--period) var(--ease-in-out) infinite;
  }
  .art-saas__switch {
    position: relative;
    display: block;
    flex: none;
    width: 1.75rem;
    height: 1rem;
    border-radius: var(--radius-pill);
    background: rgb(var(--rgb-light) / 0.14);
    animation: saas-switch var(--period) var(--ease-in-out) infinite;
    animation-delay: inherit;
  }
  .art-saas__switch::after {
    content: "";
    position: absolute;
    inset-block-start: 2px;
    inset-inline-start: 2px;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--mist-300);
    animation: saas-knob var(--period) var(--ease-in-out) infinite;
    animation-delay: inherit;
  }
  .is-kept .art-saas__switch {
    background: #1b7ffc;
    animation: none;
  }
  .is-kept .art-saas__switch::after {
    translate: 0.75rem 0;
    background: var(--white);
    animation: none;
  }
  @keyframes saas-row {
    0%,
    12% {
      height: 2.25rem;
      margin-block-end: var(--space-1);
      opacity: 1;
    }
    26%,
    36% {
      height: 2.25rem;
      margin-block-end: var(--space-1);
      opacity: 0.4;
    }
    46%,
    88% {
      height: 0;
      margin-block-end: 0;
      opacity: 0;
    }
    100% {
      height: 2.25rem;
      margin-block-end: var(--space-1);
      opacity: 1;
    }
  }
  @keyframes saas-kept {
    0%,
    40% {
      height: 2.25rem;
      box-shadow: inset 0 0 0 1px rgb(var(--rgb-blue) / 0.5);
    }
    52%,
    86% {
      height: 3.25rem;
      box-shadow:
        inset 0 0 0 1px rgb(var(--rgb-blue)),
        0 0 28px rgb(var(--rgb-blue) / 0.45);
    }
    100% {
      height: 2.25rem;
      box-shadow: inset 0 0 0 1px rgb(var(--rgb-blue) / 0.5);
    }
  }
  @keyframes saas-switch {
    0%,
    12%,
    100% {
      background: #1b7ffc;
    }
    20%,
    92% {
      background: rgb(var(--rgb-light) / 0.14);
    }
  }
  @keyframes saas-knob {
    0%,
    12%,
    100% {
      translate: 0.75rem 0;
      background: var(--white);
    }
    20%,
    92% {
      translate: 0 0;
      background: var(--mist-300);
    }
  }

  /* --- Automatizar: siempre los mismos pasos, y nadie teclea ---------------- */
  .art-steps {
    --period: 7s;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    justify-items: center;
    row-gap: var(--space-5);
    width: min(38rem, 100%);
  }
  .art-steps__rail {
    position: absolute;
    inset-block-start: 1.125rem;
    inset-inline: 12.5%;
    height: 2px;
    background: var(--night-700);
    overflow: hidden;
  }
  .art-steps__fill {
    display: block;
    height: 100%;
    background: var(--strand);
    transform-origin: left;
    box-shadow: 0 0 12px rgb(var(--rgb-blue));
    animation: steps-fill var(--period) var(--ease-in-out) infinite;
  }
  .art-steps__step {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    color: var(--fg);
    animation: steps-label var(--period) linear infinite;
    animation-delay: calc(var(--i) * 1.15s);
  }
  .art-steps__dot {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: #1b7ffc;
    animation: steps-dot var(--period) linear infinite;
    animation-delay: calc(var(--i) * 1.15s);
  }
  .art-steps__dot::after {
    content: "";
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 45%;
    width: 0.4375rem;
    height: 0.8125rem;
    translate: -50% -50%;
    rotate: 42deg;
    border-inline-end: 2px solid var(--white);
    border-block-end: 2px solid var(--white);
    animation: steps-check var(--period) linear infinite;
    animation-delay: calc(var(--i) * 1.15s);
  }
  .art-steps__done {
    grid-column: 1 / -1;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-l);
    font-weight: var(--weight-medium);
    box-shadow: var(--shadow-lit);
    rotate: -2deg;
    transition: none;
    animation: steps-done var(--period) var(--ease-spring) infinite;
  }
  @keyframes steps-fill {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    50%,
    88% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  @keyframes steps-dot {
    0% {
      background: var(--night-800);
      box-shadow: inset 0 0 0 1px rgb(var(--rgb-light) / 0.14);
    }
    4%,
    58% {
      background: #1b7ffc;
      box-shadow: 0 0 22px rgb(var(--rgb-blue) / 0.8);
    }
    70%,
    100% {
      background: var(--night-800);
      box-shadow: inset 0 0 0 1px rgb(var(--rgb-light) / 0.14);
    }
  }
  @keyframes steps-check {
    0%,
    2% {
      opacity: 0;
    }
    6%,
    58% {
      opacity: 1;
    }
    70%,
    100% {
      opacity: 0;
    }
  }
  @keyframes steps-label {
    0%,
    100% {
      color: var(--fg-muted);
    }
    6%,
    58% {
      color: var(--fg);
    }
    70% {
      color: var(--fg-muted);
    }
  }
  @keyframes steps-done {
    0%,
    54% {
      opacity: 0;
      scale: 0.86;
      translate: 0 0.625rem;
    }
    62%,
    90% {
      opacity: 1;
      scale: 1;
      translate: 0 0;
    }
    100% {
      opacity: 0;
      scale: 0.96;
      translate: 0 0;
    }
  }

  /* --- Conectar: un solo dato, y cada sistema se entera --------------------- */
  .art-flow {
    --period: 5s;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 3.5rem minmax(0, 1fr) 7rem;
    align-items: center;
    width: min(42rem, 100%);
    height: 12rem;
  }
  .art-flow__side {
    display: grid;
    align-content: space-between;
    height: 100%;
  }
  .art-flow__node {
    display: grid;
    gap: 0.0625rem;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-m);
    background: var(--night-800);
    box-shadow: var(--shadow-key);
    animation: flow-node var(--period) var(--ease-out) infinite;
    animation-delay: calc(var(--i) * 0.4s);
  }
  .art-flow__node--out {
    animation-delay: 1.9s;
  }
  .art-flow__node b {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--fg);
    white-space: nowrap;
  }
  .art-flow__node small {
    font-size: var(--text-caption);
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .art-flow__led {
    flex: none;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: rgb(var(--rgb-cyan));
    box-shadow: 0 0 8px rgb(var(--rgb-cyan));
  }
  .art-flow__wires {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .art-flow__wire {
    stroke: var(--night-700);
    stroke-width: 1.5;
  }
  .art-flow__pulse {
    stroke: url(#flow-pulse);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 0.2 1;
    stroke-dashoffset: 0.2;
    animation: flow-run var(--period) var(--ease-in-out) infinite;
