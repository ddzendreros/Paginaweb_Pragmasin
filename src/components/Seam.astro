---
/**
 * The weave crossing: an element from one act crossing the frontier into
 * the other, like the knot's over-under strands. Place it BETWEEN two acts.
 * `ground` is the act the card belongs to (the one it is arriving from).
 */
interface Props {
  ground: "ground-light" | "ground-dark";
}
const { ground } = Astro.props;
---

<div class="seam" role="presentation">
  <aside class={`seam__card ${ground}`} data-weave>
    <slot />
  </aside>
</div>

<script>
  // The site's single personality gesture: weave once on first sight.
  const cards = document.querySelectorAll<HTMLElement>(".seam__card[data-weave]");
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-woven");
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.4 },
  );
  cards.forEach((c) => observer.observe(c));
</script>
