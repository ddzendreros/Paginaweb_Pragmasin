---
/**
 * El acceso flotante por WhatsApp. Si `site.whatsappNumber` está vacío no se
 * pinta nada: mejor no ofrecer el canal que ofrecer un enlace muerto.
 */
import { hasWhatsapp, waMessages, whatsappUrl } from "../site";

const href = whatsappUrl(waMessages.flotante);
---

{
  hasWhatsapp && href && (
    <a
      class="wa-fab"
      href={href}
      target="_blank"
      rel="noopener"
      aria-label="Escribirnos por WhatsApp"
    >
      <svg class="wa-fab__glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 2.4c-5.3 0-9.6 3.9-9.6 8.7 0 2.3 1 4.4 2.7 6L4 21.6l4.7-1.5c1 .3 2.1.4 3.3.4 5.3 0 9.6-3.9 9.6-8.7S17.3 2.4 12 2.4Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        />
        <path
          d="M9.2 8.4c.3-.1.6 0 .8.3l.8 1.3c.1.2.1.5 0 .7l-.5.7c.5 1 1.3 1.8 2.3 2.3l.7-.5c.2-.1.5-.2.7 0l1.3.8c.3.2.4.5.3.8-.3.9-1.2 1.4-2.1 1.2-2.6-.5-4.7-2.6-5.2-5.2-.2-.9.3-1.8 1.2-2.1Z"
          fill="currentColor"
        />
      </svg>
      <span class="wa-fab__label">WhatsApp</span>
    </a>
  )
}

<style>
  .wa-fab {
    position: fixed;
    inset-block-end: var(--space-5);
    inset-inline-end: var(--space-5);
    z-index: var(--z-float);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    /* glass, not WhatsApp green: the palette table has no green in it and a
       branded blob would be the loudest thing on every page */
    background: var(--surface-glass);
    -webkit-backdrop-filter: blur(var(--blur-glass)) saturate(var(--saturate-glass));
    backdrop-filter: blur(var(--blur-glass)) saturate(var(--saturate-glass));
    border: var(--hairline) solid var(--surface-border);
    box-shadow: var(--shadow-3);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    transition: translate var(--dur-2) var(--ease-rise),
      border-color var(--dur-2) var(--ease-swift);
  }
  .wa-fab:hover {
    translate: 0 calc(-1 * var(--space-1));
    border-color: var(--surface-border-hover);
  }
  .wa-fab__glyph {
    width: var(--space-5);
    height: var(--space-5);
    color: var(--interactive);
    flex: none;
  }
  @media (max-width: 30rem) {
    .wa-fab {
      inset-block-end: var(--space-4);
      inset-inline-end: var(--space-4);
      padding: var(--space-3);
    }
    .wa-fab__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
