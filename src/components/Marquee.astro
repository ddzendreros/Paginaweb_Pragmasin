---
/**
 * Una franja con lo que siempre es cierto, en movimiento continuo. Todas las
 * frases salen del copy aprobado. La segunda copia existe solo para que el giro
 * no tenga costura y por eso se oculta a los lectores de pantalla.
 */
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";

const items: [IconName, string][] = [
  ["receipt", "Pago único"],
  ["key", "Sin contratos que te amarren"],
  ["chat", "Hablas con quien lo construye"],
  ["doc", "Alcance escrito antes de firmar"],
  ["eye", "Ves el avance mientras se hace"],
  ["play", "Entregamos funcionando, no en diapositivas"],
  ["cap", "Tu equipo aprende a usarlo"],
  ["life", "Seguimos después de entregar"],
];
---

<div class="marquee">
  <div class="marquee__track">
    {
      [false, true].map((copy) => (
        <ul class="marquee__set" aria-hidden={copy ? "true" : undefined}>
          {items.map(([icon, text]) => (
            <li>
              <Icon name={icon} />
              {text}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: var(--space-5);
    border-block: var(--hairline) solid var(--hairline-color);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-run 46s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__set {
    display: flex;
    flex: none;
  }
  .marquee__set li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-6);
    color: var(--fg-secondary);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .marquee__set :global(.icon) {
    color: var(--sky);
  }
  @keyframes marquee-run {
    to {
      translate: -50% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
