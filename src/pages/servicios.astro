---
import BaseLayout from "../layouts/BaseLayout.astro";

const lines = [
  {
    num: "01",
    name: 'Software <span>a la medida</span>',
    text: "Sistemas, portales, paneles y apps diseñados alrededor de cómo trabaja tu empresa.",
    signals: [
      "ya probaste varios sistemas y ninguno te queda;",
      "tu operación vive entre Excels, libretas y mensajes;",
      "quieres que tu equipo deje de pelearse con la pantalla.",
    ],
  },
  {
    num: "02",
    name: "Reemplazo de SaaS",
    text: "Revisamos lo que pagas y lo que usas. Si te conviene, construimos tu propia versión con lo que sí necesitas.",
    signals: [
      "pagas cada mes por usuarios o funciones que no usas;",
      "el precio sube y tú no recibes más;",
      "dependes de una herramienta que no controlas.",
    ],
  },
  {
    num: "03",
    name: "Automatización e integración",
    text: "Lo que se repite lo hace el sistema. Lo que no se habla se conecta.",
    signals: [
      "alguien teclea lo que ya venía escrito;",
      "el mismo dato se captura dos veces;",
      "el reporte de cada semana se arma a mano.",
    ],
  },
];

const rules: [string, string][] = [
  ["Primero entendemos.", "Si no cabe en una página, todavía no entendimos el problema."],
  [
    "Entregamos funcionando, no en diapositivas.",
    "Lo que recibes es software corriendo en tu operación, no un documento que describe uno.",
  ],
  [
    "Alcance escrito antes de firmar.",
    "Qué se construye, qué incluye y cuánto cuesta quedan por escrito.",
  ],
  ["Hablas con quien construye.", "Sin intermediarios entre tu idea y quien la programa."],
  ["Decimos que no.", "Si no te conviene construir algo, te lo decimos en la primera llamada."],
];
---

<BaseLayout
  title="Qué construimos — Pragmasyn"
  description="Software a la medida, reemplazo de SaaS, automatización e integración para PyMEs en México. Sin catálogo y sin paquetes."
  ogTitle="No tenemos catálogo. Tenemos oficio."
  ogDescription="Cada empresa tiene variables distintas. Escuchamos qué necesitas y lo construimos."
  path="/servicios"
>
  <section class="opening" aria-labelledby="servicios-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <p class="label label--rule">Qué construimos</p>
          <h1 id="servicios-title" class="display">
            No tenemos catálogo. <em>Tenemos oficio.</em>
          </h1>
        </div>
        <div class="opening__aside">
          <p class="lead">
            Cada empresa tiene variables distintas. Por eso no vendemos paquetes: escuchamos qué
            necesitas y lo construimos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="act lines" aria-label="Líneas de trabajo">
    <div class="act__inner">
      <ol>
        {
          lines.map((l) => (
            <li class="line grid-12" data-reveal>
              <span class="caption numeral line__num">{l.num}</span>
              <h2 class="h2 line__name" set:html={l.name} />
              <div class="line__body">
                <p class="lead">{l.text}</p>
                <p class="label line__label">Es para ti si…</p>
                <ul class="line__signals">
                  {l.signals.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="chapter ground-light rules act" aria-labelledby="reglas-title">
    <div class="act__inner grid-12">
      <div class="rules__head" data-reveal>
        <p class="label label--rule">Cómo decidimos</p>
        <h2 id="reglas-title" class="h2">
          Cinco reglas que <em>no negociamos.</em>
        </h2>
      </div>
      <ol class="rules__list">
        {
          rules.map(([rule, text]) => (
            <li class="rule" data-reveal>
              <h3 class="h3">{rule}</h3>
              <p class="rule__text">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="chapter ground-dark act closing-act" aria-labelledby="cierre-title">
    <div class="act__inner">
      <div class="closing" data-reveal>
        <h2 id="cierre-title" class="display-2">
          Empecemos por lo que <em>te estorba.</em>
        </h2>
        <p class="lead">
          Cuéntanos qué te gustaría resolver. Si no somos la opción correcta, te lo decimos.
        </p>
        <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .line {
    align-items: start;
    padding-block: var(--space-7);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .line:last-child {
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .line__num {
    --col: 1 / span 1;
    padding-block-start: var(--space-2);
  }
  .line__name {
    --col: 2 / span 5;
  }
  /* a stranded "a" at the end of a line reads as a typo */
  .line__name :global(span) {
    white-space: nowrap;
  }
  .line__body {
    --col: 7 / span 6;
    display: grid;
    gap: var(--space-3);
  }
  .line__label {
    margin-block-start: var(--space-4);
  }
  .line__signals {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }
  .line__signals li {
    position: relative;
    padding-inline-start: var(--space-5);
    text-wrap: pretty;
  }
  .line__signals li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.85em;
    width: var(--space-3);
    border-block-start: var(--hairline-strong) solid var(--interactive);
  }
  @media (width <= 56rem) {
    .line__name {
      margin-block-start: var(--space-3);
    }
    .line__body {
      margin-block-start: var(--space-4);
    }
  }

  .rules {
    background: var(--bg-sunken);
  }
  .rules__head {
    --col: 1 / span 5;
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .rules__list {
    --col: 7 / span 6;
  }
  .rule {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .rule:last-child {
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .rule__text {
    max-width: var(--measure);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }
  @media (width <= 56rem) {
    .rules__head {
      margin-block-end: var(--space-7);
    }
  }

  .closing-act {
    margin-block: var(--chapter-inset);
  }
</style>
