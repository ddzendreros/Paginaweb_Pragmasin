---
import Icon from "../components/Icon.astro";
import type { IconName } from "../components/Icon.astro";
import Strands from "../components/Strands.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const lines = [
  {
    num: "01",
    name: 'Software <span>a la medida</span>',
    text: "Sistemas, portales, paneles y apps diseñados alrededor de cómo trabaja tu empresa.",
    signals: [
      "ya probaste varios sistemas y ninguno te queda;",
      "tu operación vive entre Excels, libretas y mensajes;",
      "quieres que tu equipo deje de pelearse con la pantalla.",
    ],
  },
  {
    num: "02",
    name: "Reemplazo de SaaS",
    text: "Revisamos lo que pagas y lo que usas. Si te conviene, construimos tu propia versión con lo que sí necesitas.",
    signals: [
      "pagas cada mes por usuarios o funciones que no usas;",
      "el precio sube y tú no recibes más;",
      "dependes de una herramienta que no controlas.",
    ],
  },
  {
    num: "03",
    name: "Automatización e integración",
    text: "Lo que se repite lo hace el sistema. Lo que no se habla se conecta.",
    signals: [
      "alguien teclea lo que ya venía escrito;",
      "el mismo dato se captura dos veces;",
      "el reporte de cada semana se arma a mano.",
    ],
  },
];

const rules: [IconName, string, string][] = [
  ["target", "Primero entendemos.", "Si no cabe en una página, todavía no entendimos el problema."],
  [
    "play",
    "Entregamos funcionando, no en diapositivas.",
    "Lo que recibes es software corriendo en tu operación, no un documento que describe uno.",
  ],
  [
    "doc",
    "Alcance escrito antes de firmar.",
    "Qué se construye, qué incluye y cuánto cuesta quedan por escrito.",
  ],
  ["chat", "Hablas con quien construye.", "Sin intermediarios entre tu idea y quien la programa."],
  ["ban", "Decimos que no.", "Si no te conviene construir algo, te lo decimos en la primera llamada."],
];
---

<BaseLayout
  title="Qué construimos — Pragmasyn"
  description="Software a la medida, reemplazo de SaaS, automatización e integración para PyMEs en México. Sin catálogo y sin paquetes."
  ogTitle="No tenemos catálogo. Tenemos oficio."
  ogDescription="Cada empresa tiene variables distintas. Escuchamos qué necesitas y lo construimos."
  path="/servicios"
>
  <section class="opening" aria-labelledby="servicios-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <p class="label">Qué construimos</p>
          <h1 id="servicios-title" class="display">No tenemos catálogo. Tenemos oficio.</h1>
        </div>
        <div class="opening__aside">
          <p class="lead">
            Cada empresa tiene variables distintas. Por eso no vendemos paquetes: escuchamos qué
            necesitas y lo construimos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="lines" aria-label="Líneas de trabajo">
    <div class="act__inner">
      <ol class="lines__list">
        {
          lines.map((l) => (
            <li class="line panel">
              <div class="line__head">
                <span class="caption numeral">{l.num}</span>
                <h2 class="h2 line__name" set:html={l.name} />
                <p class="lead">{l.text}</p>
              </div>
              <div class="line__body">
                <p class="label">Es para ti si…</p>
                <ul class="line__signals">
                  {l.signals.map((s) => (
                    <li>
                      <span class="line__check">
                        <Icon name="check" />
                      </span>
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="act rules" aria-labelledby="reglas-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Cómo decidimos</p>
      <div class="sec__body">
        <h2 id="reglas-title" class="h2 head">Cinco reglas que no negociamos.</h2>
        <ol class="rules__grid">
          {
            rules.map(([icon, rule, text]) => (
              <li class="rule panel">
                <span class="rule__icon">
                  <Icon name={icon} />
                </span>
                <h3 class="h3">{rule}</h3>
                <p class="rule__text">{text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="act closing-act" aria-labelledby="cierre-title">
    <Strands class="closing__art" />
    <div class="act__inner grid-12 closing">
      <h2 id="cierre-title" class="display closing__title">Empecemos por lo que te estorba.</h2>
      <div class="closing__aside">
        <p class="lead">
          Cuéntanos qué te gustaría resolver. Si no somos la opción correcta, te lo decimos.
        </p>
        <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lines__list {
    display: grid;
    gap: var(--space-3);
  }
  .line {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-6) var(--space-7);
    align-items: center;
    padding: clamp(var(--space-5), 3.5vw, var(--space-7));
  }
  .line__head {
    display: grid;
    gap: var(--space-3);
  }
  /* a stranded "a" at the end of a line reads as a typo */
  .line__name :global(span) {
    white-space: nowrap;
  }
  .line__body {
    display: grid;
    gap: var(--space-3);
  }
  .line__signals {
    display: grid;
    gap: var(--space-2);
  }
  .line__signals li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: rgb(var(--rgb-blue) / 0.1);
    border-radius: var(--radius-m);
    box-shadow: inset 0 0 0 1px rgb(var(--rgb-blue) / 0.22);
    text-wrap: pretty;
  }
  .line__check {
    margin-block-start: 0.1875rem;
    color: var(--sky);
  }
  .line__check :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  @media (width <= 56rem) {
    .line {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .rules {
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .rules__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .rule {
    grid-column: span 2;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .rule:nth-child(n + 4) {
    grid-column: span 3;
  }
  .rule__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-block-end: var(--space-2);
    border-radius: 50%;
    background: var(--night-800);
    color: var(--sky);
    box-shadow: var(--shadow-key);
  }
  .rule__text {
    color: var(--fg-secondary);
    text-wrap: pretty;
  }
  @media (width <= 56rem) {
    .rule,
    .rule:nth-child(n + 4) {
      grid-column: span 6;
    }
  }
</style>
