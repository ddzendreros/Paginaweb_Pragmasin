---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    num: "01",
    name: "Diagnóstico de Horas Recuperables",
    text: "Entramos con datos, no con propuestas: medimos dónde se van las horas, priorizamos qué automatizar y arrancamos la primera pieza contigo. Es el punto de entrada natural: si funciona, seguimos; si no, no te amarramos a nada.",
    signals: [
      "sospechas que se van horas pero nadie las tiene contadas;",
      "quieres empezar por algo acotado antes de firmar un proyecto;",
      "necesitas números para justificar la inversión ante dirección.",
    ],
  },
  {
    num: "02",
    name: "Automatización de procesos",
    text: "Implementación de lo que salió priorizado en el diagnóstico. Documentos que se leen solos, capturas que desaparecen, reportes que se arman sin que nadie los arme. Con tu equipo o con el nuestro.",
    signals: [
      "tu gente dedica el día a capturar lo que llegó por correo o WhatsApp;",
      "el reporte de cada semana se arma a mano, siempre igual;",
      "conciliar facturas contra órdenes de compra consume a una persona.",
    ],
  },
  {
    num: "03",
    name: "Integración y datos",
    text: "Conectamos los sistemas que hoy no se hablan y convertimos lo que ya tienes en respuestas a tiempo. Sin migrar, sin reemplazar y sin tocar lo que ya funciona.",
    signals: [
      "el mismo dato se teclea dos veces en dos sistemas distintos;",
      "para responder una pregunta simple hay que abrir cinco pantallas;",
      "cada área tiene su propio Excel y ninguna cifra coincide.",
    ],
  },
];

const principles = [
  {
    title: "Si no se puede medir, no lo vendemos.",
    text: "El ahorro se compromete en horas, contra una línea base que medimos antes de empezar.",
  },
  {
    title: "Entregamos funcionando, no en diapositivas.",
    text: "El entregable es un proceso corriendo en tu operación, no un documento que describe uno.",
  },
  {
    title: "Alcance escrito antes de firmar.",
    text: "El costo y lo que incluye quedan por escrito con datos de tu operación, no con horas abiertas.",
  },
  {
    title: "No reemplazamos lo que ya funciona.",
    text: "Nos montamos encima de tu sistema. Lo que ya invertiste se aprovecha, no se tira.",
  },
  {
    title: "Decimos que no.",
    text: "Si tu problema no se resuelve con automatización, te lo decimos en la primera llamada.",
  },
];
---

<BaseLayout
  title="Servicios — Pragmasyn"
  description="Diagnóstico de Horas Recuperables, automatización de procesos e integración de sistemas. Un criterio para las tres: si el ahorro no se puede medir, no lo vendemos."
  ogTitle="Tres maneras de recuperar horas."
  ogDescription="Diagnóstico Pragmasyn, automatización de procesos e integración de sistemas. Sobre el sistema que ya tienes, sin migrar nada."
  path="/servicios"
>
  <section class="ground-dark act opening" aria-labelledby="services-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Servicios</p>
        <h1 id="services-title" class="display">Tres maneras de recuperar horas.</h1>
        <p class="lead">
          Un criterio para las tres: si el ahorro no se puede medir, no lo
          vendemos.
        </p>
      </div>
    </div>
  </section>

  <section class="ground-light act services" aria-label="Líneas de servicio">
    <div class="act__inner">
      <ol class="services__list">
        {
          services.map((s) => (
            <li class="card card--feature service" data-reveal>
              <div class="service__head">
                <span class="numeral service__num" aria-hidden="true">
                  {s.num}
                </span>
                <h2 class="h3 service__name">{s.name}</h2>
              </div>
              <div class="service__body">
                <p class="body service__text">{s.text}</p>
                <p class="label service__signals-label">Es para ti si…</p>
                <ul class="service__signals">
                  {s.signals.map((signal) => (
                    <li class="small">{signal}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="ground-light act act--well principles" aria-labelledby="principles-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Cómo trabajamos</p>
        <h2 id="principles-title" class="h2">Cinco reglas que no negociamos.</h2>
      </div>
      <ul class="cards principles__list">
        {
          principles.map((p) => (
            <li class="card principles__item" data-reveal>
              <h3 class="h4">{p.title}</h3>
              <p class="small principles__text">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ground-dark act closing" aria-labelledby="closing-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <h2 id="closing-title" class="display-2">Empecemos por el diagnóstico.</h2>
        <p class="lead">
          Medimos con tus datos cuántas horas hay en la mesa. Si no las hay,
          te lo decimos.
        </p>
        <a class="btn btn--primary closing__cta" href="/contacto">Agendar el diagnóstico</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .opening {
    padding-block: clamp(var(--space-8), 10vw, var(--space-10)) clamp(var(--space-8), 9vw, var(--space-10));
  }
  .services {
    /* aire para la tarjeta que cruza la frontera desde el acto oscuro */
    padding-top: clamp(var(--space-9), 10vw, var(--space-11));
  }
  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gutter);
  }
  .service {
    display: grid;
    gap: var(--space-5) var(--space-8);
  }
  /* en pantalla ancha el servicio se lee como una ficha: título a la
     izquierda, argumento a la derecha */
  @media (min-width: 64rem) {
    .service {
      grid-template-columns: 2fr 3fr;
      align-items: start;
    }
  }
  .service__num {
    color: var(--interactive);
    font-size: var(--text-h4);
    font-weight: var(--weight-strong);
  }
  .service__name {
    margin-top: var(--space-2);
  }
  .service__signals-label {
    margin-top: var(--space-6);
  }
  .service__signals {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    max-width: var(--measure);
  }
  .service__signals li {
    padding-block: var(--space-3);
    border-top: var(--hairline) solid var(--hairline-color);
  }

  .principles__list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
  }
  .principles__text {
    margin-top: var(--space-3);
  }

  .closing {
    padding-block: clamp(var(--space-9), 10vw, var(--space-11));
  }
  .closing__cta {
    margin-top: var(--space-4);
  }

  .seam-card__text {
    margin-block: var(--space-2) var(--space-3);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
</style>
