---
import ServiceStage from "../components/ServiceStage.astro";
import Strands from "../components/Strands.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const lines = [
  {
    num: "01",
    name: 'Software <span>a la medida</span>',
    text: "Sistemas, portales, paneles y apps diseñados alrededor de cómo trabaja tu empresa.",
    signals: [
      "ya probaste varios sistemas y ninguno te queda;",
      "tu operación vive entre Excels, libretas y mensajes;",
      "quieres que tu equipo deje de pelearse con la pantalla.",
    ],
  },
  {
    num: "02",
    name: "Reemplazo de SaaS",
    text: "Revisamos lo que pagas y lo que usas. Si te conviene, construimos tu propia versión con lo que sí necesitas.",
    signals: [
      "pagas cada mes por usuarios o funciones que no usas;",
      "el precio sube y tú no recibes más;",
      "dependes de una herramienta que no controlas.",
    ],
  },
  {
    num: "03",
    name: "Automatización e integración",
    text: "Lo que se repite lo hace el sistema. Lo que no se habla se conecta.",
    signals: [
      "alguien teclea lo que ya venía escrito;",
      "el mismo dato se captura dos veces;",
      "el reporte de cada semana se arma a mano.",
    ],
  },
];

const rules: [string, string][] = [
  ["Primero entendemos.", "Si no cabe en una página, todavía no entendimos el problema."],
  [
    "Entregamos funcionando, no en diapositivas.",
    "Lo que recibes es software corriendo en tu operación, no un documento que describe uno.",
  ],
  ["Alcance escrito antes de firmar.", "Qué se construye, qué incluye y cuánto cuesta quedan por escrito."],
  ["Hablas con quien construye.", "Sin intermediarios entre tu idea y quien la programa."],
  ["Decimos que no.", "Si no te conviene construir algo, te lo decimos en la primera llamada."],
];
---

<BaseLayout
  title="Qué construimos — Pragmasyn"
  description="Software a la medida, reemplazo de SaaS, automatización e integración para PyMEs en México. Sin catálogo y sin paquetes."
  ogTitle="No tenemos catálogo. Tenemos oficio."
  ogDescription="Cada empresa tiene variables distintas. Escuchamos qué necesitas y lo construimos."
  path="/servicios"
>
  <ServiceStage lines={lines} rules={rules} />

  <section class="act closing-act" aria-labelledby="cierre-title">
    <Strands class="closing__art" />
    <div class="act__inner grid-12 closing">
      <h2 id="cierre-title" class="display closing__title">Empecemos por lo que te estorba.</h2>
      <div class="closing__aside">
        <p class="lead">
          Cuéntanos qué te gustaría resolver. Si no somos la opción correcta, te lo decimos.
        </p>
        <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .closing-act {
    display: grid;
    align-content: end;
    min-height: 100svh;
    border-block-start: 0;
  }
  .closing__title {
    font-size: var(--text-block-first);
    line-height: var(--leading-block);
    letter-spacing: var(--tracking-block);
    font-stretch: var(--width-block);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
  }
</style>
