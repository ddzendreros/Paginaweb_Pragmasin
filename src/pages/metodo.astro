---
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  {
    num: "01",
    name: "Escuchar",
    rows: [
      [
        "Qué hacemos",
        "Hablamos contigo y con quien hace el trabajo. Queremos ver cómo opera tu negocio hoy, no cómo se supone que opera.",
      ],
      ["Qué recibes", "El problema y lo que vamos a construir, en una página."],
      [
        "Qué necesitamos de ti",
        "Acceso a quien hace el trabajo. No a quien lo describe: a quien lo hace.",
      ],
    ],
  },
  {
    num: "02",
    name: "Diseñar",
    rows: [
      [
        "Qué hacemos",
        "Dibujamos las pantallas y el flujo antes de programar. Cambiar un dibujo no cuesta nada.",
      ],
      ["Qué recibes", "Las pantallas, el alcance y el costo, por escrito."],
      ["Qué necesitamos de ti", "Una decisión. Para eso está hecho."],
    ],
  },
  {
    num: "03",
    name: "Construir",
    rows: [
      [
        "Qué hacemos",
        "Programamos por partes. Ves y pruebas cada avance, y lo ajustamos contigo.",
      ],
      ["Qué recibes", "Software funcionando en tu operación, no una presentación."],
      ["Qué necesitamos de ti", "Una persona de tu lado que pueda decidir."],
    ],
  },
  {
    num: "04",
    name: "Acompañar",
    rows: [
      ["Qué hacemos", "Capacitamos a tu equipo y seguimos cerca después de entregar."],
      ["Qué recibes", "Tu equipo usando el sistema y un canal directo con nosotros."],
      ["Qué necesitamos de ti", "Que nos digas qué no está funcionando."],
    ],
  },
];

const nots = [
  "Reportes de ochenta láminas que nadie abre dos veces.",
  "Facturar por estar sentados en tus juntas.",
  "Prometer plazos antes de entender el problema.",
  "Venderte un paquete que te obliga a cambiar tu forma de trabajar.",
  "Construir algo que no necesitas.",
  "Desaparecer después de entregar.",
];
---

<BaseLayout
  title="Cómo trabajamos — Pragmasyn"
  description="Escuchar, diseñar, construir y acompañar. Qué hacemos, qué recibes y qué necesitamos de ti en cada paso. Sin pasos secretos."
  ogTitle="Lo que se decide, se entrega."
  ogDescription="Cuatro pasos, contigo en todos. Qué hacemos, qué recibes y qué necesitamos de ti."
  path="/metodo"
>
  <section class="opening" aria-labelledby="metodo-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <p class="label label--rule">Cómo trabajamos</p>
          <h1 id="metodo-title" class="display">Lo que se decide, <em>se entrega.</em></h1>
        </div>
        <div class="opening__aside">
          <p class="lead">Cuatro pasos, contigo en todos. Sin pasos secretos.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="act steps" aria-label="Los cuatro pasos">
    <div class="act__inner">
      <ol>
        {
          steps.map((s) => (
            <li class="step grid-12" data-reveal>
              <div class="step__head">
                <span class="caption numeral">{s.num}</span>
                <h2 class="h2">{s.name}</h2>
              </div>
              <dl class="step__rows">
                {s.rows.map(([label, text]) => (
                  <div class="step__row">
                    <dt class="label">{label}</dt>
                    <dd>{text}</dd>
                  </div>
                ))}
              </dl>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="chapter ground-dark act" aria-labelledby="nots-title">
    <div class="act__inner">
      <div class="head" data-reveal>
        <p class="label label--rule">Qué no hacemos</p>
        <h2 id="nots-title" class="h2 head__title">
          También hay que <em>decirlo.</em>
        </h2>
      </div>
      <ul class="nots">
        {
          nots.map((n) => (
            <li class="not h3" data-reveal>
              {n}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="act" aria-labelledby="cierre-title">
    <div class="act__inner">
      <div class="closing" data-reveal>
        <h2 id="cierre-title" class="display-2">
          El primer paso es <em>hablar.</em>
        </h2>
        <p class="lead">Cuéntanos qué te estorba. De ahí sale todo lo demás.</p>
        <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .step {
    align-items: start;
    padding-block: var(--space-7);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .step:last-child {
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .step__head {
    --col: 1 / span 4;
    position: sticky;
    inset-block-start: var(--space-9);
    display: grid;
    gap: var(--space-2);
  }
  .step__rows {
    --col: 5 / span 8;
  }
  .step__row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--gutter);
    padding-block: var(--space-4);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .step__row:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }
  .step__row dd {
    max-width: var(--measure);
    text-wrap: pretty;
  }
  @media (width <= 56rem) {
    .step__head {
      position: static;
      margin-block-end: var(--space-5);
    }
  }
  @media (width <= 40rem) {
    .step__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  .nots {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--gutter);
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .not {
    padding-block: var(--space-5);
    border-block-start: var(--hairline) solid var(--hairline-color);
    text-wrap: pretty;
  }
  @media (width <= 40rem) {
    .nots {
      grid-template-columns: 1fr;
    }
  }
</style>
