---
import Icon from "../components/Icon.astro";
import MethodSteps from "../components/MethodSteps.astro";
import Strands from "../components/Strands.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const nots = [
  "Reportes de ochenta láminas que nadie abre dos veces.",
  "Facturar por estar sentados en tus juntas.",
  "Prometer plazos antes de entender el problema.",
  "Venderte un paquete que te obliga a cambiar tu forma de trabajar.",
  "Construir algo que no necesitas.",
  "Desaparecer después de entregar.",
];
---

<BaseLayout
  title="Cómo trabajamos — Pragmasyn"
  description="Escuchar, diseñar, construir y acompañar. Qué hacemos, qué recibes y qué necesitamos de ti en cada paso. Sin pasos secretos."
  ogTitle="Lo que se decide, se entrega."
  ogDescription="Cuatro pasos, contigo en todos. Qué hacemos, qué recibes y qué necesitamos de ti."
  path="/metodo"
>
  <section class="opening" aria-labelledby="metodo-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <p class="label">Cómo trabajamos</p>
          <h1 id="metodo-title" class="display">Lo que se decide, se entrega.</h1>
        </div>
        <div class="opening__aside">
          <p class="lead">Cuatro pasos, contigo en todos. Sin pasos secretos.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="steps-act" aria-label="Cuatro pasos">
    <div class="act__inner">
      <MethodSteps />
    </div>
  </section>

  <section class="act nots-act" aria-labelledby="nots-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Qué no hacemos</p>
      <div class="sec__body">
        <h2 id="nots-title" class="h2 head">También hay que decirlo.</h2>
        <ul class="nots">
          {
            nots.map((n) => (
              <li class="not">
                <span class="not__mark">
                  <Icon name="x" />
                </span>
                <span class="h3">{n}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="act closing-act" aria-labelledby="cierre-title">
    <Strands class="closing__art" />
    <div class="act__inner grid-12 closing">
      <h2 id="cierre-title" class="display closing__title">El primer paso es hablar.</h2>
      <div class="closing__aside">
        <p class="lead">Cuéntanos qué te estorba. De ahí sale todo lo demás.</p>
        <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .steps-act {
    padding-block-end: clamp(var(--space-8), 8vw, var(--space-10));
  }
  .nots-act {
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .nots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .not {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background: rgb(var(--rgb-light) / 0.03);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-key);
    text-wrap: pretty;
  }
  .not__mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgb(var(--rgb-light) / 0.07);
    color: var(--error-on-dark);
  }
  .not__mark :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  @media (width <= 40rem) {
    .nots {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
