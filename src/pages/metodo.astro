---
import Icon from "../components/Icon.astro";
import type { IconName } from "../components/Icon.astro";
import MethodPass from "../components/MethodPass.astro";
import MethodSteps from "../components/MethodSteps.astro";
import Strands from "../components/Strands.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const steps: { num: string; slug: string; icon: IconName; name: string; rows: [string, string][] }[] = [
  {
    num: "01",
    slug: "escuchar",
    icon: "wave",
    name: "Escuchar",
    rows: [
      [
        "Qué hacemos",
        "Hablamos contigo y con quien hace el trabajo. Queremos ver cómo opera tu negocio hoy, no cómo se supone que opera.",
      ],
      ["Qué recibes", "El problema y lo que vamos a construir, en una página."],
      [
        "Qué necesitamos de ti",
        "Acceso a quien hace el trabajo. No a quien lo describe: a quien lo hace.",
      ],
    ],
  },
  {
    num: "02",
    slug: "disenar",
    icon: "pen",
    name: "Diseñar",
    rows: [
      [
        "Qué hacemos",
        "Dibujamos las pantallas y el flujo antes de programar. Cambiar un dibujo no cuesta nada.",
      ],
      ["Qué recibes", "Las pantallas, el alcance y el costo, por escrito."],
      ["Qué necesitamos de ti", "Una decisión. Para eso está hecho."],
    ],
  },
  {
    num: "03",
    slug: "construir",
    icon: "code",
    name: "Construir",
    rows: [
      [
        "Qué hacemos",
        "Programamos por partes. Ves y pruebas cada avance, y lo ajustamos contigo.",
      ],
      ["Qué recibes", "Software funcionando en tu operación, no una presentación."],
      ["Qué necesitamos de ti", "Una persona de tu lado que pueda decidir."],
    ],
  },
  {
    num: "04",
    slug: "acompanar",
    icon: "people",
    name: "Acompañar",
    rows: [
      ["Qué hacemos", "Capacitamos a tu equipo y seguimos cerca después de entregar."],
      ["Qué recibes", "Tu equipo usando el sistema y un canal directo con nosotros."],
      ["Qué necesitamos de ti", "Que nos digas qué no está funcionando."],
    ],
  },
];

const nots = [
  "Reportes de ochenta láminas que nadie abre dos veces.",
  "Facturar por estar sentados en tus juntas.",
  "Prometer plazos antes de entender el problema.",
  "Venderte un paquete que te obliga a cambiar tu forma de trabajar.",
  "Construir algo que no necesitas.",
  "Desaparecer después de entregar.",
];
---

<BaseLayout
  title="Cómo trabajamos — Pragmasyn"
  description="Escuchar, diseñar, construir y acompañar. Qué hacemos, qué recibes y qué necesitamos de ti en cada paso. Sin pasos secretos."
  ogTitle="Lo que se decide, se entrega."
  ogDescription="Cuatro pasos, contigo en todos. Qué hacemos, qué recibes y qué necesitamos de ti."
  path="/metodo"
>
  <section class="opening" aria-labelledby="metodo-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <p class="label">Cómo trabajamos</p>
          <h1 id="metodo-title" class="promise">
            <span>Lo que se decide,</span>
            <span class="promise__end">se entrega.</span>
          </h1>
        </div>
        <div class="opening__aside">
          <MethodPass lead="Cuatro pasos, contigo en todos. Sin pasos secretos." steps={steps} />
        </div>
      </div>
    </div>
  </section>

  <section class="steps-act" aria-label="Cuatro pasos">
    <div class="act__inner">
      <MethodSteps steps={steps} />
    </div>
  </section>

  <section class="act nots-act" aria-labelledby="nots-title">
    <div class="act__inner">
      <div class="bloom grid-12">
        <p class="sec__name">Qué no hacemos</p>
        <div class="sec__body">
          <h2 id="nots-title" class="h2 head">También hay que decirlo.</h2>
          <ul class="nots">
            {
              nots.map((n) => (
                <li class="not">
                  <span class="not__mark">
                    <Icon name="x" />
                  </span>
                  <span class="h3">{n}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="act closing-act" aria-labelledby="cierre-title">
    <Strands class="closing__art" />
    <div class="act__inner grid-12 closing">
      <h2 id="cierre-title" class="display closing__title">El primer paso es hablar.</h2>
      <div class="closing__aside">
        <p class="lead">Cuéntanos qué te estorba. De ahí sale todo lo demás.</p>
        <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- la apertura: la promesa a toda escala, el pase a un lado -------------- */
  .opening {
    display: grid;
    align-content: center;
    min-height: 100svh;
  }
  .opening__top {
    align-items: center;
    row-gap: var(--space-6);
  }
  .opening__main {
    --col: 1 / span 7;
    gap: var(--space-5);
  }
  .opening__aside {
    --col: 8 / -1;
    margin-block-start: 0;
  }
  .promise {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-h2);
    font-weight: var(--weight-light);
  }
  .promise__end {
    font-size: var(--text-hero);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-hero);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .promise span {
      animation: promise-in var(--dur-5) var(--ease-out) backwards;
    }
    .promise__end {
      animation-delay: 140ms;
    }
  }
  @keyframes promise-in {
    from {
      opacity: 0;
      translate: 0 0.25em;
      filter: blur(10px);
    }
  }

  .steps-act {
    padding-block-end: var(--space-5);
  }

  /* --- la única señal de color de la página ---------------------------------- */
  .nots-act {
    padding-block-end: clamp(var(--space-7), 6vw, var(--space-9));
  }
  .bloom {
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border-radius: var(--radius-xl);
    background: var(--surface-lit);
    box-shadow: var(--shadow-glass);
  }
  .bloom .sec__name {
    color: var(--fg);
  }
  .nots {
    display: grid;
  }
  .not {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-4);
    padding-block: var(--space-4);
    text-wrap: pretty;
  }
  .not::before,
  .not::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 1px;
    background: rgb(var(--rgb-frost) / 0.22);
  }
  /* each line draws itself in as the row arrives */
  .not::after {
    background: rgb(var(--rgb-light) / 0.72);
    transform-origin: left center;
    transition: transform var(--dur-5) var(--ease-in-out);
  }
  .not.reveal::after {
    transform: scaleX(0);
  }
  .not.reveal.is-in::after {
    transform: none;
  }
  .not__mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-block-start: 0.0625rem;
    color: var(--white);
  }
  .not__mark :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .closing__title {
    font-weight: var(--weight-light);
  }
</style>
