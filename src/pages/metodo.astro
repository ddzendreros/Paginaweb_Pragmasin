---
import BaseLayout from "../layouts/BaseLayout.astro";

const stages = [
  {
    num: "01",
    name: "Medir",
    detail: [
      {
        q: "Qué hacemos",
        a: "Entrevistas, observación y datos reales. Contamos cuántas veces al mes ocurre cada proceso y cuánto tiempo consume cada vez. No preguntamos cuánto crees que tardas: lo medimos.",
      },
      {
        q: "Qué entregamos",
        a: "El mapa de tus horas, en una página. Proceso por proceso, con el tiempo manual medido y con tus datos, no con benchmarks.",
      },
      {
        q: "Qué necesitamos de ti",
        a: "Acceso a quien hace el trabajo. No a quien lo describe: a quien lo hace.",
      },
    ],
  },
  {
    num: "02",
    name: "Priorizar",
    detail: [
      {
        q: "Qué hacemos",
        a: "Cruzamos horas ahorradas contra esfuerzo de implementación. Qué automatizar primero, qué después y qué no vale la pena tocar.",
      },
      {
        q: "Qué entregamos",
        a: "Lista priorizada con horas estimadas de ahorro, costo y esfuerzo. Con números, no con adjetivos.",
      },
      {
        q: "Qué necesitamos de ti",
        a: "Una decisión. Para eso está hecha la lista.",
      },
    ],
  },
  {
    num: "03",
    name: "Construir",
    detail: [
      {
        q: "Qué hacemos",
        a: "Se implementa encima de los sistemas que ya tienes, se mide contra la línea base y se corrige. Los indicadores se acuerdan antes de empezar, para que nadie mueva la portería a medio partido.",
      },
      {
        q: "Qué entregamos",
        a: "El proceso funcionando en tu operación y el ahorro medido contra el punto de partida.",
      },
      {
        q: "Qué necesitamos de ti",
        a: "Un responsable de tu lado con poder de decisión.",
      },
    ],
  },
];

const notWeDo = [
  "Reportes de ochenta láminas que nadie abre dos veces.",
  "Recomendaciones sin responsable ni fecha.",
  "Facturar por estar sentados en tus juntas.",
  "Prometer plazos antes de entender el problema.",
  "Reemplazar el sistema que ya te está funcionando.",
  "Vender automatización donde no hay horas que recuperar.",
];
---

<BaseLayout
  title="El método — Pragmasyn"
  description="Medir, priorizar, construir: el método Pragmasyn completo, con entregables y responsables por etapa. Sin pasos secretos."
  ogTitle="Medir. Priorizar. Construir."
  ogDescription="El método completo, publicado: qué hacemos, qué entregamos y qué necesitamos de ti en cada etapa."
  path="/metodo"
>
  <section class="ground-dark act opening" aria-labelledby="method-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">El método</p>
        <h1 id="method-title" class="display">Medir. Priorizar. Construir.</h1>
        <p class="lead">
          Una empresa recién fundada no puede enseñarte logotipos de clientes.
          Puede enseñarte algo mejor: exactamente cómo va a trabajar tu
          operación. Este es el método completo, sin adornos ni pasos secretos.
        </p>
      </div>
    </div>
  </section>

  <section class="ground-light act stages" aria-label="Etapas del método">
    <div class="act__inner">
      <ol class="stages__list">
        {
          stages.map((s) => (
            <li class="card card--feature stage" data-reveal>
              <div class="stage__head">
                <span class="numeral stage__num" aria-hidden="true">
                  {s.num}
                </span>
                <h2 class="h3 stage__name">{s.name}</h2>
              </div>
              <dl class="stage__detail">
                {s.detail.map((d) => (
                  <div class="stage__pair">
                    <dt class="label">{d.q}</dt>
                    <dd class="small stage__answer">{d.a}</dd>
                  </div>
                ))}
              </dl>
              {s.num === "03" && (
                <p class="small stage__demo">
                  <a class="link link--arrow" href="/#demo">
                    Ve cómo se ve funcionando
                  </a>
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="ground-light act act--well not-we-do" aria-labelledby="not-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Qué no hacemos</p>
        <h2 id="not-title" class="h2">También hay que decirlo.</h2>
      </div>
      <ul class="not-we-do__list" data-reveal>
        {notWeDo.map((item) => <li class="not-we-do__item">{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="ground-dark act closing" aria-labelledby="closing-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <h2 id="closing-title" class="display-2">
          El método empieza igual siempre: midiendo.
        </h2>
        <p class="lead">
          Cinco días, precio fijo, una automatización funcionando al final.
        </p>
        <a class="btn btn--primary closing__cta" href="/contacto">Agendar el diagnóstico</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .opening {
    padding-block: clamp(var(--space-8), 10vw, var(--space-10));
  }
  .stages__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gutter);
  }
  .stage {
    display: grid;
    gap: var(--space-6) var(--space-8);
  }
  @media (min-width: 64rem) {
    .stage {
      grid-template-columns: minmax(9rem, 1fr) 4fr;
      align-items: start;
    }
  }
  .stage__num {
    color: var(--interactive);
    font-size: var(--text-h4);
    font-weight: var(--weight-strong);
  }
  .stage__name {
    margin-top: var(--space-2);
  }
  .stage__detail {
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .stage__detail {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--gutter);
    }
  }
  .stage__pair {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--hairline-color);
  }
  .stage__answer {
    margin: 0;
  }
  .stage__demo {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--hairline) solid var(--hairline-color);
  }
  @media (min-width: 64rem) {
    .stage__demo {
      grid-column: 2 / -1;
    }
  }

  .not-we-do__list {
    list-style: none;
    margin: var(--space-8) auto 0;
    padding: 0;
    max-width: var(--measure-wide);
  }
  .not-we-do__item {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-top: var(--hairline) solid var(--hairline-color);
  }
  /* el "no" es tipográfico: se tacha antes de que preguntes */
  .not-we-do__item::before {
    content: "✕";
    color: var(--fg-muted-ui);
    font-weight: var(--weight-strong);
  }

  .closing {
    padding-block: clamp(var(--space-9), 10vw, var(--space-11));
  }
  .closing__cta {
    margin-top: var(--space-4);
  }
</style>
