---
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  {
    num: "01",
    name: "Escuchar",
    rows: [
      [
        "Qué hacemos",
        "Hablamos contigo y con quien hace el trabajo. Queremos ver cómo opera tu negocio hoy, no cómo se supone que opera.",
      ],
      ["Qué recibes", "El problema y lo que vamos a construir, en una página."],
      [
        "Qué necesitamos de ti",
        "Acceso a quien hace el trabajo. No a quien lo describe: a quien lo hace.",
      ],
    ],
  },
  {
    num: "02",
    name: "Diseñar",
    rows: [
      [
        "Qué hacemos",
        "Dibujamos las pantallas y el flujo antes de programar. Cambiar un dibujo no cuesta nada.",
      ],
      ["Qué recibes", "Las pantallas, el alcance y el costo, por escrito."],
      ["Qué necesitamos de ti", "Una decisión. Para eso está hecho."],
    ],
  },
  {
    num: "03",
    name: "Construir",
    rows: [
      [
        "Qué hacemos",
        "Programamos por partes. Ves y pruebas cada avance, y lo ajustamos contigo.",
      ],
      ["Qué recibes", "Software funcionando en tu operación, no una presentación."],
      ["Qué necesitamos de ti", "Una persona de tu lado que pueda decidir."],
    ],
  },
  {
    num: "04",
    name: "Acompañar",
    rows: [
      ["Qué hacemos", "Capacitamos a tu equipo y seguimos cerca después de entregar."],
      ["Qué recibes", "Tu equipo usando el sistema y un canal directo con nosotros."],
      ["Qué necesitamos de ti", "Que nos digas qué no está funcionando."],
    ],
  },
];

const columns = ["Qué hacemos", "Qué recibes", "Qué necesitamos de ti"];

const nots = [
  "Reportes de ochenta láminas que nadie abre dos veces.",
  "Facturar por estar sentados en tus juntas.",
  "Prometer plazos antes de entender el problema.",
  "Venderte un paquete que te obliga a cambiar tu forma de trabajar.",
  "Construir algo que no necesitas.",
  "Desaparecer después de entregar.",
];
---

<BaseLayout
  title="Cómo trabajamos — Pragmasyn"
  description="Escuchar, diseñar, construir y acompañar. Qué hacemos, qué recibes y qué necesitamos de ti en cada paso. Sin pasos secretos."
  ogTitle="Lo que se decide, se entrega."
  ogDescription="Cuatro pasos, contigo en todos. Qué hacemos, qué recibes y qué necesitamos de ti."
  path="/metodo"
>
  <section class="opening" aria-labelledby="metodo-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <p class="label">Cómo trabajamos</p>
          <h1 id="metodo-title" class="display">Lo que se decide, se entrega.</h1>
        </div>
        <div class="opening__aside">
          <p class="lead">Cuatro pasos, contigo en todos. Sin pasos secretos.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="steps-act" aria-label="Cuatro pasos">
    <div class="act__inner">
      <table class="steps">
        <thead>
          <tr>
            <td></td>
            {columns.map((c) => <th scope="col">{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            steps.map((s) => (
              <tr>
                <th scope="row">
                  <span class="caption numeral">{s.num}</span>
                  <span class="h3 steps__name">{s.name}</span>
                </th>
                {s.rows.map(([label, text]) => (
                  <td data-label={label}>{text}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="ground-dark act" aria-labelledby="nots-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Qué no hacemos</p>
      <div class="sec__body">
        <h2 id="nots-title" class="h2 head">También hay que decirlo.</h2>
        <ul class="nots">
          {nots.map((n) => <li class="not h3">{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="ground-cobalt act" aria-labelledby="cierre-title">
    <div class="act__inner grid-12 closing">
      <h2 id="cierre-title" class="display closing__title">El primer paso es hablar.</h2>
      <div class="closing__aside">
        <p class="lead">Cuéntanos qué te estorba. De ahí sale todo lo demás.</p>
        <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .steps-act {
    padding-block-end: clamp(var(--space-8), 8vw, var(--space-10));
  }
  .steps {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .steps thead th {
    padding-block-end: var(--space-3);
    text-align: start;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--fg-secondary);
  }
  .steps thead td {
    width: 17%;
  }
  .steps tbody th,
  .steps tbody td {
    padding: var(--space-5) var(--gutter) var(--space-6) 0;
    text-align: start;
    vertical-align: top;
    font-weight: var(--weight-text);
    border-block-start: var(--hairline) solid var(--hairline-color);
    text-wrap: pretty;
  }
  .steps tbody tr:last-child th,
  .steps tbody tr:last-child td {
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .steps tbody td:last-child {
    padding-inline-end: 0;
  }
  .steps tbody th span {
    display: block;
  }
  .steps__name {
    margin-block-start: var(--space-1);
  }
  /* each step stacks on a phone: the column names travel with the text */
  @media (width <= 56rem) {
    .steps thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .steps,
    .steps tbody,
    .steps tr,
    .steps tbody th,
    .steps tbody td {
      display: block;
      width: 100%;
    }
    .steps tr {
      padding-block: var(--space-5);
      border-block-start: var(--hairline) solid var(--hairline-color);
    }
    .steps tbody th,
    .steps tbody td {
      padding: 0;
      border: 0;
    }
    .steps tbody tr:last-child th,
    .steps tbody tr:last-child td {
      border: 0;
    }
    .steps tbody td {
      margin-block-start: var(--space-3);
    }
    .steps tbody td::before {
      content: attr(data-label);
      display: block;
      font-size: var(--text-small);
      font-weight: var(--weight-medium);
      color: var(--fg-secondary);
    }
  }

  .nots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .not {
    padding-block: var(--space-4);
    border-block-start: var(--hairline) solid var(--hairline-color);
    text-wrap: pretty;
  }
  @media (width <= 40rem) {
    .nots {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
