---
import Configurator from "../components/Configurator.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { waMessages, whatsappUrl } from "../site";

const contrast: [string, string][] = [
  [
    "Cambias tu proceso para que quepa en sus pantallas.",
    "El sistema sigue tu proceso, con tus nombres y tus pasos.",
  ],
  ["Pagas cada mes por usuario, aunque uses la mitad.", "Pagas una sola vez por construirlo."],
  [
    "Lo que le falta se queda en un Excel aparte.",
    "Lo que hoy vive en tres Excels queda en un solo lugar.",
  ],
  ["Si dejas de pagar, pierdes el acceso.", "El software es tuyo."],
];

const builds: [string, string][] = [
  [
    "Reemplazar un SaaS que te sale caro",
    "Nos dices qué usas de verdad y construimos eso. Sin las funciones que pagas y nunca abres.",
  ],
  [
    "Automatizar lo que se repite",
    "Lo que alguien hace igual cada semana lo puede hacer el sistema.",
  ],
  [
    "Conectar lo que no se habla",
    "Tu Excel, tu banco, WhatsApp y tus sistemas, con el mismo dato.",
  ],
  [
    "Darles a tus clientes su propio portal",
    "Pedidos, citas y estados de cuenta, sin que tengan que llamarte.",
  ],
  ["Ver tu negocio en una pantalla", "Las cifras que te importan, al día, sin armar reportes."],
  ["Una app para tu equipo", "Para el piso, la ruta o la sucursal. Hecha para como trabajan."],
];

// `from` and `to` place each bar on the project's timeline, in percent. Bars
// that reach 100 run off the edge of the page: that support has no end date.
const accompaniment = [
  {
    title: "Hablas con quien lo construye",
    text: "Un canal directo, sin intermediarios ni tickets.",
    from: 0,
    to: 100,
  },
  {
    title: "Ves el avance mientras se hace",
    text: "Pruebas el software desde temprano y lo corregimos contigo.",
    from: 22,
    to: 62,
  },
  {
    title: "Tu equipo aprende a usarlo",
    text: "Capacitamos a quienes lo van a usar todos los días.",
    from: 46,
    to: 78,
  },
  {
    title: "Seguimos después de entregar",
    text: "Si algo falla o tu operación cambia, aquí estamos.",
    from: 62,
    to: 100,
  },
];

const ownership: [string, string][] = [
  ["Pago", "Único"],
  ["Dueño del software", "Tu empresa"],
  ["Renta por usuario", "No hay"],
  ["Funciones que no usas", "Ninguna"],
];

// Cases need the client's permission (D7). None are approved, so none ship:
// with the list empty the section does not exist in the HTML.
interface Case {
  sector: string;
  before: string;
  built: string;
  after: string;
}
const cases: Case[] = [];

const faq: [string, string][] = [
  [
    "¿Cuánto cuesta?",
    "Depende de lo que haya que construir. Primero entendemos qué necesitas. Después te decimos cuánto cuesta y qué incluye, por escrito, antes de que firmes nada.",
  ],
  [
    "¿Cuánto tarda?",
    "No prometemos fechas antes de entender el problema. Cuando lo entendemos, te damos un plazo y te enseñamos avances desde el principio.",
  ],
  [
    "¿Necesito saber de tecnología?",
    "No. Tú conoces tu negocio. Nosotros nos encargamos de lo técnico y te lo explicamos sin rodeos.",
  ],
  [
    "¿Y si ya uso un SaaS o un sistema?",
    "Lo revisamos contigo. Si te conviene conservarlo, lo conectamos. Si te conviene dejarlo, construimos el reemplazo y te ayudamos a mover tu información.",
  ],
  ["¿De quién es el software?", "Tuyo. Pagas una vez y es de tu empresa."],
  [
    "¿Van a contar que trabajamos juntos?",
    "No. No publicamos nombres ni logotipos de clientes.",
  ],
  [
    "¿Es para una empresa chica?",
    "Sí. Trabajamos con PyMEs de cualquier tamaño y giro.",
  ],
];

const waHref = whatsappUrl(waMessages.flotante);
---

<BaseLayout
  title="Pragmasyn — Software a la medida para PyMEs en México"
  description="Diseñamos y construimos software y automatizaciones a la medida de tu negocio. Te acompañamos en todo el camino. Pagas una vez y es tuyo."
  ogTitle="Deja de adaptarte a tu software."
  ogDescription="Software y automatización a la medida para PyMEs. Con tus procesos, tus nombres y tus reglas."
  path="/"
>
  <section class="opening hero" id="diagnostico" aria-labelledby="hero-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <h1 id="hero-title" class="display hero__title">
            Deja de adaptarte<br class="hero__br" /> a tu software.
          </h1>
        </div>
        <div class="opening__aside">
          <p class="lead">
            Diseñamos y construimos el software que tu negocio necesita, con tus procesos, tus
            nombres y tus reglas. Te acompañamos en todo el camino. Cuando terminamos, es tuyo.
          </p>
          <div class="actions">
            <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
            <a class="btn btn--secondary" href="#construir">Ver qué construimos</a>
          </div>
        </div>
      </div>
      <Configurator />
    </div>
  </section>

  <section class="ground-cobalt act" aria-labelledby="contraste-title">
    <div class="act__inner grid-12">
      <p class="sec__name">El problema</p>
      <div class="sec__body">
        <h2 id="contraste-title" class="h2 head">Un SaaS te pide que cambies. Nosotros no.</h2>
        <table class="contrast">
          <thead>
            <tr>
              <th scope="col">Con software genérico</th>
              <th scope="col">Con software a tu medida</th>
            </tr>
          </thead>
          <tbody>
            {
              contrast.map(([generic, custom]) => (
                <tr>
                  <td data-label="Con software genérico">{generic}</td>
                  <td data-label="Con software a tu medida">{custom}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="act" id="construir" aria-labelledby="construir-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Qué construimos</p>
      <div class="sec__body">
        <div class="head">
          <h2 id="construir-title" class="h2">Si hoy te estorba, se puede construir.</h2>
          <p class="lead">
            No tenemos catálogo. Estos son puntos de partida; lo tuyo puede no parecerse a ninguno.
          </p>
        </div>
        <ul>
          {
            builds.map(([title, text]) => (
              <li class="spec__row">
                <h3 class="h3">{title}</h3>
                <p class="spec__text">{text}</p>
              </li>
            ))
          }
        </ul>
        <p class="build__more">
          <a class="link link--plain" href="/contacto">¿No ves lo tuyo? Mejor. Cuéntanos.</a>
        </p>
      </div>
    </div>
  </section>

  <section class="act company" aria-labelledby="acomp-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Acompañamiento</p>
      <div class="sec__body head">
        <h2 id="acomp-title" class="h2">No desaparecemos después de entregar.</h2>
        <p class="lead">Lo importante no es el software. Es que tu día a día se sienta mejor.</p>
      </div>
      <div class="track-wrap">
        <ol>
          {
            accompaniment.map((a, i) => (
              <li class="track__row">
                <div class="track__text">
                  <h3 class="h3">{a.title}</h3>
                  <p class="small">{a.text}</p>
                </div>
                <div class="track__lane" aria-hidden="true">
                  {i === 0 && <span class="track__mark">Entrega</span>}
                  <span
                    class:list={["track__bar", { "track__bar--open": a.to === 100 }]}
                    style={`--from: ${a.from}; --to: ${a.to};`}
                  />
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="ground-dark act" aria-labelledby="tuyo-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Propiedad</p>
      <div class="sec__body">
        <div class="head">
          <h2 id="tuyo-title" class="display">Se paga una vez.<br /> Y es tuyo.</h2>
          <p class="lead">
            Sin renta mensual por usuario. Sin contratos que te amarren. Lo que construimos para tu
            empresa es de tu empresa.
          </p>
        </div>
        <dl class="own">
          {
            ownership.map(([concept, value]) => (
              <div class="own__cell">
                <dt class="small">{concept}</dt>
                <dd class="h3">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {
    cases.length > 0 && (
      <section class="act cases" aria-labelledby="casos-title">
        <div class="act__inner grid-12">
          <p class="sec__name">Casos</p>
          <div class="sec__body">
            <div class="head">
              <h2 id="casos-title" class="h2">Tu operación no aparece en nuestro sitio.</h2>
              <p class="lead">
                Por eso aquí no hay logotipos. Contamos lo que hicimos sin decir para quién.
              </p>
            </div>
            <ul class="cases__list">
              {cases.map((c) => (
                <li class="cases__item">
                  <dl>
                    <div>
                      <dt class="label">Giro y tamaño aproximado</dt>
                      <dd>{c.sector}</dd>
                    </div>
                    <div>
                      <dt class="label">Qué pasaba</dt>
                      <dd>{c.before}</dd>
                    </div>
                    <div>
                      <dt class="label">Qué construimos</dt>
                      <dd>{c.built}</dd>
                    </div>
                    <div>
                      <dt class="label">Qué cambió</dt>
                      <dd>{c.after}</dd>
                    </div>
                  </dl>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="act" aria-labelledby="faq-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Preguntas</p>
      <div class="sec__body">
        <h2 id="faq-title" class="h2 head">Lo que conviene saber antes de empezar.</h2>
        <div class="faq">
          {
            faq.map(([question, answer]) => (
              <details class="qa">
                <summary class="qa__q">
                  <span class="h3">{question}</span>
                  <span class="qa__icon" aria-hidden="true" />
                </summary>
                <p class="qa__a">{answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="ground-cobalt act" aria-labelledby="cierre-title">
    <div class="act__inner grid-12 closing">
      <h2 id="cierre-title" class="display closing__title">¿Qué te gustaría dejar de hacer?</h2>
      <div class="closing__aside">
        <p class="lead">
          Cuéntanoslo como te salga. Te contesta una persona y te decimos con honestidad si te
          podemos ayudar.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
          {
            waHref && (
              <a class="btn btn--secondary" href={waHref} target="_blank" rel="noopener">
                Escribir por WhatsApp
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* the break stays at every width so the title never strands a lone "a" */
  .hero__br {
    display: block;
  }
  .hero {
    padding-block-end: var(--space-7);
    overflow-x: clip;
  }

  /* --- El problema -------------------------------------------------------- */
  .contrast {
    width: 100%;
    border-collapse: collapse;
    text-align: start;
  }
  .contrast th {
    padding-block-end: var(--space-3);
    text-align: start;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--fg-secondary);
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .contrast td {
    width: 50%;
    padding: var(--space-4) var(--space-6) var(--space-4) 0;
    vertical-align: top;
    border-block-end: var(--hairline) solid var(--hairline-color);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    letter-spacing: var(--tracking-lead);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }
  .contrast td:last-child {
    padding-inline-end: 0;
    color: var(--fg);
    font-weight: var(--weight-medium);
  }
  @media (width <= 40rem) {
    .contrast thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .contrast,
    .contrast tbody,
    .contrast tr,
    .contrast td {
      display: block;
      width: 100%;
    }
    .contrast tr {
      padding-block: var(--space-4);
      border-block-end: var(--hairline) solid var(--hairline-color);
    }
    .contrast td {
      padding: 0;
      border: 0;
    }
    .contrast td + td {
      margin-block-start: var(--space-3);
    }
    .contrast td::before {
      content: attr(data-label);
      display: block;
      font-size: var(--text-caption);
      font-weight: var(--weight-text);
      color: var(--fg-secondary);
    }
  }

  /* --- Qué construimos ---------------------------------------------------- */
  .build__more {
    margin-block-start: var(--space-4);
  }

  /* --- Acompañamiento: un cronograma, no una lista ------------------------ */
  .company {
    --handoff: 62%;
    background: var(--bg-chrome);
    overflow-x: clip;
  }
  .company .sec__body {
    margin-block-end: var(--space-5);
  }
  .track-wrap {
    padding-block-start: var(--space-5);
  }
  .track__row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--gutter);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .track__row:last-child {
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .track__text {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
  }
  .track__text .small {
    max-width: 44ch;
    text-wrap: pretty;
  }
  /* the lane runs to the edge of the window so an open bar has no end */
  .track__lane {
    position: relative;
    margin-inline-end: calc(-1 * max(var(--margin), (100vw - var(--content-max)) / 2 + var(--margin)));
  }
  .track__lane::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--handoff);
    border-inline-start: var(--hairline) solid var(--control-border);
  }
  .track__bar {
    position: absolute;
    inset-block-start: calc(var(--space-5) + 0.3rem);
    inset-inline-start: calc(var(--from) * 1%);
    width: calc((var(--to) - var(--from)) * 1%);
    height: 1rem;
    background: var(--interactive);
    border-radius: var(--radius-s);
  }
  .track__bar--open {
    border-start-end-radius: 0;
    border-end-end-radius: 0;
  }
  .track__mark {
    position: absolute;
    inset-block-end: calc(100% + var(--space-1));
    inset-inline-start: var(--handoff);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    color: var(--fg-secondary);
    translate: -50% 0;
  }
  @media (width <= 56rem) {
    .track__row {
      grid-template-columns: minmax(0, 1fr);
      padding-block-end: var(--space-4);
    }
    .track__text {
      padding-block-end: var(--space-3);
    }
    .track__lane {
      height: 1rem;
    }
    .track__bar {
      inset-block-start: 0;
    }
    /* on a phone the text sits above the bar, so the label goes under it */
    .track__mark {
      inset-block-end: auto;
      inset-block-start: calc(100% + var(--space-1));
    }
    .track__row:first-child {
      padding-block-end: var(--space-6);
    }
  }

  /* --- Propiedad ----------------------------------------------------------- */
  .own {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .own__cell {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) 0 0;
  }
  .own__cell + .own__cell {
    padding-inline-start: var(--space-4);
    border-inline-start: var(--hairline) solid var(--hairline-color);
  }
  @media (width <= 56rem) {
    .own {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .own__cell,
    .own__cell + .own__cell {
      padding: var(--space-4) var(--space-3) var(--space-4) 0;
      border-inline-start: 0;
    }
    .own__cell:nth-child(even) {
      padding-inline-start: var(--space-3);
      border-inline-start: var(--hairline) solid var(--hairline-color);
    }
    .own__cell:nth-child(n + 3) {
      border-block-start: var(--hairline) solid var(--hairline-color);
    }
  }

  /* --- Casos (solo con contenido autorizado) ------------------------------ */
  .cases__list {
    display: grid;
    gap: var(--space-6);
  }
  .cases__item {
    padding-block-start: var(--space-5);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .cases__item dl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gutter);
  }
  .cases__item dd {
    margin-block-start: var(--space-2);
  }
  @media (width <= 56rem) {
    .cases__item dl {
      grid-template-columns: 1fr;
    }
  }

  /* --- Preguntas ------------------------------------------------------------ */
  .faq {
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .qa {
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 44px;
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
  }
  .qa__q::-webkit-details-marker {
    display: none;
  }
  .qa__q:hover {
    color: var(--interactive);
  }
  /* the plus is drawn, not typed */
  .qa__icon {
    position: relative;
    flex: none;
    width: var(--space-4);
    height: var(--space-4);
    transition: rotate var(--dur-2) var(--ease-out);
  }
  .qa__icon::before,
  .qa__icon::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    border-block-start: var(--hairline-strong) solid currentColor;
    translate: 0 -50%;
  }
  .qa__icon::after {
    rotate: 90deg;
  }
  .qa[open] .qa__icon {
    rotate: 45deg;
  }
  .qa__a {
    max-width: var(--measure);
    padding-block-end: var(--space-5);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }
</style>
