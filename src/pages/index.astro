---
import BaseLayout from "../layouts/BaseLayout.astro";
import Calculator from "../components/Calculator.astro";
import Demo from "../components/Demo.astro";

// El auto-diagnóstico. Cada renglón calibrado al segmento (BRIEF v3 §5.3):
// tiene que provocar un "sí, eso mismo". No se agregan inventados.
const manualWork = [
  "Capturar facturas de proveedor que llegan en PDF o por correo",
  "Pasar pedidos de WhatsApp al sistema",
  "Armar el reporte de ventas del lunes en Excel",
  "Revisar a mano que la factura coincida con la orden de compra",
  "Copiar datos de un sistema a otro porque no se hablan",
  "Contestar las mismas cinco preguntas de clientes todos los días",
  "Perseguir cotizaciones y aprobaciones por correo",
  "Sacar cifras del sistema para meterlas a otro Excel",
  "Registrar asistencia en papel o en hoja de cálculo",
  "Clasificar, nombrar y archivar documentos",
];

// Cuatro productos con precio visible. IVA se anuncia una sola vez al pie.
const products = [
  {
    name: "Diagnóstico de Horas Recuperables",
    launch: "$45,000",
    price: "$75,000",
    unit: "cinco días",
    text: "Medimos dónde se van las horas, priorizamos qué automatizar y dejamos una automatización corriendo.",
  },
  {
    name: "Facturas de proveedor que entran solas",
    launch: null,
    price: "desde $85,000",
    unit: "implementación",
    text: "PDF y correo → tu sistema, con validación contra la orden de compra.",
  },
  {
    name: "Pedidos de WhatsApp al sistema",
    launch: null,
    price: "desde $95,000",
    unit: "implementación",
    text: "Mensaje desordenado → pedido estructurado, con contexto del cliente.",
  },
  {
    name: "El reporte que se arma solo",
    launch: null,
    price: "desde $60,000",
    unit: "implementación",
    text: "Datos de varios lados → el reporte, sin que nadie lo arme.",
  },
];

const territory = [
  {
    name: "Lo que llega sin forma",
    text: "PDFs, WhatsApp, correos, fotos, notas de voz, papel. La IA lo lee, lo estructura y lo deja donde va.",
  },
  {
    name: "Lo que pide criterio",
    text: "Conciliar cuando los números no cuadran exacto. Detectar lo que se sale de lo normal. Cachar el error antes de contabilidad.",
  },
  {
    name: "Lo que no se habla entre sí",
    text: "Tu ERP, tu Excel, tu banco, el SAT, el portal de tu cliente. Los conectamos sin migrar nada.",
  },
];

// Transitorio Segundo de la reforma a la LFT (DOF 1 de mayo de 2026).
// Las cifras están verificadas en el brief §11: no se tocan sin re-verificar.
const journey = [
  { year: "2026", hours: "48" },
  { year: "2027", hours: "46" },
  { year: "2028", hours: "44" },
  { year: "2029", hours: "42" },
  { year: "2030", hours: "40" },
];

const method = [
  {
    num: "01",
    name: "Medir",
    text: "Entrevistas, observación y datos reales para cuantificar cuántas horas consume cada proceso hoy.",
    deliverable: "El mapa de tus horas, en una página.",
  },
  {
    num: "02",
    name: "Priorizar",
    text: "Qué automatizar primero, qué después y qué no vale la pena tocar. Con costo y esfuerzo reales.",
    deliverable: "Lista priorizada, con horas estimadas de ahorro.",
  },
  {
    num: "03",
    name: "Construir",
    text: "Se implementa, se mide contra la línea base y se corrige. Indicadores acordados antes de empezar.",
    deliverable: "El proceso funcionando y el ahorro medido.",
  },
];

// FAQ del brief v3 §5.10. La pregunta "¿Se salen mis datos?" queda fuera
// hasta que el fundador defina la respuesta con la arquitectura real.
const faq = [
  {
    q: "Mi sistema ya trae inteligencia artificial. ¿Para qué los necesito?",
    a: "La IA de tu sistema trabaja sobre lo que ya está capturado. El PDF que sigue en el correo, la foto que mandó el chofer y el mensaje de WhatsApp todavía no están capturados. Ese es exactamente el trabajo que hoy hace una persona, y es donde entramos.",
  },
  {
    q: "¿Esto reemplaza a quien me implementó el sistema?",
    a: "No. No tocamos tu sistema, no migramos nada y no competimos por ese trabajo. A quien te lo implementó le conviene: le llega ordenado lo que antes le llegaba en desorden.",
  },
  {
    q: "¿Por qué no lo hago con Make o Zapier?",
    a: "Esas herramientas mueven datos que ya están ordenados, entre sistemas que ya se hablan entre sí. No leen un PDF escaneado, no deciden si la factura coincide con la orden de compra y no saben qué hacer cuando algo no cuadra. Y alguien las tiene que construir y mantener.",
  },
  {
    q: "¿Qué pasa si no encuentran horas suficientes?",
    a: "Si al quinto día no encontramos al menos 80 horas al mes recuperables, te lo decimos y no cobramos. Preferimos eso a venderte un proyecto que no necesitas.",
  },
  {
    q: "¿Cuánto tiempo de mi gente ocupa el diagnóstico?",
    a: "Seis horas en total, repartidas en cinco días. Necesitamos hablar con quien hace el trabajo, no con quien lo describe. El resto lo hacemos nosotros.",
  },
];
---

<BaseLayout
  title="Pragmasyn — Lo que hoy se captura a mano puede entrar solo"
  description="Facturas en PDF, pedidos por WhatsApp, el reporte del lunes. Medimos cuántas horas al mes te cuesta y hacemos que entren solas — sobre el sistema que ya tienes."
  ogTitle="Alguien en tu empresa teclea lo que ya venía escrito."
  ogDescription="Facturas en PDF, pedidos por WhatsApp, el reporte del lunes. Lo que se hace a mano puede entrar solo. Diagnóstico de 5 días, precio fijo."
  path="/"
>
  <!-- 1 · Hero — H1 sin data-reveal para no romper el LCP -->
  <section class="ground-dark act hero" aria-labelledby="hero-title">
    <div class="act__inner hero__inner">
      <p class="label eyebrow" data-reveal>Automatización operativa con IA</p>
      <h1 id="hero-title" class="display hero__title">
        Alguien en tu empresa teclea lo que ya venía escrito.
      </h1>
      <p class="lead hero__lead" data-reveal>
        Facturas en PDF, pedidos por WhatsApp, el reporte del lunes. Medimos
        cuántas horas al mes te cuesta y hacemos que entren solas. Sobre el
        sistema que ya tienes.
      </p>
      <div class="actions actions--center hero__actions" data-reveal>
        <a class="btn btn--primary" href="#demo">Ver cómo funciona</a>
        <a class="btn btn--secondary" href="/calculadora">Calcular mis horas</a>
      </div>
      <p class="caption hero__etym" data-reveal>
        <span class="serif-italic" lang="grc">πρᾶγμα</span> — hecho realizado ·
        <span class="serif-italic" lang="grc">σύν</span> — junto con. El nombre es
        la promesa: síntesis pragmática.
      </p>
    </div>
  </section>

  <!-- 2 · Demo — el corazón del sitio -->
  <section class="ground-dark act act--well demo-wrap">
    <Demo />
  </section>

  <!-- 3 · Auto-diagnóstico -->
  <section class="ground-light act check" id="a-mano" aria-labelledby="check-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">El costo invisible</p>
        <h2 id="check-title" class="h2">¿Qué sigues haciendo a mano?</h2>
        <p class="lead">Nadie lo tiene medido. Por eso nadie lo arregla.</p>
      </div>

      <div class="card check__card" data-reveal>
        <ul class="check__list" data-check-list>
          {
            manualWork.map((item, i) => (
              <li class="check__row">
                <label class="check__label">
                  <input class="check__input" type="checkbox" value={String(i)} />
                  <span class="check__box" aria-hidden="true" />
                  <span class="check__text">{item}</span>
                </label>
              </li>
            ))
          }
        </ul>

        <div class="check__summary" data-check-summary hidden>
          <p class="check__count">
            <span class="numeral check__count-num" data-check-count>0</span>
            <span class="small">de {manualWork.length} marcados</span>
          </p>
          <p class="small check__verdict" data-check-verdict role="status" aria-live="polite">
            Marca lo que reconozcas de tu operación.
          </p>
        </div>

        <div class="check__handoff" data-check-handoff hidden>
          <a class="btn btn--primary btn--sm" href="/calculadora">
            Ponle número a esto
          </a>
        </div>
      </div>

      <p class="body check__close" data-reveal>
        Si marcaste tres o más, tienes entre 40 y 120 horas al mes en la mesa.
        No es una estimación de venta: es lo que medimos en el diagnóstico,
        con tus datos.
      </p>
    </div>
  </section>

  <!-- 4 · Calculadora en línea -->
  <section class="ground-light act act--well calc-embed">
    <div class="act__inner calc-embed__inner" data-reveal>
      <Calculator variant="compact" id="calc-home" />
    </div>
  </section>

  <!-- 5 · Qué compras exactamente -->
  <section class="ground-dark act products" id="precios" aria-labelledby="products-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Precio visible</p>
        <h2 id="products-title" class="h2">Qué compras exactamente.</h2>
        <p class="lead">
          Cosas comprables con precio publicado. No propuestas de sesenta
          páginas.
        </p>
      </div>

      <ul class="products__list">
        {
          products.map((p) => (
            <li class="card card--feature product" data-reveal>
              <div class="product__price-row">
                {p.launch && (
                  <p class="product__price-strike">
                    <span class="small">estándar</span>
                    <span class="numeral product__strike">{p.price}</span>
                  </p>
                )}
                <p class="product__price">
                  {p.launch ? (
                    <>
                      <span class="small product__price-label">lanzamiento</span>
                      <span class="numeral product__price-num">{p.launch}</span>
                    </>
                  ) : (
                    <span class="numeral product__price-num">{p.price}</span>
                  )}
                </p>
                <p class="caption product__unit">{p.unit}</p>
              </div>
              <div class="product__body">
                <h3 class="h4 product__name">{p.name}</h3>
                <p class="small product__text">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="caption products__iva" data-reveal>Todos los precios + IVA.</p>

      <div class="products__notes">
        <aside class="card products__credit" data-reveal>
          <p class="label">Se acredita</p>
          <p class="body">
            El diagnóstico se acredita al 100% contra cualquiera de los otros
            tres si contratas dentro de los 30 días siguientes.
          </p>
        </aside>

        <aside class="card products__launch" data-reveal>
          <p class="label">Por qué $45,000 y no $75,000</p>
          <p class="body">
            Estamos documentando nuestros primeros tres casos. El precio de
            lanzamiento es a cambio de poder publicar el resultado —con el
            nombre de tu empresa o sin él, tú decides. Cuando los tres estén
            cerrados, el precio es $75,000.
          </p>
        </aside>

        <aside class="card card--feature products__guarantee" data-reveal>
          <p class="label">Garantía</p>
          <p class="body">
            Si al quinto día no encontramos al menos 80 horas al mes
            recuperables, no cobramos el diagnóstico.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 6 · Territorio + "Lo que no tocamos" -->
  <section class="ground-light act territory" aria-labelledby="territory-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Dónde entramos</p>
        <h2 id="territory-title" class="h2">No tocamos lo que ya funciona.</h2>
        <p class="lead">
          Tu ERP ordena lo que ya está capturado: cotizaciones, órdenes,
          inventario, contabilidad. Eso ya está resuelto y no venimos a
          moverlo.
        </p>
        <p class="lead">
          El problema vive afuera. En lo que llega en desorden y alguien tiene
          que ordenar a mano antes de que el sistema lo pueda usar.
        </p>
      </div>

      <ul class="cards territory__list">
        {
          territory.map((t) => (
            <li class="card territory__item" data-reveal>
              <h3 class="h4">{t.name}</h3>
              <p class="small territory__text">{t.text}</p>
            </li>
          ))
        }
      </ul>

      <aside class="card card--feature territory__not" data-reveal>
        <p class="label territory__not-label">Y sobre todo</p>
        <h3 class="h3 territory__not-title">Lo que no tocamos.</h3>
        <p class="body">
          Trabajamos sobre el sistema que ya tienes, sea cual sea. No lo
          cambiamos, no lo migramos y no competimos con quien te lo implementó.
          Lo que ya invertiste se aprovecha, no se tira.
        </p>
      </aside>
    </div>
  </section>

  <!-- 7 · Reforma -->
  <section class="ground-dark act act--well reform" aria-labelledby="reform-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">El calendario ya corre</p>
        <h2 id="reform-title" class="h2">
          La reforma no te pide horas extra. Te pide operar distinto.
        </h2>
        <p class="lead">
          La jornada laboral baja por ley. El salario no baja. La carga de
          trabajo tampoco.
        </p>
      </div>

      <ol class="reform__scale" data-reveal>
        {
          journey.map((j) => (
            <li class="reform__step">
              <span class="caption reform__year">{j.year}</span>
              <span class="numeral reform__hours">{j.hours}</span>
              <span class="caption reform__unit">horas</span>
            </li>
          ))
        }
      </ol>

      <div class="card card--feature reform__note" data-reveal>
        <p class="body">
          Y desde el 1 de enero de 2027, el registro electrónico de jornada es
          obligatorio. Cuando ese registro exista, vas a tener por primera vez
          el dato exacto de cuántas horas consume cada proceso. La pregunta es
          si llegas a esa fecha con un plan o con un problema.
        </p>
        <p class="body reform__close">
          La ventana para ajustar procesos es este año. Después ya no es
          planeación, es reacción.
        </p>
        <p class="caption reform__disclaimer">
          Contexto de negocio, no asesoría legal. La interpretación jurídica
          la da tu abogado laboral.
        </p>
      </div>
    </div>
  </section>

  <!-- 8 · Método -->
  <section class="ground-light act method" aria-labelledby="method-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Cómo trabajamos</p>
        <h2 id="method-title" class="h2">El método es el producto.</h2>
        <p class="lead">
          No vendemos horas ni presentaciones. Vendemos el camino corto entre
          un proceso manual y un proceso que corre solo.
        </p>
      </div>

      <ol class="cards method__list">
        {
          method.map((m) => (
            <li class="card method__item" data-reveal>
              <span class="numeral method__num" aria-hidden="true">
                {m.num}
              </span>
              <h3 class="h3 method__name">{m.name}</h3>
              <p class="small method__text">{m.text}</p>
              <p class="small method__deliverable">
                <strong class="method__deliverable-label">Entregable</strong>
                {m.deliverable}
              </p>
            </li>
          ))
        }
      </ol>

      <p class="body method__more" data-reveal>
        <strong>Sin pasos secretos:</strong> el método completo está publicado.
        Qué hacemos, qué entregamos y qué necesitamos de ti en cada etapa.
        <a class="link link--arrow method__link" href="/metodo">El método completo</a>
      </p>
    </div>
  </section>

  <!-- 9 · Identidad -->
  <section class="ground-light act act--well identity" aria-labelledby="identity-title">
    <div class="act__inner">
      <div class="act__head identity__head" data-reveal>
        <p class="label eyebrow">Quiénes somos</p>
        <h2 id="identity-title" class="h3 identity__title">
          Pragmasyn es una empresa mexicana de automatización operativa.
        </h2>
        <p class="body identity__text">
          Aplicamos inteligencia artificial a los procesos que hoy se hacen a
          mano en empresas de 50 a 500 personas. Somos parte de Grupo
          Zendreros.
        </p>
      </div>
    </div>
  </section>

  <!-- 10 · Preguntas -->
  <section class="ground-light act faq" aria-labelledby="faq-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Preguntas que sí se hacen</p>
        <h2 id="faq-title" class="h2">Antes de que las preguntes.</h2>
      </div>

      <ul class="faq__list">
        {
          faq.map((item) => (
            <li class="faq__item" data-reveal>
              <details class="faq__details">
                <summary class="faq__q">
                  <span>{item.q}</span>
                  <span class="faq__toggle" aria-hidden="true"></span>
                </summary>
                <p class="body faq__a">{item.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 11 · Cierre -->
  <section class="ground-dark act closing" aria-labelledby="closing-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <h2 id="closing-title" class="display-2">¿Qué sigues haciendo a mano?</h2>
        <p class="lead closing__text">
          Escríbenos qué proceso te está costando más horas. Te respondemos
          con una lectura honesta — incluso si la respuesta es que no nos
          necesitas.
        </p>
        <a class="btn btn--primary closing__cta" href="/contacto">Agendar una conversación</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // El auto-diagnóstico cuenta en vivo. La lista funciona sin JS: son
  // checkboxes de verdad; el resumen y el handoff solo aparecen si hay JS
  // para llenarlos.
  const list = document.querySelector<HTMLElement>("[data-check-list]");
  const summary = document.querySelector<HTMLElement>("[data-check-summary]");
  const count = document.querySelector<HTMLElement>("[data-check-count]");
  const verdict = document.querySelector<HTMLElement>("[data-check-verdict]");
  const handoff = document.querySelector<HTMLElement>("[data-check-handoff]");

  if (list && summary && count && verdict) {
    summary.hidden = false;
    const inputs = Array.from(list.querySelectorAll<HTMLInputElement>(".check__input"));

    const update = (): void => {
      const marked = inputs.filter((i) => i.checked).length;
      count.textContent = String(marked);
      summary.classList.toggle("is-loaded", marked >= 3);
      if (marked === 0) {
        verdict.textContent = "Marca lo que reconozcas de tu operación.";
      } else if (marked < 3) {
        verdict.textContent = "Cada marca son horas que hoy nadie contabiliza.";
      } else {
        verdict.textContent = "Tienes horas suficientes en la mesa para que el diagnóstico se pague solo.";
      }
      if (handoff) handoff.hidden = marked < 3;
    };

    list.addEventListener("change", update);
    update();
  }
</script>

<style>
  /* --- 1 · Hero: centrado, aire arriba, la marca respirando --- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-9), 12vw, var(--space-11)) clamp(var(--space-7), 7vw, var(--space-9));
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: calc(var(--space-9) * -1) 0 auto;
    height: 70%;
    background: radial-gradient(
      55% 100% at 50% 0%,
      rgb(var(--rgb-surface) / 0.07),
      transparent 70%
    );
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-5);
  }
  .hero__title {
    max-width: 18ch;
  }
  .hero__lead {
    max-width: var(--measure-wide);
  }
  .hero__actions {
    margin-top: var(--space-2);
  }
  .hero__etym {
    margin-top: var(--space-6);
    max-width: var(--measure);
  }

  /* --- 2 · Demo wrapper: la sección respira, el componente compone dentro --- */
  .demo-wrap {
    padding-block: 0;
  }

  /* --- 3 · Auto-diagnóstico --- */
  .check__card {
    margin-top: var(--space-8);
    padding: var(--space-4);
  }
  .check__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
    gap: var(--space-1) var(--space-4);
  }
  .check__label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-m);
    cursor: pointer;
    transition: background-color var(--dur-1) var(--ease-swift);
  }
  .check__label:hover {
    background: var(--bg-sunken);
  }
  .check__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .check__box {
    flex: none;
    width: var(--space-5);
    height: var(--space-5);
    margin-top: var(--space-1);
    border: var(--hairline-strong) solid var(--fg-muted-ui);
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: background-color var(--dur-2) var(--ease-swift),
      border-color var(--dur-2) var(--ease-swift);
  }
  .check__box::after {
    content: "";
    width: 0.3em;
    height: 0.55em;
    border-inline-end: var(--hairline-strong) solid var(--on-interactive);
    border-block-end: var(--hairline-strong) solid var(--on-interactive);
    rotate: 45deg;
    translate: 0 calc(var(--space-1) * -0.25);
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease-swift);
  }
  .check__input:checked + .check__box {
    background: var(--interactive);
    border-color: var(--interactive);
  }
  .check__input:checked + .check__box::after {
    opacity: 1;
  }
  .check__input:focus-visible + .check__box {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .check__text {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .check__input:checked ~ .check__text {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }
  .check__summary[hidden] {
    display: none;
  }
  .check__summary {
    margin-top: var(--space-4);
    padding: var(--space-4);
    border-top: var(--hairline) solid var(--hairline-color);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .check__count {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .check__count-num {
    font-size: var(--text-h2);
    font-weight: var(--weight-display);
