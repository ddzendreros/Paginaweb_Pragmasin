---
import BuildTiles from "../components/BuildTiles.astro";
import Configurator from "../components/Configurator.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../components/Icon.astro";
import Marquee from "../components/Marquee.astro";
import OwnPass from "../components/OwnPass.astro";
import Prompt from "../components/Prompt.astro";
import StepFlow from "../components/StepFlow.astro";
import Versus from "../components/Versus.astro";
import Strands from "../components/Strands.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { waMessages, whatsappUrl } from "../site";

// `from` and `to` place each bar on the project's timeline, in percent. Bars
// that reach 100 run off the edge of the page: that support has no end date.
const accompaniment: {
  icon: IconName;
  title: string;
  text: string;
  from: number;
  to: number;
}[] = [
  {
    icon: "chat",
    title: "Hablas con quien lo construye",
    text: "Un canal directo, sin intermediarios ni tickets.",
    from: 0,
    to: 100,
  },
  {
    icon: "eye",
    title: "Ves el avance mientras se hace",
    text: "Pruebas el software desde temprano y lo corregimos contigo.",
    from: 22,
    to: 62,
  },
  {
    icon: "cap",
    title: "Tu equipo aprende a usarlo",
    text: "Capacitamos a quienes lo van a usar todos los días.",
    from: 46,
    to: 78,
  },
  {
    icon: "life",
    title: "Seguimos después de entregar",
    text: "Si algo falla o tu operación cambia, aquí estamos.",
    from: 62,
    to: 100,
  },
];

// Cases need the client's permission (D7). None are approved, so none ship:
// with the list empty the section does not exist in the HTML.
interface Case {
  sector: string;
  before: string;
  built: string;
  after: string;
}
const cases: Case[] = [];

const faq: [string, string][] = [
  [
    "¿Cuánto cuesta?",
    "Depende de lo que haya que construir. Primero entendemos qué necesitas. Después te decimos cuánto cuesta y qué incluye, por escrito, antes de que firmes nada.",
  ],
  [
    "¿Cuánto tarda?",
    "No prometemos fechas antes de entender el problema. Cuando lo entendemos, te damos un plazo y te enseñamos avances desde el principio.",
  ],
  [
    "¿Necesito saber de tecnología?",
    "No. Tú conoces tu negocio. Nosotros nos encargamos de lo técnico y te lo explicamos sin rodeos.",
  ],
  [
    "¿Y si ya uso un SaaS o un sistema?",
    "Lo revisamos contigo. Si te conviene conservarlo, lo conectamos. Si te conviene dejarlo, construimos el reemplazo y te ayudamos a mover tu información.",
  ],
  ["¿De quién es el software?", "Tuyo. Pagas una vez y es de tu empresa."],
  [
    "¿Van a contar que trabajamos juntos?",
    "No. No publicamos nombres ni logotipos de clientes.",
  ],
  [
    "¿Es para una empresa chica?",
    "Sí. Trabajamos con PyMEs de cualquier tamaño y giro.",
  ],
];

const waHref = whatsappUrl(waMessages.flotante);
---

<BaseLayout
  title="Pragmasyn — Software a la medida para PyMEs en México"
  description="Diseñamos y construimos software y automatizaciones a la medida de tu negocio. Te acompañamos en todo el camino. Pagas una vez y es tuyo."
  ogTitle="Deja de adaptarte a tu software."
  ogDescription="Software y automatización a la medida para PyMEs. Con tus procesos, tus nombres y tus reglas."
  path="/"
>
  <section class="hero" id="diagnostico" aria-labelledby="hero-title">
    <Strands class="hero__art" />
    <div class="act__inner hero__inner">
      <h1 id="hero-title" class="display hero__title">
        <span class="hero__line">Deja de adaptarte</span><br class="hero__br" />
        <span class="hero__line">a tu software.</span>
      </h1>
      <p class="lead hero__lead">
        Diseñamos y construimos el software que tu negocio necesita, con tus procesos, tus nombres y
        tus reglas. Te acompañamos en todo el camino. Cuando terminamos, es tuyo.
      </p>
      <div class="actions hero__actions">
        <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
        <a class="btn btn--secondary" href="#construir">Ver qué construimos</a>
      </div>
      <div class="hero__app">
        <Configurator />
      </div>
    </div>
  </section>

  <Marquee />

  <section class="act" aria-labelledby="contraste-title">
    <div class="act__inner">
      <div class="problema ground-paper">
        <div class="problema__head">
          <p class="sec__name">El problema</p>
          <h2 id="contraste-title" class="h2 problema__title">
            Un SaaS te pide que cambies.<br /> Nosotros no.
          </h2>
        </div>
        <Versus />
      </div>
    </div>
  </section>

  <section class="act" id="construir" aria-labelledby="construir-title">
    <div class="act__inner">
      <div class="grid-12">
        <p class="sec__name">Qué construimos</p>
        <div class="sec__body head">
          <h2 id="construir-title" class="h2">Si hoy te estorba, se puede construir.</h2>
          <p class="lead">
            No tenemos catálogo. Estos son puntos de partida; lo tuyo puede no parecerse a ninguno.
          </p>
        </div>
      </div>
      <BuildTiles />
      <p class="build__more">
        <a class="link link--plain" href="/contacto">¿No ves lo tuyo? Mejor. Cuéntanos.</a>
      </p>
    </div>
  </section>

  <section class="act" aria-labelledby="flujo-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Cómo trabajamos</p>
      <div class="sec__body head">
        <h2 id="flujo-title" class="h2">Lo que se decide, se entrega.</h2>
        <p class="lead">Cuatro pasos, contigo en todos. Sin pasos secretos.</p>
      </div>
      <StepFlow />
      <p class="build__more">
        <a class="link link--plain" href="/metodo">Cómo trabajamos</a>
      </p>
    </div>
  </section>

  <section class="act company" aria-labelledby="acomp-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Acompañamiento</p>
      <div class="sec__body head">
        <h2 id="acomp-title" class="h2">No desaparecemos después de entregar.</h2>
        <p class="lead">Lo importante no es el software. Es que tu día a día se sienta mejor.</p>
      </div>
      <div class="track-wrap">
        <ol>
          {
            accompaniment.map((a, i) => (
              <li class="track__row">
                <div class="track__text">
                  <span class="track__icon">
                    <Icon name={a.icon} />
                  </span>
                  <div>
                    <h3 class="h3">{a.title}</h3>
                    <p class="small">{a.text}</p>
                  </div>
                </div>
                <div class="track__lane" aria-hidden="true">
                  {i === 0 && <span class="track__mark">Entrega</span>}
                  <span
                    class:list={["track__bar", { "track__bar--open": a.to === 100 }]}
                    style={`--from: ${a.from}; --to: ${a.to};`}
                  />
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="act own-act" aria-labelledby="tuyo-title">
    <div class="act__inner grid-12 own-grid">
      <div class="own-grid__head">
        <p class="sec__name">Propiedad</p>
        <div class="head">
          <h2 id="tuyo-title" class="display own-title">Se paga una vez.<br /> Y es tuyo.</h2>
          <p class="lead">
            Sin renta mensual por usuario. Sin contratos que te amarren. Lo que construimos para tu
            empresa es de tu empresa.
          </p>
        </div>
      </div>
      <div class="own-grid__pass">
        <OwnPass />
      </div>
    </div>
  </section>

  {
    cases.length > 0 && (
      <section class="act cases" aria-labelledby="casos-title">
        <div class="act__inner grid-12">
          <p class="sec__name">Casos</p>
          <div class="sec__body">
            <div class="head">
              <h2 id="casos-title" class="h2">Tu operación no aparece en nuestro sitio.</h2>
              <p class="lead">
                Por eso aquí no hay logotipos. Contamos lo que hicimos sin decir para quién.
              </p>
            </div>
            <ul class="cases__list">
              {cases.map((c) => (
                <li class="cases__item">
                  <dl>
                    <div>
                      <dt class="label">Giro y tamaño aproximado</dt>
                      <dd>{c.sector}</dd>
                    </div>
                    <div>
                      <dt class="label">Qué pasaba</dt>
                      <dd>{c.before}</dd>
                    </div>
                    <div>
                      <dt class="label">Qué construimos</dt>
                      <dd>{c.built}</dd>
                    </div>
                    <div>
                      <dt class="label">Qué cambió</dt>
                      <dd>{c.after}</dd>
                    </div>
                  </dl>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="act" aria-labelledby="faq-title">
    <div class="act__inner grid-12">
      <p class="sec__name">Preguntas</p>
      <div class="sec__body">
        <h2 id="faq-title" class="h2 head">Lo que conviene saber antes de empezar.</h2>
        <div class="faq">
          {
            faq.map(([question, answer]) => (
              <details class="qa">
                <summary class="qa__q">
                  <span class="h3">{question}</span>
                  <span class="qa__icon" aria-hidden="true" />
                </summary>
                <p class="qa__a">{answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="act closing-act" aria-labelledby="cierre-title">
    <Strands class="closing__art" />
    <div class="act__inner closing-prompt">
      <h2 id="cierre-title" class="display closing__title">¿Qué te gustaría dejar de hacer?</h2>
      <p class="lead">
        Cuéntanoslo como te salga. Te contesta una persona y te decimos con honestidad si te podemos
        ayudar.
      </p>
      <Prompt />
      {
        waHref && (
          <a class="link link--plain" href={waHref} target="_blank" rel="noopener">
            Escribir por WhatsApp
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Glass over white turns gray and takes the menu's contrast with it, so the
  // header goes nearly solid while it sits on the paper sheet.
  const sheet = document.querySelector(".problema");
  if (sheet) {
    new IntersectionObserver(
      ([entry]) => {
        document.documentElement.classList.toggle("over-paper", entry?.isIntersecting ?? false);
      },
      { rootMargin: "0px 0px -90% 0px" },
    ).observe(sheet);
  }
</script>

<style>
  /* --- Hero: the page opens in the dark, lit by the mark ------------------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-block: calc(var(--header-space) + clamp(var(--space-7), 7vw, var(--space-9))) var(--space-7);
  }
  /* a faint drawing grid, fading out from the top of the page */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    z-index: -2;
    height: 46rem;
    background-image: linear-gradient(rgb(186 215 247 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(186 215 247 / 0.055) 1px, transparent 1px);
    background-size: 4rem 4rem;
    -webkit-mask-image: radial-gradient(90% 80% at 60% 0%, black 30%, transparent 100%);
    mask-image: radial-gradient(90% 80% at 60% 0%, black 30%, transparent 100%);
  }
  /* the mark enters from the edge of the window, larger than the page */
  .hero :global(.hero__art) {
    inset-block-start: 5.5rem;
    inset-inline-end: clamp(-13rem, -12vw, -5rem);
    width: clamp(25rem, 46vw, 44rem);
  }
  /* the break stays at every width so the title never strands a lone "a" */
  .hero__br {
    display: block;
  }
  .hero__title {
    font-size: min(var(--text-display), 10.6vw);
  }
  .hero__line {
    display: inline-block;
    background: linear-gradient(180deg, var(--white) 35%, var(--mist-300));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    margin-block-start: var(--space-5);
    color: var(--mist-100);
    text-shadow: 0 0 24px rgb(var(--rgb-ink));
  }
  .hero__actions {
    margin-block-start: var(--space-5);
  }

  /* One choreographed arrival, in reading order. CSS only: nothing waits for a
     script, and the title is painted as soon as the font is. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line,
    .hero__lead,
    .hero__actions,
    .hero__app,
    .hero :global(.hero__art) {
      animation: arrive var(--dur-5) var(--ease-out) both;
    }
    .hero__line:last-of-type {
      animation-delay: 90ms;
    }
    .hero__lead {
      animation-delay: 200ms;
    }
    .hero__actions {
      animation-delay: 300ms;
    }
    .hero__app {
      animation-delay: 420ms;
      animation-duration: 1200ms;
    }
    .hero :global(.hero__art) {
      animation-name: art-arrive;
      animation-duration: 1800ms;
    }
  }
  @keyframes arrive {
    from {
      opacity: 0;
      translate: 0 1.25rem;
      filter: blur(10px);
    }
  }
  @keyframes art-arrive {
    from {
      opacity: 0;
      scale: 0.86;
    }
  }
  /* on a phone the mark stays behind the words and steps back from them */
  @media (width <= 56rem) {
    .hero :global(.hero__art) {
      inset-block-start: 2rem;
      inset-inline-end: -10rem;
      width: 26rem;
      opacity: 0.5;
    }
  }


  /* --- El problema: una hoja de papel dentro de la página oscura ------------
     As wide as the header, so the art stays in view on both sides of it. */
  .problema {
    max-width: 68rem;
    margin-inline: auto;
    padding: clamp(var(--space-6), 3.4vw, var(--space-7)) clamp(var(--space-3), 2.8vw, var(--space-6));
    border-radius: var(--radius-2xl);
  }
  .problema__head {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    margin-block-end: clamp(var(--space-5), 2.4vw, var(--space-6));
    text-align: center;
  }
  .problema .sec__name {
    margin-block-end: 0;
    font-weight: var(--weight-text);
  }
  .problema__title {
    font-family: var(--font-serif);
    font-size: var(--text-paper);
    font-weight: var(--weight-text);
    font-stretch: normal;
    line-height: var(--leading-paper);
    letter-spacing: var(--tracking-paper);
  }
  :global(html.over-paper) {
    --glass-alpha: 0.92;
  }

  /* --- Qué construimos ---------------------------------------------------- */
  .build__more {
    margin-block-start: var(--space-4);
  }

  /* --- Acompañamiento: un cronograma, no una lista ------------------------ */
  .company {
    --handoff: 62%;
    --panel-pad: clamp(var(--space-4), 3vw, var(--space-6));
  }
  .company .sec__body {
    margin-block-end: var(--space-5);
  }
  .track-wrap {
    padding: var(--space-7) var(--panel-pad) var(--space-2);
    background: var(--bg-chrome);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-key);
    overflow: hidden;
  }
  .track__row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--gutter);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .track__text {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }
  .track__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--night-800);
    color: var(--sky);
    box-shadow: var(--shadow-key);
  }
  .track__text .small {
    max-width: 44ch;
    text-wrap: pretty;
  }
  /* the lane runs to the edge of the panel so an open bar has no end */
  .track__lane {
    position: relative;
    margin-inline-end: calc(-1 * var(--panel-pad));
  }
  .track__lane::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--handoff);
    border-inline-start: var(--hairline) solid var(--control-border);
  }
  .track__bar {
    position: absolute;
    inset-block-start: calc(var(--space-4) + 0.9rem);
    inset-inline-start: calc(var(--from) * 1%);
    width: calc((var(--to) - var(--from)) * 1%);
    height: 0.625rem;
    background: var(--strand);
    border-radius: var(--radius-s);
    box-shadow: 0 0 24px rgb(var(--rgb-blue) / 0.55);
    transform-origin: left;
  }
  /* the plan draws itself as it scrolls in */
  :global(.reveal) .track__bar {
    scale: 0 1;
    transition: scale 1400ms var(--ease-out) 150ms;
  }
  :global(.reveal.is-in) .track__bar {
    scale: 1 1;
  }
  .track__bar--open {
    border-start-end-radius: 0;
    border-end-end-radius: 0;
  }
  .track__mark {
    position: absolute;
    inset-block-end: calc(100% + var(--space-1));
    inset-inline-start: var(--handoff);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    color: var(--fg-secondary);
    translate: -50% 0;
  }
  @media (width <= 56rem) {
    .track__row {
      grid-template-columns: minmax(0, 1fr);
      padding-block-end: var(--space-4);
    }
    .track__text {
      padding-block-end: var(--space-3);
    }
    .track__lane {
      height: 1rem;
    }
    .track__bar {
      inset-block-start: 0;
    }
    /* on a phone the text sits above the bar, so the label goes under it */
    .track__mark {
      inset-block-end: auto;
      inset-block-start: calc(100% + var(--space-1));
    }
    .track__row:first-child {
      padding-block-end: var(--space-6);
    }
  }

  /* --- Propiedad ----------------------------------------------------------- */
  .own-act {
    background: radial-gradient(52rem 34rem at 88% 40%, rgb(var(--rgb-violet) / 0.2), transparent 70%);
  }
  .own-grid {
    align-items: center;
    row-gap: var(--space-6);
  }
  .own-grid__head {
    --col: 1 / span 7;
  }
  .own-grid__head .sec__name {
    margin-block-end: var(--space-4);
  }
  .own-grid__head .head {
    margin-block-end: 0;
  }
  .own-title {
    font-size: min(var(--text-display), 5.9vw);
  }
  .own-grid__pass {
    --col: 8 / -1;
  }
  /* a narrow window has room for a bigger title again */
  @media (width <= 56rem) {
    .own-title {
      font-size: min(var(--text-display), 11vw);
    }
  }

  /* --- Casos (solo con contenido autorizado) ------------------------------ */
  .cases__list {
    display: grid;
    gap: var(--space-6);
  }
  .cases__item {
    padding-block-start: var(--space-5);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .cases__item dl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gutter);
  }
  .cases__item dd {
    margin-block-start: var(--space-2);
  }
  @media (width <= 56rem) {
    .cases__item dl {
      grid-template-columns: 1fr;
    }
  }

  /* --- Preguntas ------------------------------------------------------------ */
  .faq {
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .qa {
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  /* the answer opens at its own height, where the browser can measure it */
  .qa::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size var(--dur-3) var(--ease-out),
      content-visibility var(--dur-3) allow-discrete;
  }
  .qa[open]::details-content {
    block-size: auto;
  }
  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 44px;
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
  }
  .qa__q::-webkit-details-marker {
    display: none;
  }
  .qa__q {
    transition: color var(--dur-2) var(--ease-out);
  }
  .qa__q:hover {
    color: var(--interactive);
  }
  /* the plus is drawn, not typed */
  .qa__icon {
    position: relative;
    flex: none;
    width: var(--space-4);
    height: var(--space-4);
    transition: rotate var(--dur-3) var(--ease-spring);
  }
  .qa__icon::before,
  .qa__icon::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    border-block-start: var(--hairline-strong) solid currentColor;
    translate: 0 -50%;
  }
  .qa__icon::after {
    rotate: 90deg;
  }
  .qa[open] .qa__icon {
    rotate: 45deg;
  }
  /* --- Cierre ---------------------------------------------------------------- */
  .closing-prompt {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }
  .closing-prompt .closing__title {
    max-width: 14ch;
  }
  .closing-prompt .lead {
    color: var(--fg);
  }

  .qa__a {
    max-width: var(--measure);
    padding-block-end: var(--space-5);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }
</style>
