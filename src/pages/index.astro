---
import BaseLayout from "../layouts/BaseLayout.astro";

// La lista está calibrada al segmento (BRIEF v2 §6.1): cada renglón tiene que
// provocar un "sí, eso mismo". No se agregan inventados.
const manualWork = [
  "Capturar facturas de proveedor que llegan en PDF o por correo",
  "Pasar pedidos de WhatsApp al sistema",
  "Armar el reporte de ventas del lunes en Excel",
  "Revisar a mano que la factura coincida con la orden de compra",
  "Copiar datos de un sistema a otro porque no se hablan",
  "Contestar las mismas cinco preguntas de clientes todos los días",
  "Perseguir cotizaciones y aprobaciones por correo",
  "Sacar cifras del sistema para meterlas a otro Excel",
  "Registrar asistencia en papel o en hoja de cálculo",
  "Clasificar, nombrar y archivar documentos",
];

const territory = [
  {
    name: "Lo que llega sin forma",
    text: "PDFs, WhatsApp, correos, fotos, notas de voz, papel. La IA lo lee, lo estructura y lo deja donde va.",
  },
  {
    name: "Lo que pide criterio",
    text: "Conciliar cuando los números no cuadran exacto. Detectar lo que se sale de lo normal. Cachar el error antes de contabilidad.",
  },
  {
    name: "Lo que no se habla entre sí",
    text: "Tu ERP, tu Excel, tu banco, el SAT, el portal de tu cliente. Los conectamos sin migrar nada.",
  },
];

const deliverables = [
  {
    num: "01",
    name: "Dónde se van tus horas",
    text: "Mapa de tu operación con el tiempo manual medido proceso por proceso, con tus datos, no con benchmarks.",
  },
  {
    num: "02",
    name: "Qué se puede automatizar ya",
    text: "Lista priorizada por horas ahorradas contra esfuerzo de implementación. Con números, no con adjetivos.",
  },
  {
    num: "03",
    name: "Tu situación frente a la reforma",
    text: "Cálculo de la brecha entre tu operación actual y la jornada que la ley te va a exigir.",
  },
  {
    num: "04",
    name: "Una automatización funcionando",
    text: "No un prototipo ni una demo. Un proceso automatizado y corriendo antes de que terminen los cinco días.",
  },
];

// Transitorio Segundo de la reforma a la LFT (DOF 1 de mayo de 2026).
// Las cifras están verificadas en el brief §11: no se tocan sin re-verificar.
const journey = [
  { year: "2026", hours: "48" },
  { year: "2027", hours: "46" },
  { year: "2028", hours: "44" },
  { year: "2029", hours: "42" },
  { year: "2030", hours: "40" },
];

const method = [
  {
    num: "01",
    name: "Medir",
    text: "Entrevistas, observación y datos reales para cuantificar cuántas horas consume cada proceso hoy.",
    deliverable: "El mapa de tus horas, en una página.",
  },
  {
    num: "02",
    name: "Priorizar",
    text: "Qué automatizar primero, qué después y qué no vale la pena tocar. Con costo y esfuerzo reales.",
    deliverable: "Lista priorizada, con horas estimadas de ahorro.",
  },
  {
    num: "03",
    name: "Construir",
    text: "Se implementa, se mide contra la línea base y se corrige. Indicadores acordados antes de empezar.",
    deliverable: "El proceso funcionando y el ahorro medido.",
  },
];
---

<BaseLayout
  title="Pragmasyn — Automatización operativa con IA para PyMEs en México"
  description="Recupera las horas que hoy se van en captura manual, conciliaciones y reportes. Diagnóstico de 5 días con una automatización funcionando. Sobre el sistema que ya tienes."
  ogTitle="Tu operación habla. La IA actúa."
  ogDescription="Automatizamos con IA lo que hoy se hace a mano: facturas en PDF, pedidos por WhatsApp, reportes en Excel. Diagnóstico de 5 días, precio fijo."
  path="/"
>
  <!-- 1 · Hero -->
  <section class="ground-dark act hero" aria-labelledby="hero-title">
    <div class="act__inner hero__inner">
      <p class="label eyebrow" data-reveal>Automatización operativa con IA</p>
      <h1 id="hero-title" class="display hero__title" data-reveal>
        Tu operación habla.<br />La IA actúa.
      </h1>
      <p class="lead hero__lead" data-reveal>
        Tu operación ya te está diciendo dónde se va el tiempo: en los WhatsApps
        que alguien transcribe, en los PDFs que se capturan a mano, en el reporte
        que toma tres horas armar cada lunes. Escucharla cuesta horas de trabajo
        humano. Eso es lo que automatizamos.
      </p>
      <div class="actions actions--center hero__actions" data-reveal>
        <a class="btn btn--primary" href="/contacto">Diagnóstico de 5 días</a>
        <a class="btn btn--secondary" href="#a-mano">Ver qué se puede automatizar</a>
      </div>
      <figure class="hero__flow" data-reveal>
        <ul class="hero__flow-in">
          <li class="hero__chip">Factura en PDF</li>
          <li class="hero__chip">Pedido por WhatsApp</li>
          <li class="hero__chip">Nota de voz de piso</li>
        </ul>
        <span class="hero__flow-arrow" aria-hidden="true">→</span>
        <figcaption class="hero__flow-out">
          <span class="hero__flow-title">Capturado, validado y en tu sistema</span>
          <span class="caption">Sin que nadie lo teclee</span>
        </figcaption>
      </figure>

      <p class="caption hero__etym" data-reveal>
        <span class="serif-italic" lang="grc">πρᾶγμα</span> — hecho realizado ·
        <span class="serif-italic" lang="grc">σύν</span> — junto con. El nombre es
        la promesa: síntesis pragmática.
      </p>
    </div>
  </section>

  <!-- 2 · Auto-diagnóstico: el corazón del sitio -->
  <section class="ground-light act check" id="a-mano" aria-labelledby="check-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">El costo invisible</p>
        <h2 id="check-title" class="h2">¿Qué sigues haciendo a mano?</h2>
        <p class="lead">Nadie lo tiene medido. Por eso nadie lo arregla.</p>
      </div>

      <div class="card check__card" data-reveal>
        <ul class="check__list" data-check-list>
          {
            manualWork.map((item, i) => (
              <li class="check__row">
                <label class="check__label">
                  <input class="check__input" type="checkbox" value={String(i)} />
                  <span class="check__box" aria-hidden="true" />
                  <span class="check__text">{item}</span>
                </label>
              </li>
            ))
          }
        </ul>

        <div class="check__summary" data-check-summary hidden>
          <p class="check__count">
            <span class="numeral check__count-num" data-check-count>0</span>
            <span class="small">de {manualWork.length} marcados</span>
          </p>
          <p class="small check__verdict" data-check-verdict role="status" aria-live="polite">
            Marca lo que reconozcas de tu operación.
          </p>
        </div>
      </div>

      <p class="body check__close" data-reveal>
        Si marcaste tres o más, tienes entre 40 y 120 horas al mes en la mesa. No
        es una estimación de venta: es lo que medimos en el diagnóstico, con tus
        datos.
      </p>
    </div>
  </section>

  <!-- 3 · El territorio -->
  <section class="ground-light act act--well territory" aria-labelledby="territory-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Dónde entramos</p>
        <h2 id="territory-title" class="h2">No tocamos lo que ya funciona.</h2>
        <p class="lead">
          Tu ERP ordena lo que ya está capturado: cotizaciones, órdenes,
          inventario, contabilidad. Eso ya está resuelto y no venimos a moverlo.
        </p>
        <p class="lead">
          El problema vive afuera. En lo que llega en desorden y alguien tiene
          que ordenar a mano antes de que el sistema lo pueda usar.
        </p>
      </div>

      <ul class="cards territory__list">
        {
          territory.map((t) => (
            <li class="card territory__item" data-reveal>
              <h3 class="h4">{t.name}</h3>
              <p class="small territory__text">{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4 · La oferta (destino del QR de la tarjeta) -->
  <section class="ground-dark act offer" id="diagnostico" aria-labelledby="offer-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Punto de entrada</p>
        <h2 id="offer-title" class="h2">Diagnóstico de Horas Recuperables</h2>
        <p class="lead">Cinco días. Precio fijo. Sin propuesta de sesenta páginas.</p>
        <p class="badge">
          <span class="badge__dot" aria-hidden="true"></span>
          Termina con una automatización corriendo
        </p>
      </div>

      <ol class="cards offer__list">
        {
          deliverables.map((d) => (
            <li class="card offer__item" data-reveal>
              <span class="numeral offer__num" aria-hidden="true">
                {d.num}
              </span>
              <h3 class="h4 offer__name">{d.name}</h3>
              <p class="small offer__text">{d.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="offer__foot" data-reveal>
        <p class="body offer__honesty">
          Si al quinto día no encontramos horas que valga la pena recuperar, te lo
          decimos y ahí termina. Preferimos eso a venderte un proyecto que no
          necesitas.
        </p>
        <a class="btn btn--primary" href="/contacto">Agendar el diagnóstico</a>
      </div>
    </div>
  </section>

  <!-- 5 · Urgencia: la reforma -->
  <section class="ground-dark act act--well reform" aria-labelledby="reform-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">El calendario ya corre</p>
        <h2 id="reform-title" class="h2">
          La reforma no te pide horas extra. Te pide operar distinto.
        </h2>
        <p class="lead">
          La jornada laboral baja por ley. El salario no baja. La carga de
          trabajo tampoco.
        </p>
      </div>

      <ol class="reform__scale" data-reveal>
        {
          journey.map((j) => (
            <li class="reform__step">
              <span class="caption reform__year">{j.year}</span>
              <span class="numeral reform__hours">{j.hours}</span>
              <span class="caption reform__unit">horas</span>
            </li>
          ))
        }
      </ol>

      <div class="card card--feature reform__note" data-reveal>
        <p class="body">
          Y desde el 1 de enero de 2027, el registro electrónico de jornada es
          obligatorio. Cuando ese registro exista, vas a tener por primera vez el
          dato exacto de cuántas horas consume cada proceso. La pregunta es si
          llegas a esa fecha con un plan o con un problema.
        </p>
        <p class="body reform__close">
          La ventana para ajustar procesos es este año. Después ya no es
          planeación, es reacción.
        </p>
        <p class="caption reform__disclaimer">
          Contexto de negocio, no asesoría legal. La interpretación jurídica la da
          tu abogado laboral.
        </p>
      </div>
    </div>
  </section>

  <!-- 6 · Cómo trabajamos -->
  <section class="ground-light act method" aria-labelledby="method-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Cómo trabajamos</p>
        <h2 id="method-title" class="h2">El método es el producto.</h2>
        <p class="lead">
          No vendemos horas ni presentaciones. Vendemos el camino corto entre un
          proceso manual y un proceso que corre solo.
        </p>
      </div>

      <ol class="cards method__list">
        {
          method.map((m) => (
            <li class="card method__item" data-reveal>
              <span class="numeral method__num" aria-hidden="true">
                {m.num}
              </span>
              <h3 class="h3 method__name">{m.name}</h3>
              <p class="small method__text">{m.text}</p>
              <p class="small method__deliverable">
                <strong class="method__deliverable-label">Entregable</strong>
                {m.deliverable}
              </p>
            </li>
          ))
        }
      </ol>

      <p class="body method__more" data-reveal>
        <strong>Sin pasos secretos:</strong> el método completo está publicado. Qué
        hacemos, qué entregamos y qué necesitamos de ti en cada etapa.
        <a class="link link--arrow method__link" href="/metodo">El método completo</a>
      </p>
    </div>
  </section>

  <!-- 7 · Cierre -->
  <section class="ground-dark act closing" aria-labelledby="closing-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <h2 id="closing-title" class="display-2">¿Qué sigues haciendo a mano?</h2>
        <p class="lead closing__text">
          Escríbenos qué proceso te está costando más horas. Te respondemos con
          una lectura honesta — incluso si la respuesta es que no nos necesitas.
        </p>
        <a class="btn btn--primary closing__cta" href="/contacto">Agendar una conversación</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // El auto-diagnóstico cuenta en vivo. La lista funciona sin JS: son
  // checkboxes de verdad; el resumen solo aparece si hay JS para llenarlo.
  const list = document.querySelector<HTMLElement>("[data-check-list]");
  const summary = document.querySelector<HTMLElement>("[data-check-summary]");
  const count = document.querySelector<HTMLElement>("[data-check-count]");
  const verdict = document.querySelector<HTMLElement>("[data-check-verdict]");

  if (list && summary && count && verdict) {
    summary.hidden = false;
    const inputs = Array.from(list.querySelectorAll<HTMLInputElement>(".check__input"));

    const update = (): void => {
      const marked = inputs.filter((i) => i.checked).length;
      count.textContent = String(marked);
      summary.classList.toggle("is-loaded", marked >= 3);
      if (marked === 0) {
        verdict.textContent = "Marca lo que reconozcas de tu operación.";
      } else if (marked < 3) {
        verdict.textContent = "Cada marca son horas que hoy nadie contabiliza.";
      } else {
        verdict.textContent = "Tienes horas suficientes en la mesa para que el diagnóstico se pague solo.";
      }
    };

    list.addEventListener("change", update);
    update();
  }
</script>

<style>
  /* --- 1 · Hero: centrado, aire arriba, la marca respirando --- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-9), 12vw, var(--space-11)) clamp(var(--space-8), 9vw, var(--space-10));
  }
  /* claridad que entra por arriba: profundidad sin meter una imagen ni un
     segundo gradiente de marca (el de marca sale dos veces en todo el sitio) */
  .hero::before {
    content: "";
    position: absolute;
    inset: calc(var(--space-9) * -1) 0 auto;
    height: 70%;
    background: radial-gradient(
      55% 100% at 50% 0%,
      rgb(var(--rgb-surface) / 0.07),
      transparent 70%
    );
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
  }
  .hero__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-5);
  }
  .hero__title {
    max-width: 16ch;
  }
  .hero__lead {
    max-width: var(--measure-wide);
  }
  .hero__actions {
    margin-top: var(--space-2);
  }
  /* la escena: entra en desorden, sale capturado. Es el sitio en una imagen,
     dibujada con tipografía y hairlines — nada de capturas de pantalla falsas */
  .hero__flow {
    margin: var(--space-7) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--surface-card);
    border: var(--hairline) solid var(--surface-border);
    border-radius: var(--radius-xl);
  }
  .hero__flow-in {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .hero__chip {
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    color: var(--fg-secondary);
    border: var(--hairline) dashed var(--fg-muted-ui);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-3);
  }
  .hero__flow-arrow {
    color: var(--interactive);
    font-size: var(--text-h4);
  }
  .hero__flow-out {
    display: grid;
    gap: var(--space-1);
    text-align: start;
    border-inline-start: var(--hairline-strong) solid var(--interactive);
    padding-inline-start: var(--space-4);
  }
  .hero__flow-title {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
  }
  @media (max-width: 48rem) {
    .hero__flow {
      flex-direction: column;
    }
    .hero__flow-arrow {
      rotate: 90deg;
    }
    .hero__flow-out {
      border-inline-start: 0;
      border-block-start: var(--hairline-strong) solid var(--interactive);
      padding-inline-start: 0;
      padding-block-start: var(--space-3);
      text-align: center;
      justify-items: center;
    }
  }

  .hero__etym {
    margin-top: var(--space-6);
    max-width: var(--measure);
  }

  /* --- 2 · Auto-diagnóstico --- */
  .check__card {
    margin-top: var(--space-8);
    padding: var(--space-4);
  }
  .check__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
    gap: var(--space-1) var(--space-4);
  }
  .check__label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-m);
    cursor: pointer;
    transition: background-color var(--dur-1) var(--ease-swift);
  }
  .check__label:hover {
    background: var(--bg-sunken);
  }
  .check__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .check__box {
    flex: none;
    width: var(--space-5);
    height: var(--space-5);
    margin-top: var(--space-1);
    border: var(--hairline-strong) solid var(--fg-muted-ui);
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: background-color var(--dur-2) var(--ease-swift),
      border-color var(--dur-2) var(--ease-swift);
  }
  /* la palomita se dibuja, no se importa: dos lados de una caja rotada */
  .check__box::after {
    content: "";
    width: 0.3em;
    height: 0.55em;
    border-inline-end: var(--hairline-strong) solid var(--on-interactive);
    border-block-end: var(--hairline-strong) solid var(--on-interactive);
    rotate: 45deg;
    translate: 0 calc(var(--space-1) * -0.25);
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease-swift);
  }
  .check__input:checked + .check__box {
    background: var(--interactive);
    border-color: var(--interactive);
  }
  .check__input:checked + .check__box::after {
    opacity: 1;
  }
  .check__input:focus-visible + .check__box {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .check__text {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .check__input:checked ~ .check__text {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }
  /* sin JS el contador no puede contar, así que no se muestra: display:flex
     le gana al [hidden] del navegador si no se dice lo contrario */
  .check__summary[hidden] {
    display: none;
  }
  .check__summary {
    margin-top: var(--space-4);
    padding: var(--space-4);
    border-top: var(--hairline) solid var(--hairline-color);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .check__count {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .check__count-num {
    font-size: var(--text-h2);
    font-weight: var(--weight-display);
    line-height: 1;
    transition: color var(--dur-2) var(--ease-swift);
  }
  .check__summary.is-loaded .check__count-num {
    color: var(--interactive);
  }
  .check__verdict {
    text-align: right;
  }
  .check__close {
    margin: var(--space-6) auto 0;
    text-align: center;
    max-width: var(--measure-wide);
  }
  @media (max-width: 40rem) {
    .check__verdict {
      text-align: left;
    }
  }

  /* --- 3 · Territorio --- */
  .territory__list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
  }
  .territory__text {
    margin-top: var(--space-3);
  }

  /* --- 4 · Oferta --- */
  /* cuatro entregables: cuatro columnas o dos, nunca un 3+1 huérfano */
  .offer__list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 64rem) {
    .offer__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 34rem) {
    .offer__list {
      grid-template-columns: 1fr;
    }
  }
  .offer__num {
    color: var(--interactive);
    font-size: var(--text-h4);
    font-weight: var(--weight-strong);
  }
  .offer__name {
    margin-top: var(--space-3);
  }
  .offer__text {
    margin-top: var(--space-2);
  }
  .offer__foot {
    margin-top: var(--space-8);
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }
  .offer__honesty {
    max-width: var(--measure-wide);
  }

  /* --- 5 · Reforma: la escala es el argumento --- */
  .reform__scale {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gutter);
    counter-reset: none;
  }
  .reform__step {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    padding-top: var(--space-5);
    border-top: var(--hairline-strong) solid var(--hairline-color);
    position: relative;
  }
  /* el primer año es el de hoy: se marca, los demás son el descenso */
  .reform__step:first-child {
    border-top-color: var(--interactive);
  }
  .reform__hours {
    font-size: var(--text-numeral);
    line-height: 1;
