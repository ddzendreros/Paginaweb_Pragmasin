---
import Configurator from "../components/Configurator.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { waMessages, whatsappUrl } from "../site";

const contrast: [string, string][] = [
  [
    "Cambias tu proceso para que quepa en sus pantallas.",
    "El sistema sigue tu proceso, con tus nombres y tus pasos.",
  ],
  ["Pagas cada mes por usuario, aunque uses la mitad.", "Pagas una sola vez por construirlo."],
  [
    "Lo que le falta se queda en un Excel aparte.",
    "Lo que hoy vive en tres Excels queda en un solo lugar.",
  ],
  ["Si dejas de pagar, pierdes el acceso.", "El software es tuyo."],
];

type Art = "bars" | "checks" | "nodes" | "browser" | "chart" | "phone";
interface Tile {
  art: Art;
  title: string;
  text: string;
  wide: boolean;
}

// Zigzag 2+1, 1+2, 2+1: the wide tiles are 1, 4 and 5.
const tiles: Tile[] = [
  {
    art: "bars",
    title: "Reemplazar un SaaS que te sale caro",
    text: "Nos dices qué usas de verdad y construimos eso. Sin las funciones que pagas y nunca abres.",
    wide: true,
  },
  {
    art: "checks",
    title: "Automatizar lo que se repite",
    text: "Lo que alguien hace igual cada semana lo puede hacer el sistema.",
    wide: false,
  },
  {
    art: "nodes",
    title: "Conectar lo que no se habla",
    text: "Tu Excel, tu banco, WhatsApp y tus sistemas, con el mismo dato.",
    wide: false,
  },
  {
    art: "browser",
    title: "Darles a tus clientes su propio portal",
    text: "Pedidos, citas y estados de cuenta, sin que tengan que llamarte.",
    wide: true,
  },
  {
    art: "chart",
    title: "Ver tu negocio en una pantalla",
    text: "Las cifras que te importan, al día, sin armar reportes.",
    wide: true,
  },
  {
    art: "phone",
    title: "Una app para tu equipo",
    text: "Para el piso, la ruta o la sucursal. Hecha para como trabajan.",
    wide: false,
  },
];
const accompaniment: [string, string, string][] = [
  ["01", "Hablas con quien lo construye", "Un canal directo, sin intermediarios ni tickets."],
  [
    "02",
    "Ves el avance mientras se hace",
    "Pruebas el software desde temprano y lo corregimos contigo.",
  ],
  [
    "03",
    "Tu equipo aprende a usarlo",
    "Capacitamos a quienes lo van a usar todos los días.",
  ],
  [
    "04",
    "Seguimos después de entregar",
    "Si algo falla o tu operación cambia, aquí estamos.",
  ],
];

const ownership: [string, string][] = [
  ["Pago", "Único"],
  ["Dueño del software", "Tu empresa"],
  ["Renta por usuario", "No hay"],
  ["Funciones que no usas", "Ninguna"],
];

// Cases need the client's permission (D7). None are approved, so none ship:
// with the list empty the section does not exist in the HTML.
interface Case {
  sector: string;
  before: string;
  built: string;
  after: string;
}
const cases: Case[] = [];

const faq: [string, string][] = [
  [
    "¿Cuánto cuesta?",
    "Depende de lo que haya que construir. Primero entendemos qué necesitas. Después te decimos cuánto cuesta y qué incluye, por escrito, antes de que firmes nada.",
  ],
  [
    "¿Cuánto tarda?",
    "No prometemos fechas antes de entender el problema. Cuando lo entendemos, te damos un plazo y te enseñamos avances desde el principio.",
  ],
  [
    "¿Necesito saber de tecnología?",
    "No. Tú conoces tu negocio. Nosotros nos encargamos de lo técnico y te lo explicamos sin rodeos.",
  ],
  [
    "¿Y si ya uso un SaaS o un sistema?",
    "Lo revisamos contigo. Si te conviene conservarlo, lo conectamos. Si te conviene dejarlo, construimos el reemplazo y te ayudamos a mover tu información.",
  ],
  ["¿De quién es el software?", "Tuyo. Pagas una vez y es de tu empresa."],
  [
    "¿Van a contar que trabajamos juntos?",
    "No. No publicamos nombres ni logotipos de clientes.",
  ],
  [
    "¿Es para una empresa chica?",
    "Sí. Trabajamos con PyMEs de cualquier tamaño y giro.",
  ],
];

const waHref = whatsappUrl(waMessages.flotante);
---

<BaseLayout
  title="Pragmasyn — Software a la medida para PyMEs en México"
  description="Diseñamos y construimos software y automatizaciones a la medida de tu negocio. Te acompañamos en todo el camino. Pagas una vez y es tuyo."
  ogTitle="Deja de adaptarte a tu software."
  ogDescription="Software y automatización a la medida para PyMEs. Con tus procesos, tus nombres y tus reglas."
  path="/"
>
  <section class="opening hero" id="diagnostico" aria-labelledby="hero-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <h1 id="hero-title" class="display hero__title">
            Deja de <em>adaptarte</em><br class="hero__br" /> a tu software.
          </h1>
        </div>
        <div class="opening__aside">
          <p class="lead">
            Diseñamos y construimos el software que tu negocio necesita, con tus procesos, tus
            nombres y tus reglas. Te acompañamos en todo el camino. Cuando terminamos, es tuyo.
          </p>
          <div class="actions">
            <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
            <a class="btn btn--secondary" href="#construir">Ver qué construimos</a>
          </div>
        </div>
      </div>
      <Configurator />
    </div>
  </section>
  <section class="chapter ground-dark act" aria-labelledby="contraste-title">
    <div class="act__inner">
      <div class="grid-12">
        <div class="head contrast__head" data-reveal>
          <p class="label label--rule">El problema</p>
          <h2 id="contraste-title" class="h2 head__title">
            Un SaaS te pide que cambies. <em>Nosotros no.</em>
          </h2>
        </div>
      </div>
      <table class="contrast" data-reveal>
        <thead>
          <tr>
            <th scope="col" class="label">Con software genérico</th>
            <th scope="col" class="label">Con software a tu medida</th>
          </tr>
        </thead>
        <tbody>
          {
            contrast.map(([generic, custom]) => (
              <tr>
                <td data-label="Con software genérico">{generic}</td>
                <td data-label="Con software a tu medida">{custom}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="act build" id="construir" aria-labelledby="construir-title">
    <div class="act__inner">
      <div class="grid-12">
        <div class="head build__head" data-reveal>
          <p class="label label--rule">Qué construimos</p>
          <h2 id="construir-title" class="h2 head__title">
            Si hoy te estorba, se puede <em>construir.</em>
          </h2>
          <p class="lead">
            No tenemos catálogo. Estos son puntos de partida; lo tuyo puede no parecerse a
            ninguno.
          </p>
        </div>
      </div>
      <ul class="bento" data-bento>
        {
          tiles.map((t) => (
            <li class:list={["tile", { "tile--wide": t.wide }]} data-reveal>
              <div class="tile__art" aria-hidden="true">
                {t.art === "bars" && (
                  <div class="art-bars">
                    <i class="art-bars__bar art-bars__bar--off" />
                    <i class="art-bars__bar art-bars__bar--off art-bars__bar--short" />
                    <i class="art-bars__bar art-bars__bar--off" />
                    <i class="art-bars__bar art-bars__bar--on" />
                    <i class="art-bars__bar art-bars__bar--on art-bars__bar--short" />
                  </div>
                )}
                {t.art === "checks" && (
                  <div class="art-checks">
                    <span class="art-checks__row">
                      <i class="art-checks__dot" />
                      <i class="art-checks__line" />
                    </span>
                    <span class="art-checks__row">
                      <i class="art-checks__dot" />
                      <i class="art-checks__line art-checks__line--short" />
                    </span>
                    <span class="art-checks__row">
                      <i class="art-checks__dot" />
                      <i class="art-checks__line" />
                    </span>
                  </div>
                )}
                {t.art === "nodes" && (
                  <svg class="art-nodes" viewBox="0 0 160 96" fill="none">
                    <path class="art-nodes__link" d="M16 16 C 80 16, 80 48, 144 48" />
                    <path class="art-nodes__link" d="M16 48 L 144 48" />
                    <path class="art-nodes__link" d="M16 80 C 80 80, 80 48, 144 48" />
                    <circle class="art-nodes__node" cx="16" cy="16" r="6" />
                    <circle class="art-nodes__node" cx="16" cy="48" r="6" />
                    <circle class="art-nodes__node" cx="16" cy="80" r="6" />
                    <circle class="art-nodes__hub" cx="144" cy="48" r="9" />
                  </svg>
                )}
                {t.art === "browser" && (
                  <div class="art-browser">
                    <span class="art-browser__bar">
                      <i class="art-browser__dot" />
                      <i class="art-browser__dot" />
                      <i class="art-browser__dot" />
                    </span>
                    <span class="art-browser__body">
                      <i class="art-browser__line" />
                      <i class="art-browser__line art-browser__line--short" />
                      <i class="art-browser__line" />
                      <i class="art-browser__btn" />
                    </span>
                  </div>
                )}
                {t.art === "chart" && (
                  <svg class="art-chart" viewBox="0 0 160 96" fill="none">
                    <rect class="art-chart__bar" x="24" y="52" width="32" height="44" rx="4" />
                    <rect class="art-chart__bar" x="72" y="32" width="32" height="64" rx="4" />
                    <path class="art-chart__line" d="M8 76 L 56 48 L 104 56 L 152 12" />
                    <circle class="art-chart__tip" cx="152" cy="12" r="5" />
                  </svg>
                )}
                {t.art === "phone" && (
                  <div class="art-phone">
                    <i class="art-phone__row" />
                    <i class="art-phone__row art-phone__row--short" />
                    <i class="art-phone__row" />
                  </div>
                )}
              </div>
              <h3 class="h3 tile__title">{t.title}</h3>
              <p class="small tile__text">{t.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="build__more" data-reveal>
        <a class="link link--arrow" href="/contacto">¿No ves lo tuyo? Mejor. Cuéntanos.</a>
      </p>
    </div>
  </section>

  <section class="act company" aria-labelledby="acomp-title">
    <div class="act__inner grid-12">
      <div class="company__card" data-reveal>
        <p class="label label--rule">Acompañamiento</p>
        <h2 id="acomp-title" class="h2">
          No desaparecemos <em>después de entregar.</em>
        </h2>
        <p class="lead">Lo importante no es el software. Es que tu día a día se sienta mejor.</p>
      </div>
      <ol class="company__steps">
        {
          accompaniment.map(([num, title, text]) => (
            <li class="step" data-reveal>
              <span class="caption numeral step__num">{num}</span>
              <h3 class="h3 step__title">{title}</h3>
              <p class="step__text">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="chapter ground-dark act" aria-labelledby="tuyo-title">
    <div class="act__inner grid-12">
      <div class="own__head" data-reveal>
        <p class="label label--rule">Propiedad</p>
        <h2 id="tuyo-title" class="display-2">
          Se paga una vez. <em>Y es tuyo.</em>
        </h2>
        <p class="lead">
          Sin renta mensual por usuario. Sin contratos que te amarren. Lo que construimos para tu
          empresa es de tu empresa.
        </p>
      </div>
      <dl class="own__rail" data-reveal>
        {
          ownership.map(([concept, value]) => (
            <div class="own__row">
              <dt class="label">{concept}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    cases.length > 0 && (
      <section class="act cases" aria-labelledby="casos-title">
        <div class="act__inner">
          <div class="head" data-reveal>
            <p class="label label--rule">Casos</p>
            <h2 id="casos-title" class="h2 head__title">
              Tu operación no aparece <em>en nuestro sitio.</em>
            </h2>
            <p class="lead">
              Por eso aquí no hay logotipos. Contamos lo que hicimos sin decir para quién.
            </p>
          </div>
          <ul class="cases__list">
            {cases.map((c) => (
              <li class="cases__item">
                <dl>
                  <div>
                    <dt class="label">Giro y tamaño aproximado</dt>
                    <dd>{c.sector}</dd>
                  </div>
                  <div>
                    <dt class="label">Qué pasaba</dt>
                    <dd>{c.before}</dd>
                  </div>
                  <div>
                    <dt class="label">Qué construimos</dt>
                    <dd>{c.built}</dd>
                  </div>
                  <div>
                    <dt class="label">Qué cambió</dt>
                    <dd>{c.after}</dd>
                  </div>
                </dl>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="act faq" aria-labelledby="faq-title">
    <div class="act__inner grid-12">
      <div class="faq__head" data-reveal>
        <p class="label label--rule">Preguntas</p>
        <h2 id="faq-title" class="h2">
          Lo que conviene saber <em>antes de empezar.</em>
        </h2>
      </div>
      <div class="faq__list" data-reveal>
        {
          faq.map(([question, answer]) => (
            <details class="qa">
              <summary class="qa__q">
                <span class="h3">{question}</span>
                <span class="qa__icon" aria-hidden="true" />
              </summary>
              <p class="qa__a">{answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="chapter ground-dark act closing-act" aria-labelledby="cierre-title">
    <div class="act__inner">
      <div class="closing" data-reveal>
        <h2 id="cierre-title" class="display-2">
          ¿Qué te gustaría <em>dejar de hacer?</em>
        </h2>
        <p class="lead">
          Cuéntanoslo como te salga. Te contesta una persona y te decimos con honestidad si te
          podemos ayudar.
        </p>
        <div class="actions closing__actions">
          <a class="btn btn--primary" href="/contacto">Cuéntanos tu idea</a>
          {
            waHref && (
              <a class="btn btn--secondary" href={waHref} target="_blank" rel="noopener">
                Escribir por WhatsApp
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // The spotlight on the tiles follows the pointer. One delegated listener,
  // and only where there is a pointer to follow.
  const bento = document.querySelector<HTMLElement>("[data-bento]");
  if (bento && window.matchMedia("(hover: hover)").matches) {
    bento.addEventListener("pointermove", (event) => {
      const tile = (event.target as HTMLElement).closest<HTMLElement>(".tile");
      if (!tile) return;
      const box = tile.getBoundingClientRect();
      tile.style.setProperty("--x", `${event.clientX - box.left}px`);
      tile.style.setProperty("--y", `${event.clientY - box.top}px`);
    });
  }
</script>

<style>
  /* the break stays at every width so the title never strands a lone "a" */
  .hero__br {
    display: block;
  }
  @media (width >= 64rem) {
    .hero__title {
      text-wrap: wrap;
    }
  }

  /* --- 2. Contraste ----------------------------------------------------- */
  .contrast__head {
    --col: 1 / span 9;
  }
  .contrast {
    width: 100%;
    border-collapse: collapse;
    text-align: start;
  }
  .contrast th {
    padding-block: var(--space-3);
    text-align: start;
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .contrast td {
    width: 50%;
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
    vertical-align: top;
    border-block-end: var(--hairline) solid var(--hairline-color);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    letter-spacing: var(--tracking-lead);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }
  .contrast td:last-child {
    padding-inline-end: 0;
    color: var(--fg);
    font-weight: var(--weight-medium);
  }
  @media (width <= 40rem) {
    .contrast thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .contrast,
    .contrast tbody,
    .contrast tr,
    .contrast td {
      display: block;
      width: 100%;
    }
    .contrast tr {
      padding-block: var(--space-5);
      border-block-end: var(--hairline) solid var(--hairline-color);
    }
    .contrast td {
      padding: 0;
      border: 0;
    }
    .contrast td + td {
      margin-block-start: var(--space-4);
    }
    .contrast td::before {
      content: attr(data-label);
      display: block;
      margin-block-end: var(--space-1);
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
      font-weight: var(--weight-medium);
      font-stretch: var(--width-condensed);
      color: var(--fg-muted);
    }
  }

  /* --- 3. Qué construimos ------------------------------------------------ */
  .build__head {
    --col: 1 / span 8;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gutter);
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    min-height: 18.75rem;
    padding: var(--space-6);
    background: var(--bg-raised);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .tile--wide {
    grid-column: span 2;
  }
  .tile::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: var(--hairline);
    background: radial-gradient(
      18rem circle at var(--x, 50%) var(--y, 50%),
      var(--interactive),
      transparent 70%
    );
    -webkit-mask:
      linear-gradient(black 0 0) content-box,
      linear-gradient(black 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
    pointer-events: none;
  }
  @media (hover: hover) {
    .tile:hover::after {
      opacity: 1;
    }
  }
  @media (max-width: 56rem) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .tile--wide {
      grid-column: span 1;
    }
  }
  @media (max-width: 40rem) {
    .bento {
      grid-template-columns: 1fr;
    }
  }
  .tile__art {
    margin-block-end: auto;
    height: var(--space-9);
    display: flex;
    align-items: flex-start;
  }
  .tile__title {
    max-width: 22ch;
  }
  .tile__text {
    max-width: 30ch;
  }
  .build__more {
    margin-block-start: var(--space-6);
  }

  /* Viñetas: HTML y CSS con colores de tokens, sin texto */
  .art-bars {
    display: grid;
    gap: var(--space-2);
    width: 9rem;
  }
  .art-bars__bar {
    position: relative;
    display: block;
    height: var(--space-2);
    border-radius: var(--radius-pill);
  }
  .art-bars__bar--short {
    width: 62%;
  }
  .art-bars__bar--off {
    background: var(--hairline-color);
  }
  .art-bars__bar--off::after {
    content: "";
    position: absolute;
    inset-inline: calc(var(--space-1) * -1);
    inset-block-start: 50%;
    border-block-start: var(--hairline) solid var(--fg-muted);
  }
  .art-bars__bar--on {
    background: var(--interactive);
  }

  .art-checks {
    display: grid;
    gap: var(--space-3);
  }
  .art-checks__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .art-checks__dot {
    position: relative;
    display: block;
    width: var(--space-5);
    height: var(--space-5);
    border-radius: 50%;
    background: var(--interactive);
  }
  .art-checks__dot::after {
    content: "";
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 46%;
    width: 0.3rem;
    height: 0.55rem;
    translate: -50% -50%;
    rotate: 45deg;
    border-inline-end: var(--hairline-strong) solid var(--action-fg);
    border-block-end: var(--hairline-strong) solid var(--action-fg);
  }
  .art-checks__line {
    display: block;
    width: 5.5rem;
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--hairline-color);
  }
  .art-checks__line--short {
    width: 3.5rem;
  }

  .art-nodes,
  .art-chart {
    width: 10rem;
    height: auto;
    overflow: visible;
  }
  .art-nodes__link {
    stroke: var(--control-border);
    stroke-width: 1;
  }
  .art-nodes__node {
    fill: var(--bg-raised);
    stroke: var(--fg-secondary);
    stroke-width: 1.5;
  }
  .art-nodes__hub {
    fill: var(--interactive);
  }
  .art-chart__bar {
    fill: var(--hairline-color);
  }
  .art-chart__line {
    stroke: var(--interactive);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .art-chart__tip {
    fill: var(--interactive);
  }

  .art-browser {
    width: 9rem;
    border: var(--hairline) solid var(--control-border);
    border-radius: var(--radius-s);
    overflow: hidden;
  }
  .art-browser__bar {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-2);
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
  .art-browser__dot {
    display: block;
    width: var(--space-1);
    height: var(--space-1);
    border-radius: 50%;
    background: var(--control-border);
  }
  .art-browser__body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
  }
  .art-browser__line {
    display: block;
    height: var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--hairline-color);
  }
  .art-browser__line--short {
    width: 60%;
  }
  .art-browser__btn {
    display: block;
    width: var(--space-6);
    height: var(--space-3);
    border-radius: var(--radius-xs);
    background: var(--interactive);
  }

  .art-phone {
