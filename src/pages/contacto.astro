---
import Strands from "../components/Strands.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { hasWhatsapp, site, waMessages, whatsappUrl } from "../site";

const waHref = whatsappUrl(waMessages.contacto);

const titleWords = "¿Qué te gustaría dejar de hacer?".split(" ");

const nextSteps = [
  "Leemos tu mensaje. Lo contesta quien trabajaría tu caso, no un vendedor.",
  "Hablamos 30 minutos sobre tu negocio. Cero presentación de ventas.",
  "Si te podemos ayudar, te mandamos una propuesta en una página. Si no, te lo decimos en la llamada.",
];

const sizes = ["1–10", "11–50", "51–200", "más de 200"];
const emptyMessage = "Sin esto no podemos ayudarte: cuéntanos aunque sea en una línea.";
---

<BaseLayout
  title="Contacto — Pragmasyn"
  description="Cuéntanos qué te gustaría resolver. Te contesta una persona y te decimos con honestidad si te podemos ayudar."
  ogTitle="¿Qué te gustaría dejar de hacer?"
  ogDescription="Cuéntanos tu idea. Te contesta una persona."
  path="/contacto"
>
  <section class="opening" aria-labelledby="contact-title">
    <div class="desk">
      <p class="label">Contacto</p>
      <h1 id="contact-title" class="monument">
        {
          titleWords.map((word, i) => (
            <>
              <span class="monument__word" style={`--i: ${i};`}>
                {word}
              </span>{" "}
            </>
          ))
        }
      </h1>
      <p class="monument__lead">
        Cuéntanoslo con tus palabras. Te contesta una persona y te decimos con honestidad si
        te podemos ayudar, incluso si la respuesta es que no nos necesitas.
      </p>
    </div>
  </section>

  <section class="contact-act" aria-labelledby="form-title">
    <div class="desk">
      <div class="gallery ground-paper">
        <div class="spread">
          {
            hasWhatsapp && waHref && (
              <a class="plate ground-dark" href={waHref} target="_blank" rel="noopener">
                <Strands class="plate__art" />
                <div class="plate__head">
                  <p class="label">Lo más rápido</p>
                  <p class="plate__title">Escríbenos por WhatsApp</p>
                </div>
                <div class="chat" aria-hidden="true" data-chat>
                  <p class="chat__out">
                    <span data-chat-typed>{waMessages.contacto}</span><span class="chat__rest" data-chat-rest></span>
                    <svg class="chat__ticks" viewBox="0 0 18 10" focusable="false">
                      <path d="M1 5.5 4 8.5 10 1.5M7.5 7 9 8.5 15.5 1.5" />
                    </svg>
                  </p>
                  <p class="chat__in">
                    <i />
                    <i />
                    <i />
                  </p>
                </div>
                <div class="plate__foot">
                  <p class="plate__text">
                    Mándanos tu idea como se la contarías a alguien de confianza. Contesta una
                    persona, en horario hábil.
                  </p>
                  <span class="btn btn--primary plate__cta">Abrir WhatsApp</span>
                </div>
              </a>
            )
          }

          <div class="contact__form">
            <h2 id="form-title" class="h2 gallery__title">O déjanos tu mensaje</h2>
            <form class="contact-form" novalidate data-wa-number={site.whatsappNumber}>
              <div class="field" data-field="name">
                <label class="small" for="cf-name">Nombre</label>
                <input
                  id="cf-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder="¿Cómo te llamamos?"
                  required
                />
                <p class="caption field__msg" id="cf-name-msg" hidden>{emptyMessage}</p>
              </div>
              <div class="field" data-field="company">
                <label class="small" for="cf-company">Empresa</label>
                <input
                  id="cf-company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                  placeholder="Nombre de tu empresa"
                  required
                />
                <p class="caption field__msg" id="cf-company-msg" hidden>{emptyMessage}</p>
              </div>
              <div class="field" data-field="email">
                <label class="small" for="cf-email">Correo</label>
                <input
                  id="cf-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="nombre@empresa.mx"
                  required
                />
                <p class="caption field__msg" id="cf-email-msg" hidden>
                  Ese correo no parece completo. Revísalo y volvemos a intentar.
                </p>
              </div>
              <div class="field" data-field="size">
                <label class="small" for="cf-size">Tamaño de tu equipo (opcional)</label>
                <span class="field__select">
                  <select id="cf-size" name="size">
                    <option value="">Selecciona</option>
                    {sizes.map((s) => <option value={s}>{s}</option>)}
                  </select>
                </span>
              </div>
              <div class="field" data-field="message">
                <label class="small" for="cf-message">¿Qué quieres resolver?</label>
                <textarea
                  id="cf-message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Dos o tres líneas bastan. Ej.: ‘Pagamos un sistema caro y solo usamos una parte.’"
                ></textarea>
                <p class="caption field__msg" id="cf-message-msg" hidden>{emptyMessage}</p>
              </div>
              <div class="field" data-field="consent">
                <label class="small consent">
                  <input id="cf-consent" name="consent" type="checkbox" />
                  <span>
                    Acepto que Pragmasyn use mis datos para responderme.
                    <a class="link" href="/privacidad">Aviso de privacidad</a>.
                  </span>
                </label>
              </div>
              <div class="contact-form__trap" aria-hidden="true">
                <label>
                  Sitio web
                  <input name="website" type="text" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <button
                class="btn btn--primary"
                type="submit"
                aria-describedby="cf-consent-hint"
                disabled
              >
                Enviar mensaje
              </button>
              <p class="caption" id="cf-consent-hint">Para enviarlo, acepta el aviso de privacidad.</p>
              <p class="caption contact-form__micro">
                Respondemos en menos de 24 horas hábiles. Sin secuencia de correos automáticos.
              </p>
              <p class="small contact-form__status" role="status" aria-live="polite"></p>
            </form>
          </div>
        </div>

        <div class="direct">
          <div class="direct__side">
            <h2 class="label" id="direct-title">Directo</h2>
            <p class="small">¿Prefieres el correo?</p>
          </div>
          <div class="direct__main">
            <a class="direct__mail" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>

        <div class="next">
          <h2 class="h2 gallery__title" id="next-title">Qué sigue</h2>
          <ol class="next__list" aria-labelledby="next-title">
            {
              nextSteps.map((step, i) => (
                <li class="next__item line" style={`--i: ${i};`}>
                  <span class="next__num" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <p>{step}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <div class="toast ground-light" role="status" aria-live="polite" data-toast></div>
</BaseLayout>

<script>
  // Mejora progresiva: validación y envío con la voz de la marca.
  // El mensaje va a nuestro Worker (workers/contacto) y de ahí a nuestro correo.
  const form = document.querySelector<HTMLFormElement>(".contact-form");
  const toast = document.querySelector<HTMLElement>("[data-toast]");
  const waNumber = form?.dataset["waNumber"] ?? "";

  // El botón queda deshabilitado hasta que se acepte el aviso de privacidad.
  const consent = form?.querySelector<HTMLInputElement>("#cf-consent");
  const submitBtn = form?.querySelector<HTMLButtonElement>("button[type=submit]");
  const consentHint = form?.querySelector<HTMLElement>("#cf-consent-hint");
  const syncSubmit = (): void => {
    if (!consent || !submitBtn) return;
    submitBtn.disabled = !consent.checked;
    if (consentHint) consentHint.hidden = consent.checked;
  };
  consent?.addEventListener("change", syncSubmit);
  // A reload or a trip back can restore the checked box without a change event.
  window.addEventListener("pageshow", syncSubmit);

  // Lo que se escribió en la barra del cierre llega aquí ya puesto.
  try {
    const idea = sessionStorage.getItem("pragmasyn:idea");
    const field = form?.querySelector<HTMLTextAreaElement>("#cf-message");
    if (idea && field && !field.value) field.value = idea;
    sessionStorage.removeItem("pragmasyn:idea");
  } catch {
    // Storage can be blocked; the form simply starts empty.
  }

  function setFieldError(name: string, on: boolean): void {
    const wrap = form?.querySelector<HTMLElement>(`[data-field="${name}"]`);
    const msg = wrap?.querySelector<HTMLElement>(".field__msg");
    const input = wrap?.querySelector<HTMLInputElement | HTMLTextAreaElement>("input, textarea");
    wrap?.classList.toggle("field--error", on);
    if (msg) msg.hidden = !on;
    input?.setAttribute("aria-invalid", String(on));
    // the message only describes the field while it is showing
    if (msg?.id) {
      if (on) input?.setAttribute("aria-describedby", msg.id);
      else input?.removeAttribute("aria-describedby");
    }
    if (on && wrap) {
      // restart the wiggle on every failed attempt
      wrap.classList.remove("is-wiggling");
      void wrap.offsetWidth;
      wrap.classList.add("is-wiggling");
    }
  }

  let toastTimer: number | undefined;
  function showToast(text: string): void {
    if (!toast) return;
    window.clearTimeout(toastTimer);
    toast.textContent = text;
    toast.classList.add("is-visible");
    toastTimer = window.setTimeout(() => {
      toast.classList.remove("is-visible");
      toast.textContent = "";
    }, 4000);
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const company = String(data.get("company") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const size = String(data.get("size") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();

    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    setFieldError("name", name.length === 0);
    setFieldError("company", company.length === 0);
    setFieldError("email", !emailOk);
    setFieldError("message", message.length === 0);
    if (name.length === 0 || company.length === 0 || !emailOk || message.length === 0) {
      // the first error takes focus so it is announced and brought into view
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    const status = form.querySelector<HTMLElement>(".contact-form__status");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!status || !button) return;

    status.textContent = "";

    // Si el envío no sale, la conversación no se pierde: se ofrece el mismo
    // mensaje por WhatsApp, ya escrito.
    const fail = (): void => {
      status.textContent =
        "El mensaje no salió — es cosa nuestra, no tuya. Mándanoslo por aquí y no lo escribes de nuevo: ";
      if (!waNumber) {
        status.textContent =
          "El mensaje no salió — es cosa nuestra, no tuya. Intenta de nuevo o escríbenos directo.";
        return;
      }
      const draft = `Hola Pragmasyn. Soy ${name} de ${company}. Lo que quiero resolver: ${message}`;
      const link = document.createElement("a");
      link.className = "link";
      link.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(draft)}`;
      link.target = "_blank";
      link.rel = "noopener";
      link.textContent = "abrir WhatsApp con tu mensaje";
      status.append(link);
    };

    button.classList.add("btn--loading");
    button.setAttribute("aria-busy", "true");
    const website = String(data.get("website") ?? "");
    fetch("/api/contacto", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({ name, company, email, size, message, website }),
    })
      .then((res) => {
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        syncSubmit(); // el reset destilda el consentimiento
        showToast("Recibido. Te contesta una persona, no un autoresponder.");
      })
      .catch(fail)
      .finally(() => {
        button.classList.remove("btn--loading");
        button.removeAttribute("aria-busy");
      });
  });

  // Glass over white turns gray, so the header goes nearly solid over the sheet.
  const gallery = document.querySelector(".gallery");
  if (gallery) {
    new IntersectionObserver(
      ([entry]) => {
        document.documentElement.classList.toggle("over-paper", entry?.isIntersecting ?? false);
      },
      { rootMargin: "0px 0px -90% 0px" },
    ).observe(gallery);
  }

  // The plate writes the message it will open with, and someone starts to
  // answer. It runs on its own, in a loop, only while it is on screen. Without
  // JavaScript or with reduced motion the message simply sits there.
  const chat = document.querySelector<HTMLElement>("[data-chat]");
  const typed = chat?.querySelector<HTMLElement>("[data-chat-typed]");
  const rest = chat?.querySelector<HTMLElement>("[data-chat-rest]");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (chat && typed && rest && !calm) {
    const text = typed.textContent ?? "";
    const wait = (ms: number): Promise<void> =>
      new Promise((resolve) => window.setTimeout(resolve, ms));

    let inView = false;
    let wake: (() => void) | undefined;
    const arrival = (): Promise<void> =>
      inView ? Promise.resolve() : new Promise((resolve) => (wake = resolve));
    new IntersectionObserver(([entry]) => {
      inView = entry?.isIntersecting ?? false;
      if (inView) wake?.();
    }).observe(chat);

    // the unwritten part stays in the line, hidden, so nothing reflows
    const write = (count: number): void => {
      typed.textContent = text.slice(0, count);
      rest.textContent = text.slice(count);
    };

    const play = async (): Promise<void> => {
      for (;;) {
        await arrival();
        write(0);
        chat.dataset["step"] = "writing";
        await wait(500);
        for (let count = 1; count <= text.length; count++) {
          write(count);
          await wait(30);
        }
        await wait(350);
        chat.dataset["step"] = "sent";
        await wait(900);
        chat.dataset["step"] = "answering";
        await wait(4200);
        chat.dataset["step"] = "clearing";
        await wait(420);
      }
    };
    write(0);
    chat.dataset["step"] = "writing";
    void play();
  }
</script>

<style>
  /* Gallery paper on the night: the title stands on the dark page, huge and
     alone, and everything else is one sheet as wide as the header, so the
     constellation stays in view around it. */
  .desk {
    --form-pad: var(--space-6);
    --sheet-pad: var(--space-3);
    container-type: inline-size;
    max-width: calc(68rem + 2 * var(--margin));
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  /* --- la apertura: el título es la página ---------------------------------- */
  .monument {
    margin-block-start: var(--space-3);
    font-size: 11.6cqi;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-hero);
    font-weight: var(--weight-light);
    font-stretch: var(--width-heading);
    text-wrap: balance;
  }
  .monument__word {
    display: inline-block;
  }
  /* it starts where the form's text starts, inside the sheet */
  .monument__lead {
    margin-block-start: var(--space-6);
    margin-inline-start: calc(
      (100% - 3 * var(--sheet-pad)) * 5 / 12 + 2 * var(--sheet-pad) + var(--form-pad)
    );
    font-size: var(--text-statement);
    line-height: var(--leading-statement);
    letter-spacing: var(--tracking-lead);
    text-shadow: 0 0 24px rgb(var(--rgb-ink));
    text-wrap: pretty;
  }
  @media (prefers-reduced-motion: no-preference) {
    .monument__word {
      animation: word-in var(--dur-5) var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 55ms);
    }
    .monument__lead {
      animation: word-in var(--dur-5) var(--ease-out) 340ms backwards;
    }
    .gallery {
      animation: gallery-in 1200ms var(--ease-out) 420ms backwards;
    }
  }
  @keyframes word-in {
    from {
      opacity: 0;
      translate: 0 0.25em;
      filter: blur(10px);
    }
  }
  @keyframes gallery-in {
    from {
      opacity: 0;
      translate: 0 var(--space-8);
    }
  }

  /* --- la hoja ---------------------------------------------------------------- */
  .contact-act {
    padding-block-end: clamp(var(--space-8), 8vw, var(--space-10));
  }
  .gallery {
    --hairline-color: var(--paper-ink);
    --control-border: var(--paper-ink);
    padding: var(--sheet-pad);
    border-radius: var(--radius-2xl);
  }
  :global(html.over-paper) {
    --glass-alpha: 0.92;
  }
  .spread {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--sheet-pad);
  }
  .gallery__title {
    font-size: var(--text-paper);
    line-height: var(--leading-paper);
    letter-spacing: var(--tracking-h2);
    font-weight: var(--weight-light);
  }

  /* --- la placa: la única superficie oscura de la hoja ------------------------ */
  .plate {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-5);
    min-width: 0;
    overflow: hidden;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface-lit);
    color: var(--fg);
    text-decoration: none;
  }
  /* the ring sits inside the plate, where it lands on the dark */
  .plate:focus-visible {
    border-radius: var(--radius-l);
    outline-offset: calc(-2 * var(--focus-width));
  }
  .plate :global(.plate__art) {
    inset-block-end: 4%;
    inset-inline-end: -44%;
    width: 120%;
  }
  /* the mark sinks into the night before it reaches the text */
  .plate::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, var(--violet-night) 24%, transparent 56%);
  }
  /* here the mark has no stars to lend its light to: it stays drawn */
  :global(.has-constellation) .plate :global(.strands__form) {
    opacity: 0.92;
  }
  :global(.has-constellation) .plate :global(.strands__glow) {
    opacity: 0.8;
  }
  .plate__head {
    display: grid;
    gap: var(--space-2);
  }
  .plate__title {
    font-size: var(--text-paper);
    line-height: var(--leading-paper);
    letter-spacing: var(--tracking-h2);
    font-weight: var(--weight-light);
    font-stretch: var(--width-heading);
    text-wrap: balance;
  }
  .plate__foot {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .plate__text {
    max-width: var(--measure);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }
  .plate:hover .plate__cta {
    background: var(--action-bg-strong);
    box-shadow:
      0 0 0 4px rgb(var(--rgb-light) / 0.12),
      0 0 32px rgb(var(--rgb-blue) / 0.45);
  }

  /* --- la conversación ------------------------------------------------------- */
  .chat {
    align-self: center;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  .chat__out,
  .chat__in {
    transition:
      opacity var(--dur-3) var(--ease-out),
      translate var(--dur-3) var(--ease-out),
      scale var(--dur-3) var(--ease-spring);
  }
  .chat__out {
    justify-self: end;
    max-width: 88%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-l) var(--radius-l) var(--radius-s) var(--radius-l);
    background: var(--white);
    color: var(--paper-ink);
    text-wrap: pretty;
  }
  .chat__rest {
    visibility: hidden;
  }
  .chat__ticks {
    display: inline-block;
    width: 1.125rem;
    height: 0.625rem;
    margin-inline-start: var(--space-2);
    fill: none;
    stroke: var(--lit-b);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity var(--dur-2) var(--ease-out),
      scale var(--dur-3) var(--ease-spring);
  }
  .chat__in {
    justify-self: start;
    display: flex;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-l) var(--radius-l) var(--radius-l) var(--radius-s);
    background: rgb(var(--rgb-ink) / 0.56);
    box-shadow: var(--shadow-glass);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    transform-origin: 0 100%;
    opacity: 0;
    translate: 0 var(--space-2);
    scale: 0.9;
  }
  .chat__in i {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: 50%;
    background: var(--white);
  }
  .chat[data-step="sent"] .chat__ticks,
  .chat[data-step="answering"] .chat__ticks {
    opacity: 1;
    scale: 1;
  }
  .chat[data-step="answering"] .chat__in {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  .chat[data-step="answering"] .chat__in i {
    animation: chat-dot 1.2s var(--ease-in-out) infinite;
  }
  .chat[data-step="answering"] .chat__in i:nth-child(2) {
    animation-delay: 160ms;
  }
  .chat[data-step="answering"] .chat__in i:nth-child(3) {
    animation-delay: 320ms;
  }
  .chat[data-step="clearing"] .chat__out,
  .chat[data-step="clearing"] .chat__in {
    opacity: 0;
    translate: 0 calc(-1 * var(--space-2));
  }
  @keyframes chat-dot {
    0%,
    60%,
    100% {
      opacity: 0.4;
      translate: 0 0;
    }
    30% {
      opacity: 1;
      translate: 0 calc(-1 * var(--space-1));
    }
  }

  /* --- el formulario --------------------------------------------------------- */
  .contact__form {
    min-width: 0;
    padding: var(--space-5) var(--form-pad) var(--space-6);
  }
  /* without WhatsApp the form takes the whole sheet */
  .contact__form:only-child {
    grid-column: 1 / -1;
  }
  .contact-form {
    margin-block-start: var(--space-5);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .contact-form > * {
    grid-column: 1 / -1;
  }
  .contact-form > [data-field="name"],
  .contact-form > [data-field="company"],
  .contact-form > [data-field="email"],
  .contact-form > [data-field="size"] {
    grid-column: auto;
    align-content: start;
  }
  /* an outlined control: ink on paper, and focus only makes the line heavier */
  .gallery .field > label {
    font-weight: var(--weight-text);
  }
  .gallery .field input:not([type="checkbox"]),
  .gallery .field textarea,
  .gallery .field select {
    min-height: 3.25rem;
    padding: var(--space-3) var(--space-4);
