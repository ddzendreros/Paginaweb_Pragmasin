---
import BaseLayout from "../layouts/BaseLayout.astro";
import { hasWhatsapp, site, waMessages, whatsappUrl } from "../site";

const waHref = whatsappUrl(waMessages.contacto);

const nextSteps = [
  "Leemos tu mensaje. Lo contesta quien trabajaría tu caso, no un vendedor.",
  "Llamada de 30 minutos: preguntas directas sobre tu operación, cero presentación de ventas.",
  "Si hay horas que recuperar, propuesta en una página. Si no las hay, te lo decimos en la llamada.",
];

const sizes = ["menos de 50", "50–150", "150–500", "más de 500"];
---

<BaseLayout
  title="Contacto — Pragmasyn"
  description="Cuéntanos qué proceso te está costando más horas. Te respondemos con una lectura honesta, incluso si la respuesta es que no nos necesitas."
  ogTitle="¿Qué sigues haciendo a mano?"
  ogDescription="Escríbenos el proceso que más horas te cuesta. Respondemos en menos de 24 horas hábiles."
  path="/contacto"
>
  <section class="ground-dark act opening" aria-labelledby="contact-title">
    <div class="act__inner">
      <div class="act__head" data-reveal>
        <p class="label eyebrow">Contacto</p>
        <h1 id="contact-title" class="display">¿Qué sigues haciendo a mano?</h1>
        <p class="lead">
          Cuéntanos el proceso que más horas te está costando. Te respondemos con
          una lectura honesta — incluso si la respuesta es que no nos necesitas.
        </p>
      </div>
    </div>
  </section>

  <section class="ground-light act form-act" aria-labelledby="form-title">
    <div class="act__inner form-act__grid">
      <div class="card card--feature form-act__form" data-reveal>
        <h2 id="form-title" class="h3">Cuéntanos</h2>
        <p class="small form-act__handoff" data-calc-handoff hidden>
          <strong>Traemos tu cálculo.</strong> Puedes editarlo o borrarlo antes
          de enviar.
        </p>
        <form class="contact-form" novalidate data-wa-number={site.whatsappNumber}>
          <div class="field" data-field="name">
            <label class="small" for="cf-name">Nombre</label>
            <input id="cf-name" name="name" type="text" autocomplete="name"
              placeholder="¿Cómo te llamamos?" required />
            <p class="caption field__msg" hidden>
              Sin esto no podemos ayudarte: cuéntanos aunque sea en una línea.
            </p>
          </div>
          <div class="field" data-field="company">
            <label class="small" for="cf-company">Empresa</label>
            <input id="cf-company" name="company" type="text"
              autocomplete="organization" placeholder="Nombre de tu empresa" required />
            <p class="caption field__msg" hidden>
              Sin esto no podemos ayudarte: cuéntanos aunque sea en una línea.
            </p>
          </div>
          <div class="field" data-field="email">
            <label class="small" for="cf-email">Correo de trabajo</label>
            <input id="cf-email" name="email" type="email" autocomplete="email"
              placeholder="nombre@empresa.mx" required />
            <p class="caption field__msg" hidden>
              Ese correo no parece completo. Revísalo y volvemos a intentar.
            </p>
          </div>
          <div class="field" data-field="size">
            <label class="small" for="cf-size">Número de empleados</label>
            <span class="field__select">
              <select id="cf-size" name="size">
                <option value="">Selecciona</option>
                {sizes.map((s) => <option value={s}>{s}</option>)}
              </select>
            </span>
          </div>
          <div class="field" data-field="message">
            <label class="small" for="cf-message">
              ¿Qué proceso te está costando más horas?
            </label>
            <textarea id="cf-message" name="message" rows="5" required
              placeholder="Dos o tres líneas bastan. Ej.: ‘Dos personas capturan facturas de proveedor en PDF todos los días.’"
            ></textarea>
            <p class="caption field__msg" hidden>
              Sin esto no podemos ayudarte: cuéntanos aunque sea en una línea.
            </p>
          </div>
          <div class="field" data-field="consent">
            <label class="small consent">
              <input id="cf-consent" name="consent" type="checkbox" />
              <span>
                Acepto que Pragmasyn use mis datos para responderme.
                <a class="link" href="/privacidad">Aviso de privacidad</a>.
              </span>
            </label>
          </div>
          <button class="btn btn--primary" type="submit" disabled>Enviar mensaje</button>
          <p class="caption contact-form__micro">
            Respondemos en menos de 24 horas hábiles. Sin secuencia de correos
            automáticos.
          </p>
          <p class="small contact-form__status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="form-act__aside">
        {
          hasWhatsapp && waHref && (
            <a class="card card--link wa-card" href={waHref} target="_blank" rel="noopener" data-reveal>
              <p class="label eyebrow">Más rápido</p>
              <p class="h4 wa-card__title">Escríbenos por WhatsApp</p>
              <p class="small wa-card__text">
                Mándanos el proceso que te está costando horas. Contesta una
                persona, en horario hábil.
              </p>
              <span class="link link--arrow wa-card__cta">Abrir WhatsApp</span>
            </a>
          )
        }

        <div class="card direct" data-reveal>
          <p class="label">Directo</p>
          <p class="small direct__text">
            ¿Prefieres el correo?
            <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>

        <div class="next-steps-block" data-reveal>
          <h2 class="h4" id="next-title">Qué sigue</h2>
          <ol class="next-steps" aria-labelledby="next-title">
            {
              nextSteps.map((step, i) => (
                <li class="next-steps__item">
                  <span class="caption next-steps__num" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <p class="small">{step}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Mejora progresiva: validación y envío con la voz de la marca.
  // El endpoint es requisito de lanzamiento; sin él el formulario degrada al
  // mensaje de error que apunta al contacto directo.
  const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
  const web3Key = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
  const form = document.querySelector<HTMLFormElement>(".contact-form");
  const waNumber = form?.dataset.waNumber ?? "";

  // Handoff desde la home: dos fuentes distintas prellenan el mismo
  // mensaje. `?h=&d=` viene de la calculadora; `?a=` de las tarjetas de
  // "Después del diagnóstico" y del CTA del diagnóstico. Solo se toca el
  // mensaje si el usuario no ha empezado a escribir.
  const params = new URLSearchParams(window.location.search);
  const message = form?.querySelector<HTMLTextAreaElement>("#cf-message");
  const handoff = document.querySelector<HTMLElement>("[data-calc-handoff]");
  const setMessage = (text: string): void => {
    if (!message) return;
    if (message.value.trim().length > 0) return;
    message.value = text;
    if (handoff) handoff.hidden = false;
  };

  const h = parseInt(params.get("h") ?? "", 10);
  const d = parseInt(params.get("d") ?? "", 10);
  if (Number.isFinite(h) && h > 0 && Number.isFinite(d) && d > 0) {
    const mx = new Intl.NumberFormat("es-MX");
    setMessage(
      "Calculé " + mx.format(h) + " horas al mes y $" + mx.format(d) +
        " al año. Quiero ver el desglose.",
    );
  }

  const automationPrefills: Record<string, string> = {
    diagnostico:
      "Me interesa agendar el diagnóstico. Cuéntenme cómo empezamos.",
    facturas:
      "Me interesa automatizar la captura de facturas de proveedor. Hoy llegan por correo y en PDF, y alguien las teclea a mano.",
    whatsapp:
      "Me interesa automatizar los pedidos que llegan por WhatsApp. Hoy alguien los transcribe al sistema.",
    reportes:
      "Me interesa automatizar el reporte que hoy se arma a mano. Los datos vienen de varios lados.",
  };
  const a = params.get("a") ?? "";
  const preset = automationPrefills[a];
  if (preset) setMessage(preset);

  // El botón queda deshabilitado hasta que se acepte el aviso de privacidad.
  const consent = form?.querySelector<HTMLInputElement>("#cf-consent");
  const submitBtn = form?.querySelector<HTMLButtonElement>("button[type=submit]");
  consent?.addEventListener("change", () => {
    if (submitBtn) submitBtn.disabled = !consent.checked;
  });

  function setFieldError(name: string, on: boolean): void {
    const wrap = form?.querySelector<HTMLElement>(`[data-field="${name}"]`);
    const msg = wrap?.querySelector<HTMLElement>(".field__msg");
    const input = wrap?.querySelector<HTMLInputElement | HTMLTextAreaElement>("input, textarea");
    wrap?.classList.toggle("field--error", on);
    if (msg) msg.hidden = !on;
    input?.setAttribute("aria-invalid", String(on));
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const company = String(data.get("company") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const size = String(data.get("size") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();

    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    setFieldError("name", name.length === 0);
    setFieldError("company", company.length === 0);
    setFieldError("email", !emailOk);
    setFieldError("message", message.length === 0);
    if (name.length === 0 || company.length === 0 || !emailOk || message.length === 0) return;

    const status = form.querySelector<HTMLElement>(".contact-form__status");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!status || !button) return;

    status.textContent = "";

    // Si el envío no sale, la conversación no se pierde: se ofrece el mismo
    // mensaje por WhatsApp, ya escrito.
    const fail = (): void => {
      status.textContent =
        "El mensaje no salió — es cosa nuestra, no tuya. Mándanoslo por aquí y no lo escribes de nuevo: ";
      if (!waNumber) {
        status.textContent =
          "El mensaje no salió — es cosa nuestra, no tuya. Intenta de nuevo o escríbenos directo.";
        return;
      }
      const draft = `Hola Pragmasyn. Soy ${name} de ${company}. El proceso que más horas me cuesta: ${message}`;
      const link = document.createElement("a");
      link.className = "link";
      link.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(draft)}`;
      link.target = "_blank";
      link.rel = "noopener";
      link.textContent = "abrir WhatsApp con tu mensaje";
      status.append(link);
    };

    if (!endpoint) {
      fail();
      return;
    }

    button.classList.add("btn--loading");
    button.setAttribute("aria-busy", "true");
    const payload: Record<string, string> = { name, company, email, size, message };
    if (web3Key) {
      payload.access_key = web3Key;
      payload.subject = `Nuevo contacto Pragmasyn: ${name} (${company})`;
    }
    fetch(endpoint, {
      method: "POST",
      headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify(payload),
    })
      .then((res) => {
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        button.disabled = true; // el reset destilda el consentimiento
        status.textContent = "Recibido. Te contesta una persona, no un autoresponder.";
      })
      .catch(fail)
      .finally(() => {
        button.classList.remove("btn--loading");
        button.removeAttribute("aria-busy");
      });
  });
</script>

<style>
  .opening {
    padding-block: clamp(var(--space-8), 10vw, var(--space-10));
  }
  .form-act__grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--gutter);
    align-items: start;
  }
  @media (max-width: 56rem) {
    .form-act__grid {
      grid-template-columns: 1fr;
    }
  }
  .form-act__handoff {
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--surface-card);
    border: var(--hairline) solid var(--surface-border);
    border-left: var(--hairline-strong) solid var(--interactive);
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
    color: var(--fg-secondary);
  }
  .form-act__handoff strong {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }

  .contact-form {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
  }
  .contact-form__micro {
    margin-top: calc(var(--space-2) * -1);
  }
  .contact-form__status:empty {
    display: none;
  }

  .form-act__aside {
    display: grid;
    gap: var(--gutter);
  }
  .wa-card__title {
    margin-top: var(--space-2);
  }
  .wa-card__text {
    margin-top: var(--space-3);
  }
  .wa-card__cta {
    margin-top: var(--space-4);
    display: inline-flex;
  }
  .direct__text {
    margin-top: var(--space-3);
  }

  .next-steps-block {
    padding-inline: var(--space-2);
  }
  .next-steps {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }
  .next-steps__item {
    display: grid;
    grid-template-columns: var(--space-7) 1fr;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: var(--hairline) solid var(--hairline-color);
  }
  .next-steps__num {
    font-stretch: var(--width-condensed);
  }
</style>
