---
import BaseLayout from "../layouts/BaseLayout.astro";
import { hasWhatsapp, site, waMessages, whatsappUrl } from "../site";

const waHref = whatsappUrl(waMessages.contacto);

const nextSteps = [
  "Leemos tu mensaje. Lo contesta quien trabajaría tu caso, no un vendedor.",
  "Hablamos 30 minutos sobre tu negocio. Cero presentación de ventas.",
  "Si te podemos ayudar, te mandamos una propuesta en una página. Si no, te lo decimos en la llamada.",
];

const sizes = ["1–10", "11–50", "51–200", "más de 200"];
const emptyMessage = "Sin esto no podemos ayudarte: cuéntanos aunque sea en una línea.";
---

<BaseLayout
  title="Contacto — Pragmasyn"
  description="Cuéntanos qué te gustaría resolver. Te contesta una persona y te decimos con honestidad si te podemos ayudar."
  ogTitle="¿Qué te gustaría dejar de hacer?"
  ogDescription="Cuéntanos tu idea. Te contesta una persona."
  path="/contacto"
>
  <section class="opening" aria-labelledby="contact-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <p class="label">Contacto</p>
          <h1 id="contact-title" class="display">
            ¿Qué te gustaría dejar de hacer?
          </h1>
        </div>
        <div class="opening__aside">
          <p class="lead">
            Cuéntanoslo con tus palabras. Te contesta una persona y te decimos con honestidad si
            te podemos ayudar, incluso si la respuesta es que no nos necesitas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="act contact-act" aria-labelledby="form-title">
    <div class="act__inner contact grid-12">
      <aside class="contact__side">
        {
          hasWhatsapp && waHref && (
            <a
              class="wa-card ground-cobalt"
              href={waHref}
              target="_blank"
              rel="noopener"
            >
              <p class="label">Lo más rápido</p>
              <p class="h3 wa-card__title">Escríbenos por WhatsApp</p>
              <p class="wa-card__text">
                Mándanos tu idea como se la contarías a alguien de confianza. Contesta una persona,
                en horario hábil.
              </p>
              <span class="link link--plain wa-card__cta">Abrir WhatsApp</span>
            </a>
          )
        }

        <div class="direct">
          <h2 class="label" id="direct-title">Directo</h2>
          <p class="small">
            ¿Prefieres el correo?
            <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>

        <div class="next">
          <h2 class="label" id="next-title">Qué sigue</h2>
          <ol class="next__list" aria-labelledby="next-title">
            {
              nextSteps.map((step, i) => (
                <li class="next__item">
                  <span class="caption numeral" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <p class="small">{step}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>

      <div class="contact__form">
        <h2 id="form-title" class="h3">O déjanos tu mensaje</h2>
        <form class="contact-form" novalidate data-wa-number={site.whatsappNumber}>
          <div class="field" data-field="name">
            <label class="small" for="cf-name">Nombre</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="¿Cómo te llamamos?"
              required
            />
            <p class="caption field__msg" id="cf-name-msg" hidden>{emptyMessage}</p>
          </div>
          <div class="field" data-field="company">
            <label class="small" for="cf-company">Empresa</label>
            <input
              id="cf-company"
              name="company"
              type="text"
              autocomplete="organization"
              placeholder="Nombre de tu empresa"
              required
            />
            <p class="caption field__msg" id="cf-company-msg" hidden>{emptyMessage}</p>
          </div>
          <div class="field" data-field="email">
            <label class="small" for="cf-email">Correo</label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="nombre@empresa.mx"
              required
            />
            <p class="caption field__msg" id="cf-email-msg" hidden>
              Ese correo no parece completo. Revísalo y volvemos a intentar.
            </p>
          </div>
          <div class="field" data-field="size">
            <label class="small" for="cf-size">Tamaño de tu equipo (opcional)</label>
            <span class="field__select">
              <select id="cf-size" name="size">
                <option value="">Selecciona</option>
                {sizes.map((s) => <option value={s}>{s}</option>)}
              </select>
            </span>
          </div>
          <div class="field" data-field="message">
            <label class="small" for="cf-message">¿Qué quieres resolver?</label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              required
              placeholder="Dos o tres líneas bastan. Ej.: ‘Pagamos un sistema caro y solo usamos una parte.’"
            ></textarea>
            <p class="caption field__msg" id="cf-message-msg" hidden>{emptyMessage}</p>
          </div>
          <div class="field" data-field="consent">
            <label class="small consent">
              <input id="cf-consent" name="consent" type="checkbox" />
              <span>
                Acepto que Pragmasyn use mis datos para responderme.
                <a class="link" href="/privacidad">Aviso de privacidad</a>.
              </span>
            </label>
          </div>
          <div class="contact-form__trap" aria-hidden="true">
            <label>
              Sitio web
              <input name="website" type="text" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <button
            class="btn btn--primary"
            type="submit"
            aria-describedby="cf-consent-hint"
            disabled
          >
            Enviar mensaje
          </button>
          <p class="caption" id="cf-consent-hint">Para enviarlo, acepta el aviso de privacidad.</p>
          <p class="caption contact-form__micro">
            Respondemos en menos de 24 horas hábiles. Sin secuencia de correos automáticos.
          </p>
          <p class="small contact-form__status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <div class="toast ground-light" role="status" aria-live="polite" data-toast></div>
</BaseLayout>

<script>
  // Mejora progresiva: validación y envío con la voz de la marca.
  // El mensaje va a nuestro Worker (workers/contacto) y de ahí a nuestro correo.
  const form = document.querySelector<HTMLFormElement>(".contact-form");
  const toast = document.querySelector<HTMLElement>("[data-toast]");
  const waNumber = form?.dataset["waNumber"] ?? "";

  // El botón queda deshabilitado hasta que se acepte el aviso de privacidad.
  const consent = form?.querySelector<HTMLInputElement>("#cf-consent");
  const submitBtn = form?.querySelector<HTMLButtonElement>("button[type=submit]");
  const consentHint = form?.querySelector<HTMLElement>("#cf-consent-hint");
  const syncSubmit = (): void => {
    if (!consent || !submitBtn) return;
    submitBtn.disabled = !consent.checked;
    if (consentHint) consentHint.hidden = consent.checked;
  };
  consent?.addEventListener("change", syncSubmit);
  // A reload or a trip back can restore the checked box without a change event.
  window.addEventListener("pageshow", syncSubmit);

  // Lo que se escribió en la barra del cierre llega aquí ya puesto.
  try {
    const idea = sessionStorage.getItem("pragmasyn:idea");
    const field = form?.querySelector<HTMLTextAreaElement>("#cf-message");
    if (idea && field && !field.value) field.value = idea;
    sessionStorage.removeItem("pragmasyn:idea");
  } catch {
    // Storage can be blocked; the form simply starts empty.
  }

  function setFieldError(name: string, on: boolean): void {
    const wrap = form?.querySelector<HTMLElement>(`[data-field="${name}"]`);
    const msg = wrap?.querySelector<HTMLElement>(".field__msg");
    const input = wrap?.querySelector<HTMLInputElement | HTMLTextAreaElement>("input, textarea");
    wrap?.classList.toggle("field--error", on);
    if (msg) msg.hidden = !on;
    input?.setAttribute("aria-invalid", String(on));
    // the message only describes the field while it is showing
    if (msg?.id) {
      if (on) input?.setAttribute("aria-describedby", msg.id);
      else input?.removeAttribute("aria-describedby");
    }
    if (on && wrap) {
      // restart the wiggle on every failed attempt
      wrap.classList.remove("is-wiggling");
      void wrap.offsetWidth;
      wrap.classList.add("is-wiggling");
    }
  }

  let toastTimer: number | undefined;
  function showToast(text: string): void {
    if (!toast) return;
    window.clearTimeout(toastTimer);
    toast.textContent = text;
    toast.classList.add("is-visible");
    toastTimer = window.setTimeout(() => {
      toast.classList.remove("is-visible");
      toast.textContent = "";
    }, 4000);
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const company = String(data.get("company") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const size = String(data.get("size") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();

    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    setFieldError("name", name.length === 0);
    setFieldError("company", company.length === 0);
    setFieldError("email", !emailOk);
    setFieldError("message", message.length === 0);
    if (name.length === 0 || company.length === 0 || !emailOk || message.length === 0) {
      // the first error takes focus so it is announced and brought into view
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    const status = form.querySelector<HTMLElement>(".contact-form__status");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!status || !button) return;

    status.textContent = "";

    // Si el envío no sale, la conversación no se pierde: se ofrece el mismo
    // mensaje por WhatsApp, ya escrito.
    const fail = (): void => {
      status.textContent =
        "El mensaje no salió — es cosa nuestra, no tuya. Mándanoslo por aquí y no lo escribes de nuevo: ";
      if (!waNumber) {
        status.textContent =
          "El mensaje no salió — es cosa nuestra, no tuya. Intenta de nuevo o escríbenos directo.";
        return;
      }
      const draft = `Hola Pragmasyn. Soy ${name} de ${company}. Lo que quiero resolver: ${message}`;
      const link = document.createElement("a");
      link.className = "link";
      link.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(draft)}`;
      link.target = "_blank";
      link.rel = "noopener";
      link.textContent = "abrir WhatsApp con tu mensaje";
      status.append(link);
    };

    button.classList.add("btn--loading");
    button.setAttribute("aria-busy", "true");
    const website = String(data.get("website") ?? "");
    fetch("/api/contacto", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({ name, company, email, size, message, website }),
    })
      .then((res) => {
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        syncSubmit(); // el reset destilda el consentimiento
        showToast("Recibido. Te contesta una persona, no un autoresponder.");
      })
      .catch(fail)
      .finally(() => {
        button.classList.remove("btn--loading");
        button.removeAttribute("aria-busy");
      });
  });
</script>

<style>
  .contact-act {
    padding-block-start: 0;
  }
  .contact {
    align-items: start;
  }
  .contact__side {
    --col: 1 / span 4;
    position: sticky;
    inset-block-start: var(--space-9);
    display: grid;
    gap: var(--space-6);
  }
  .contact__form {
    --col: 6 / -1;
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    background: var(--bg-chrome);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-key);
  }
  /* On a phone the order is: WhatsApp, form, Directo, Qué sigue. */
  @media (width <= 56rem) {
    .contact {
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }
    .contact__side {
      display: contents;
    }
    .wa-card {
      order: 1;
    }
    .contact__form {
      order: 2;
    }
    .direct {
      order: 3;
    }
    .next {
      order: 4;
    }
  }

  .wa-card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: var(--radius-l);
    color: var(--fg);
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out);
  }
  .wa-card:hover {
    background-color: var(--bg-raised);
  }
  /* the ring sits inside the card, where it lands on cobalt, not on white */
  .wa-card:focus-visible {
    border-radius: var(--radius-l);
    outline-offset: calc(-2 * var(--focus-width));
  }
  .wa-card__text {
    max-width: var(--measure);
    color: var(--fg-secondary);
    text-wrap: pretty;
  }
  .wa-card__cta {
    justify-self: start;
  }

  .direct {
    display: grid;
    gap: var(--space-2);
  }
  .direct .link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .next {
    display: grid;
    gap: var(--space-2);
  }
  .next__item {
    display: grid;
    grid-template-columns: var(--space-7) 1fr;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }

  .contact-form {
    margin-block-start: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .contact-form__micro {
    margin-block-start: calc(var(--space-2) * -1);
  }
  /* the honeypot stays in the DOM for bots and off screen for people */
  .contact-form__trap {
    position: absolute;
    inset-inline-start: -100vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-form__status:empty {
    display: none;
  }

  /* A field that fails shakes once, 4px each way. */
  @media (prefers-reduced-motion: no-preference) {
    .field.is-wiggling {
      animation: wiggle 240ms var(--ease-in-out);
    }
  }
  @keyframes wiggle {
    20%,
    60% {
      translate: calc(-1 * var(--space-1)) 0;
    }
    40%,
    80% {
      translate: var(--space-1) 0;
    }
  }

  /* Success is a toast at the bottom centre; it leaves on its own. */
  .toast {
    position: fixed;
    inset-inline: var(--margin);
    inset-block-end: var(--space-5);
    z-index: var(--z-overlay);
    width: fit-content;
    max-width: calc(100% - 2 * var(--margin));
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-m);
    font-size: var(--text-small);
    text-align: center;
    opacity: 0;
    translate: 0 var(--space-3);
    pointer-events: none;
    transition:
      opacity var(--dur-3) var(--ease-out),
      translate var(--dur-3) var(--ease-out);
  }
  .toast:empty {
    display: none;
  }
  .toast.is-visible {
    opacity: 1;
    translate: 0 0;
  }
</style>
