---
import BaseLayout from "../layouts/BaseLayout.astro";
import { hasWhatsapp, site } from "../site";

// El canal de WhatsApp solo se declara si existe: un aviso que menciona un
// canal que no operamos es tan incorrecto como uno que omite el que sí.
const collected = hasWhatsapp
  ? "Lo que escribas en el formulario: tu nombre, tu empresa, tu correo de trabajo, el número de empleados si decides indicarlo y la descripción del proceso que te está costando horas. Si nos escribes por WhatsApp, también tu número y el contenido de esos mensajes. Nada más. Este sitio no usa cookies de seguimiento ni analítica que te identifique."
  : "Lo que escribas en el formulario: tu nombre, tu empresa, tu correo de trabajo, el número de empleados si decides indicarlo y la descripción del proceso que te está costando horas. Nada más. Este sitio no usa cookies de seguimiento ni analítica que te identifique.";

const sections = [
  {
    title: "Responsable",
    text: "Pragmasyn, Ciudad de México, México, responsable del tratamiento de tus datos conforme a la Ley Federal de Protección de Datos Personales en Posesión de los Particulares (LFPDPPP).",
  },
  {
    title: "Qué recabamos",
    text: collected,
  },
  {
    title: "Para qué",
    text: "Para responderte. Esa es la única finalidad. No hay boletines, no hay lista de correos, no hay reventa de datos.",
  },
  {
    title: "Con quién se comparte",
    text: "Con nadie. Tus datos no se transfieren a terceros salvo obligación legal.",
  },
  {
    title: "Tus derechos (ARCO)",
    text: `Puedes pedirnos acceso, rectificación, cancelación u oposición escribiendo a ${site.email}. Respondemos en los plazos que marca la ley.`,
  },
  {
    title: "Cambios",
    text: "Si este aviso cambia, la fecha de abajo cambia con él.",
  },
];
---

<BaseLayout
  title="Aviso de privacidad — Pragmasyn"
  description="Aviso de privacidad de Pragmasyn. Corto, porque recabamos poco: nombre, correo y tu mensaje. Nada más."
  path="/privacidad"
>
  <section class="opening" aria-labelledby="privacy-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <p class="label label--rule">Legal</p>
          <h1 id="privacy-title" class="display-2">Aviso de privacidad</h1>
        </div>
        <div class="opening__aside">
          <p class="lead">Corto, porque recabamos poco.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="act notice">
    <div class="act__inner">
      <div class="notice__column">
        {
          sections.map((s) => (
            <section class="notice__section">
              <h2 class="h3">{s.title}</h2>
              <p class="body">{s.text}</p>
            </section>
          ))
        }
        <p class="caption notice__updated">
          Última actualización: 31 de agosto de 2026
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notice {
    padding-block-start: 0;
  }
  .notice__column {
    max-width: var(--measure);
  }
  .notice__section {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .notice__updated {
    margin-block-start: var(--space-7);
  }
</style>
