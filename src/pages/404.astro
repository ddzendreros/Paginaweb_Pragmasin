---
import BaseLayout from "../layouts/BaseLayout.astro";

const destinations = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Qué construimos" },
  { href: "/metodo", label: "Cómo trabajamos" },
  { href: "/contacto", label: "Contacto" },
];
---

<BaseLayout
  title="Página no encontrada — Pragmasyn"
  description="Esta página no existe. Lo que sí existe: qué construimos, cómo trabajamos y el contacto de Pragmasyn."
  path="/404"
>
  <section class="opening" aria-labelledby="nf-title">
    <div class="act__inner">
      <div class="opening__top grid-12">
        <div class="opening__main">
          <p class="label">Error 404</p>
          <h1 id="nf-title" class="display">Esta página no existe.</h1>
        </div>
        <div class="opening__aside">
          <p class="lead">
            El enlace está roto o apunta a algo que nunca existió. Pasa hasta en los mejores
            sistemas. Lo que sí existe:
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="act not-found">
    <div class="act__inner grid-12">
      <ul class="not-found__links">
        {
          destinations.map((d) => (
            <li>
              <a class="link link--plain" href={d.href}>
                {d.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block-start: 0;
  }
  .not-found__links {
    --col: 9 / span 4;
  }
  .not-found__links .link {
    display: flex;
  }
  .not-found__links li {
    border-block-start: var(--hairline) solid var(--hairline-color);
  }
  .not-found__links li:last-child {
    border-block-end: var(--hairline) solid var(--hairline-color);
  }
</style>
