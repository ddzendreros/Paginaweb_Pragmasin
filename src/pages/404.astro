---
import BaseLayout from "../layouts/BaseLayout.astro";

const destinations = [
  { href: "/", label: "Inicio" },
  { href: "/#precios", label: "El diagnóstico" },
  { href: "/servicios", label: "Servicios" },
  { href: "/metodo", label: "El método" },
  { href: "/contacto", label: "Contacto" },
];
---

<BaseLayout
  title="Página no encontrada — Pragmasyn"
  description="Esta página no existe. Lo que sí existe: el diagnóstico, los servicios, el método y el contacto de Pragmasyn."
  path="/404"
>
  <section class="ground-dark act not-found" aria-labelledby="nf-title">
    <div class="act__inner">
      <div class="act__head">
        <p class="label eyebrow">Error 404</p>
        <h1 id="nf-title" class="display">Esta página no existe.</h1>
        <p class="lead">
          El enlace está roto o apunta a algo que nunca existió — pasa hasta en
          los mejores sistemas. Lo que sí existe:
        </p>
        <ul class="not-found__links">
          {
            destinations.map((d) => (
              <li>
                <a class="link link--arrow" href={d.href}>
                  {d.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(var(--space-9), 10vw, var(--space-11));
  }
  .not-found__links {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
  }
</style>
