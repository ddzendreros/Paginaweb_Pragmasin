---
import "../styles/base.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { site } from "../site";
import tokensCss from "../../public/styles/tokens.css?raw";

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/metodo" */
  path: string;
  /** Social cards lead with the promise, not with the SEO title */
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, path, ogTitle, ogDescription } = Astro.props;
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const socialTitle = ogTitle ?? title;
const socialDescription = ogDescription ?? description;

// theme-color follows the canvas token, so the browser chrome never drifts
// from tokens.css (the single source of color).
const themeColor = /--paper-50:\s*(#[0-9a-f]{6})/i.exec(tokensCss)?.[1];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Pragmasyn",
  description:
    "Software y automatización a la medida para PyMEs en México. Diseñamos, construimos y acompañamos. El software es del cliente.",
  url: Astro.site?.toString(),
  logo: new URL("/favicon.svg", Astro.site).toString(),
  email: site.email,
  areaServed: { "@type": "Country", name: "México" },
  parentOrganization: { "@type": "Organization", name: "Grupo Zendreros" },
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pragmasyn" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-var-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/styles/tokens.css" />

    <noscript>
      <style>
        /* Sin JS no hay entradas al hacer scroll: el contenido se ve, punto. */
        [data-reveal] {
          opacity: 1;
          translate: none;
        }
      </style>
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="ground-light">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter />
    <WhatsAppButton />

    <script>
      // One entrance curve for the whole site. Siblings stagger by their
      // position so a card grid arrives as a grid, not as one block.
      const revealables = document.querySelectorAll<HTMLElement>("[data-reveal]");
      for (const el of revealables) {
        const siblings = el.parentElement
          ? Array.from(el.parentElement.children).filter((c) => c.hasAttribute("data-reveal"))
          : [];
        const index = Math.max(0, Math.min(siblings.indexOf(el), 3));
        el.style.setProperty("--reveal-index", String(index));
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
      );
      revealables.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
