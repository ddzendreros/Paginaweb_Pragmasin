---
import "../styles/base.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { site } from "../site";
import tokensCss from "../../public/styles/tokens.css?raw";

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/metodo" */
  path: string;
  /** Social cards lead with the promise, not with the SEO title */
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, path, ogTitle, ogDescription } = Astro.props;
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const socialTitle = ogTitle ?? title;
const socialDescription = ogDescription ?? description;

// theme-color follows the canvas token, so the browser chrome never drifts
// from tokens.css (the single source of color).
const themeColor = /--night-950:\s*(#[0-9a-f]{6})/i.exec(tokensCss)?.[1];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Pragmasyn",
  description:
    "Software y automatización a la medida para PyMEs en México. Diseñamos, construimos y acompañamos. El software es del cliente.",
  url: Astro.site?.toString(),
  logo: new URL("/favicon.svg", Astro.site).toString(),
  email: site.email,
  areaServed: { "@type": "Country", name: "México" },
  parentOrganization: { "@type": "Organization", name: "Grupo Zendreros" },
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pragmasyn" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/mona-sans-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/styles/tokens.css" />

    <noscript>
      <style>
        /* Sin JS el menú no abre, y el pie lleva los mismos enlaces. */
        .site-header__toggle {
          display: none !important;
        }
      </style>
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="ground-dark">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter />
    <WhatsAppButton />

    <script>
      // Entrances for everything below the first section. The classes are added
      // here, so a page without JavaScript never hides anything.
      const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const blocks =
        ".sec__name, .head > .lead, .spec__row, .qa, .track__row, .own__cell, .contrast tr, .closing__aside, .not, .line__body, .steps tr, .notice__section, .build__more";
      const titles = "main > section:not(:first-child) :is(.h2, .display)";

      const splitWords = (title: Element): void => {
        let index = 0;
        for (const node of Array.from(title.childNodes)) {
          if (node.nodeType !== Node.TEXT_NODE) continue;
          const fragment = document.createDocumentFragment();
          for (const part of (node.textContent ?? "").split(/(\s+)/)) {
            if (!part) continue;
            if (/^\s+$/.test(part)) {
              fragment.append(part);
              continue;
            }
            const word = document.createElement("span");
            word.className = "w";
            word.style.setProperty("--w", String(index++));
            word.textContent = part;
            fragment.append(word);
          }
          node.replaceWith(fragment);
        }
      };

      if (!calm) {
        const observer = new IntersectionObserver(
          (entries) => {
            const arriving = entries.filter((entry) => entry.isIntersecting);
            arriving.forEach((entry, i) => {
              const target = entry.target as HTMLElement;
              if (target.classList.contains("reveal")) {
                target.style.transitionDelay = String(Math.min(i, 6) * 70) + "ms";
              }
              target.classList.add("is-in");
              observer.unobserve(target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
        );
        document.querySelectorAll(titles).forEach((title) => {
          splitWords(title);
          observer.observe(title);
        });
        document.querySelectorAll("main > section:not(:first-child)").forEach((section) => {
          section.querySelectorAll(blocks).forEach((block) => {
            block.classList.add("reveal");
            observer.observe(block);
          });
        });
      }
    </script>
  </body>
</html>
